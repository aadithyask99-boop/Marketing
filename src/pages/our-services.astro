---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceBlocks from "../components/ServiceBlocks.astro";
import Proof from "../components/Proof.astro";
import Voices from "../components/Voices.astro";
import ClosingCta from "../components/ClosingCta.astro";
import PathCards from "../components/PathCards.astro";
import "../styles/services.css";
import { SERVICES_INTRO, url } from "../data/site";
import { webPage, breadcrumbs, serviceList } from "../lib/schema";
const o = Astro.site!.origin;
const schema = [
  webPage(o, "/our-services", "CollectionPage", "Services", "AI search (GEO and AEO), SEO and content, websites, AI automation, advertising, email and SMS, social media and branding from Maximus Mediascape."),
  serviceList(o),
  breadcrumbs(o, [{ name: "Services", path: "/our-services" }]),
];
---

<BaseLayout
  schema={schema}
  title="SEO, AI Search and Website Services"
  description="AI search (GEO and AEO), SEO and content, websites, AI automation, advertising, email and SMS, social media and branding from Maximus Mediascape."
>
  <section class="svc-hero section page-top page-hero">
    <h1 class="display svc-hero-title">
      <span data-xray>All the ways we grow brands</span>
    </h1>
    <p class="lede">
      {SERVICES_INTRO} See how it all comes together in our <a class="svc-inline" href={url("/our-services/care-and-growth-plans")}>plans</a>, how we <a class="svc-inline" href={url("/work")}>work</a> with clients, or <a class="svc-inline" href={url("/about-us")}>learn more about us</a>.
    </p>
  </section>

  <ServiceBlocks />
  <Proof tone="ink" />
  <Voices tone="ink" />
  <section class="svc-path" aria-label="Our plans">
    <PathCards tone="ink" />
  </section>
  <ClosingCta />
</BaseLayout>

<script>
  import { initXray } from "../scripts/xray";
  initXray(document.querySelector(".svc-hero-title"), 12);
</script>
