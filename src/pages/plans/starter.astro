---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ClosingCta from "../../components/ClosingCta.astro";
import StickyCta from "../../components/StickyCta.astro";
import "../../styles/starter.css";
import "../../styles/startup.css";
import { Image } from "astro:assets";
import auditLogo from "../../assets/blog/logo-iaudit.png";
import Voices from "../../components/Voices.astro";
import { DESIGN_WALL } from "../../data/design";
import { SITE, url } from "../../data/site";
import { START, CHECK, stages, included, notIncluded, faq as baseFaq } from "../../data/starter";
import { panelCopy, programs, designPicks, audience, auditProof, AUDIT_NOTE, extraFaq, marquee, notFit, teamNote } from "../../data/startup";
import { webPage, breadcrumbs } from "../../lib/schema";

const faq = [...baseFaq, ...extraFaq];
const ARTS: Record<string, string> = {
  care: `<svg viewBox="0 0 120 120"><path d="M60 14l38 14v28c0 24-16 42-38 50-22-8-38-26-38-50V28z" fill="#f5efe8" stroke="#17090a" stroke-width="2.6" stroke-linejoin="round"/><path d="M42 60l13 13 24-26" fill="none" stroke="#e10600" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  growth: `<svg viewBox="0 0 120 120"><rect x="16" y="68" width="20" height="34" rx="4" fill="#17090a"/><rect x="50" y="48" width="20" height="54" rx="4" fill="#17090a"/><rect x="84" y="24" width="20" height="78" rx="4" fill="#e10600"/><path d="M18 52l30-18 22 10 32-28" fill="none" stroke="#17090a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
};
const designs = designPicks.map((id) => DESIGN_WALL.find((w) => w.id === id)!);
const toneOf = (i: number) => (i % 2 === 0 ? "dark" : "cream");

const o = Astro.site!.origin;
const schema = [
  webPage(o, "/plans/starter", "WebPage", "Starter plan for startups and SMEs, from £999", "A fast, mobile-friendly, local-SEO-ready website for startups and small businesses, from £999, with market analysis, strategy, bespoke build, a 90-day plan and training."),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Starter website package for startups and small businesses",
    serviceType: "Website design and local SEO",
    description: "Market and competitor analysis, website strategy and design, bespoke development, mobile-optimised and local-SEO-ready build, 90-day implementation plan, and training and handover.",
    provider: { "@id": `${o}/#organization` },
    areaServed: ["United Kingdom"],
    offers: { "@type": "Offer", price: "999", priceCurrency: "GBP", url: `${o}/plans/starter`, availability: "https://schema.org/InStock" },
  },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
  breadcrumbs(o, [{ name: "Plans", path: "/plans" }, { name: "Starter plan for startups and SMEs", path: "/plans/starter" }]),
];
---

<BaseLayout
  title="Starter plan for startups and SMEs from £999"
  description="A fast, mobile-friendly website for startups and small businesses without an agency budget. From £999, with strategy, a bespoke build, a 90-day plan and training."
  schema={schema}
  footerTone="ink"
  landing
>
  <!-- 0. Hero (light) -->
  <section class="su-hero" data-hero>
    <div class="su-hero-main">
      <p class="su-tag">(Starter website for startups and SMEs)</p>
      <h1 class="display su-title"><span data-xray>A website that looks the part,</span> <span class="su-accent">without</span> <span data-xray>the agency price.</span></h1>
      <p class="lede">You need to get online and the budget is tight, but quality still matters. We analyse your market, then design and build a fast, mobile-friendly site made to be found. One-time fee, about two months, and you own it.</p>
      <div class="su-hero-cta">
        <a class="st-pill" href="#start" data-preset={START} data-cursor="Go">Get started <i aria-hidden="true">↗</i></a>
        <a class="su-link" href="#included">See what's included <i aria-hidden="true">↓</i></a>
        <a class="st-badge" href="#price" aria-label="From £999, see the price" data-badge>
          <span class="st-badge-from">From</span>
          <span class="st-badge-price">£999</span>
          <span class="st-badge-note">one-time</span>
        </a>
      </div>
    </div>
    <div class="su-marq" aria-hidden="true">
      <div class="su-marq-in">
        {[0, 1].map(() => (
          <div class="su-marq-set">
            {marquee.map((w) => <><span>{w}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 3v18M4.2 7.5l15.6 9M19.8 7.5l-15.6 9"></path></svg></>)}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 1 to 4. The stack: what's included, one stage per panel -->
  <div class="su-stack" id="included" data-stack role="region" aria-label="What's included">
    {stages.map((s, i) => (
      <section class:list={["su-panel", toneOf(i) === "dark" && "su-panel--dark"]} data-panel style={`--z:${i + 1}`} aria-labelledby={`stage-${i}`}>
        <div class="su-row">
          <h2 id={`stage-${i}`} class="display su-rise"><span>{s.name}</span></h2>
          <p class="su-num su-rise" aria-hidden="true"><span>0{i + 1}</span></p>
        </div>
        <div class="su-body">
          <div>
            <p class="su-statement">{panelCopy[s.name].statement}</p>
            <ul class="su-items">
              {s.items.map(([t, d]) => <li><b>{t}</b><span>{d}</span></li>)}
            </ul>
            <a class="su-link" href="#start" data-preset={START} data-cursor="Go">{panelCopy[s.name].cta} <i aria-hidden="true">↗</i></a>
            {i === stages.length - 1 && <p class="su-foot">* Some items, such as business email, domain and hosting, have separate running costs charged by the provider.</p>}
          </div>
          <div class="su-art" aria-hidden="true">
            {i === 0 && (
              <svg viewBox="0 0 200 200"><rect class="su-a su-f" x="38" y="124" width="22" height="40" rx="4"/><rect class="su-a su-f" x="70" y="104" width="22" height="60" rx="4"/><rect class="su-a su-f" x="102" y="84" width="22" height="80" rx="4"/><circle class="su-a" cx="124" cy="82" r="38"/><path class="su-a" d="M152 110l24 24"/><circle class="su-r" cx="124" cy="82" r="8"/></svg>
            )}
            {i === 1 && (
              <svg viewBox="0 0 200 200"><rect class="su-a" x="28" y="42" width="144" height="116" rx="12"/><path class="su-a" d="M28 70h144"/><circle class="su-r" cx="44" cy="56" r="4"/><circle class="su-a" cx="58" cy="56" r="4"/><rect class="su-a su-f" x="44" y="84" width="62" height="38" rx="8"/><path class="su-a" d="M120 92h36M120 106h28"/><rect class="su-a" x="44" y="134" width="112" height="12" rx="6"/><circle class="su-r" cx="75" cy="103" r="9"/></svg>
            )}
            {i === 2 && (
              <svg viewBox="0 0 200 200"><ellipse class="su-a" cx="100" cy="164" rx="62" ry="14"/><ellipse class="su-a" cx="100" cy="164" rx="34" ry="8"/><path class="su-a su-f" d="M100 36c-25 0-44 19-44 44 0 32 44 80 44 80s44-48 44-80c0-25-19-44-44-44z"/><circle class="su-r" cx="100" cy="80" r="16"/></svg>
            )}
            {i === 3 && (
              <svg viewBox="0 0 200 200"><circle class="su-a su-f" cx="66" cy="100" r="30"/><circle class="su-r" cx="66" cy="100" r="9"/><path class="su-a" d="M96 100h76M142 100v24M160 100v16"/><path class="su-a" d="M40 156h120"/></svg>
            )}
          </div>
        </div>
      </section>
    ))}
  </div>

  <!-- 6. Who it is for -->
  <section class="su-sec su-sec--ink su-who-sec" aria-labelledby="who-title">
    <div class="su-sechead">
      <h2 id="who-title" class="display">Who it's <span class="su-accent">for</span></h2>
      <p class="su-tag">(Areas of focus)</p>
    </div>
    <ul class="su-who" data-who>
      {audience.map((a, i) => (
        <li class:list={[i === 0 && "is-active"]}>
          <h3>{a.name}</h3>
          <span class="su-wn" aria-hidden="true">0{i + 1}</span>
          <p>{a.text}</p>
        </li>
      ))}
    </ul>
    <div class="su-notfit">
      <p class="su-tag">(Not a fit?)</p>
      <ul>{notFit.map((t) => <li>{t}</li>)}</ul>
      <a class="su-link" href="#start" data-preset={CHECK} data-cursor="Go">Not sure? Start with a free 15-minute website check <i aria-hidden="true">↗</i></a>
    </div>
  </section>

  <!-- 8. Price and designs -->
  <section class="st-sec st-cream st-price su-price su-price--light" id="price" aria-labelledby="price-title">
    <svg class="st-rings" viewBox="0 0 800 800" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2"><circle cx="400" cy="400" r="120"/><circle cx="400" cy="400" r="210"/><circle cx="400" cy="400" r="300"/><circle cx="400" cy="400" r="390"/></g></svg>
    <div class="st-wrap">
      <h2 id="price-title" class="sr-only">Price</h2>
      <p class="su-tag">(The Starter website)</p>
      <div class="st-amountrow">
        <p class="st-amount" data-odo aria-label="From £999">
          <span class="st-from" aria-hidden="true">From</span>
          <span class="st-pound" aria-hidden="true">£</span>
          <span class="odo-col" aria-hidden="true" style="--d:9"><span>0123456789</span></span>
          <span class="odo-col" aria-hidden="true" style="--d:9"><span>0123456789</span></span>
          <span class="odo-col" aria-hidden="true" style="--d:9"><span>0123456789</span></span>
        </p>
        <p class="st-seal" aria-hidden="true"><span>Fixed price</span><span>no surprises</span></p>
      </div>
      <div class="st-pricegrid">
        <div class="st-payblock">
          <p class="st-terms">One-time fee. About two months to launch.</p>
          <div class="st-pay" data-pay role="group" aria-label="Payment plan">
            <span class="st-pay-line" aria-hidden="true"><span></span></span>
            <p class="st-pay-node" tabindex="0"><i aria-hidden="true"></i><b>Start</b><span>50% · £499.50</span></p>
            <p class="st-pay-node" tabindex="0"><i aria-hidden="true"></i><b>Launch</b><span>50% · £499.50</span></p>
          </div>
          <div class="st-actions">
            <a class="st-pill st-pill--cream" href="#start" data-preset={START} data-cursor="Go">Get started <i aria-hidden="true">↗</i></a>
            <a class="st-pill st-pill--line" href="#start" data-preset={CHECK} data-cursor="Go">Free 15-minute website check <i aria-hidden="true">↗</i></a>
          </div>
        </div>
        <div class="st-yesno">
          <div>
            <h3>Included</h3>
            <ul>{included.map((t) => <li><i class="st-yes" aria-hidden="true">✓</i>{t}</li>)}</ul>
          </div>
          <div class="st-no">
            <h3>Not included</h3>
            <ul>{notIncluded.map((t) => <li><i class="st-x" aria-hidden="true">✕</i><span>{t}</span></li>)}</ul>
          </div>
        </div>
      </div>
      <ul class="su-chips" aria-label="Jump to what's included">
        {stages.map((s, i) => <li><a href={`#stage-${i}`}><span>0{i + 1}</span>{s.name}</a></li>)}
      </ul>

      <div class="su-designs">
        <div class="su-designs-head">
          <p class="su-tag">(Recent website designs)</p>
          <a class="su-link" href={url("/work/portfolio")} data-cursor="View">Portfolio <i aria-hidden="true">↗</i></a>
        </div>
        <ul class="su-shots">
          {designs.map((d, i) => (
            <li class="su-shot" style={`--r:${i === 1 ? 1.2 : -1.2}deg; --y:${i === 1 ? "2.5rem" : "0rem"}`}>
              <a href={url("/work/portfolio")} data-cursor="View" aria-label={`${d.sector} website design, see the portfolio`}>
                <span class="su-frame"><span class="su-bar"><i></i><i></i><i></i></span><Image src={d.src} alt={d.alt} widths={[480, 800, 1100]} sizes="(min-width: 900px) 30vw, 80vw" loading="lazy" /></span>
                <span class="su-cap">{d.sector}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="su-designs-cta">
          <p>Your Starter site is designed the same way, in your brand.</p>
          <a class="st-pill" href={url("/work/portfolio")} data-cursor="View">See the portfolio <i aria-hidden="true">↗</i></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Proof: iAudit Global (Recent work pattern: big borderless tiles, giant numerals, captions underneath) -->
  <section class="su-proof su-proof--audit" aria-labelledby="impact-title">
    <div class="su-proofhead">
      <h2 id="impact-title" class="display">What <span class="su-accent">organic</span> growth looks like</h2>
      <a class="su-link" href={url("/blogs/iaudit-global-organic-growth")} data-cursor="Read">Read the case study <i aria-hidden="true">↗</i></a>
    </div>
    <div class="su-proofsub">
      <p>iAudit Global, a B2B audit software brand, started with nothing online. Twelve months in: a new website, a content library and a growing audience, with no paid spend.</p>
        <div class="st-arrows">
          <button type="button" class="st-arrow" data-dir="-1" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"></path></svg></button>
          <button type="button" class="st-arrow" data-dir="1" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"></path></svg></button>
        </div>
    </div>
    <div class="st-track su-tiles" data-track data-cursor="Drag" tabindex="0" aria-label="iAudit Global results, scroll sideways">
      <figure class="su-tile">
        <a class="su-tile-vis su-tile-vis--logo" href={url("/blogs/iaudit-global-organic-growth")} data-cursor="Read" aria-label="Read the iAudit Global case study">
          <Image src={auditLogo} alt="iAudit Global logo" widths={[480, 800]} sizes="(min-width: 900px) 34vw, 80vw" loading="lazy" />
          <span class="su-tile-go" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
        </a>
        <figcaption><span><b>iAudit Global</b>Website, SEO, content and LinkedIn</span><span class="su-tile-tag">(Case study)</span></figcaption>
      </figure>
      {auditProof.map((b) => (
        <figure class="su-tile">
          <div class={`su-tile-vis su-tile-vis--${b.tone}`} aria-hidden="true">
            <span class="su-numeral" style={`--n:${b.n}`}>{b.prefix}<b data-to={b.to} data-dec={b.dec}>{b.to.toLocaleString("en-GB", { minimumFractionDigits: b.dec, maximumFractionDigits: b.dec })}</b>{b.suffix}</span>
          </div>
          <figcaption><span><b>{b.name}</b>{b.desc}</span><span class="su-tile-tag">{b.tag}</span></figcaption>
          <span class="sr-only">{b.prefix}{b.to}{b.suffix} {b.name}, {b.desc}</span>
        </figure>
      ))}
    </div>
    <p class="su-note">{AUDIT_NOTE}</p>
  </section>

  <!-- 9b. Testimonials -->
  <Voices tone="cream" />

  <!-- 10. Questions -->
  <section class="st-sec st-ink su-faq" aria-labelledby="faq-title">
    <div class="st-wrap st-faqgrid">
      <div class="st-faqside">
        <h2 id="faq-title" class="display st-h2">Questions</h2>
        <p>Still unsure? Ask us anything. We reply within one working day.</p>
        <ul class="st-ask">
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer">Message us on WhatsApp</a></li>
        </ul>
        <a class="st-pill st-pill--cream" href="#start" data-preset={CHECK} data-cursor="Go">Free 15-minute website check <i aria-hidden="true">↗</i></a>
      </div>
      <div class="st-faq" data-faq>
        {faq.map((f, i) => (
          <details>
            <summary><span class="st-q-n">{String(i + 1).padStart(2, "0")}</span><span class="st-q">{f.q}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></summary>
            <div class="st-faq-a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 11. Retainer plans (Signature Programs pattern) -->
  <section class="su-sec su-sec--cream su-programs" aria-labelledby="programs-title">
    <div class="su-progintro">
      <p class="su-tag">(A note from the team)</p>
      <div>
        <h2 id="programs-title" class="su-progline">{teamNote.statement}</h2>
        <div class="su-progbody">
          {teamNote.paras.map((t) => <p>{t}</p>)}
          <p class="su-sign">{teamNote.sign}</p>
        </div>
        <a class="su-link" href="#programs-cards">See the plans <i aria-hidden="true">↓</i></a>
      </div>
    </div>
    <div class="su-cardsbar" id="programs-cards">
      <p class="su-tag">(Pick your path to progress)</p>
      <a class="su-link" href={url("/plans")} data-cursor="View">Compare all plans <i aria-hidden="true">↗</i></a>
    </div>
    <div class="su-cards su-cards--two" data-cards>
      {programs.map((b) => (
        <article class="su-card" data-peek={b.label}>
          <div class="su-card-top"><h3>{b.title}</h3><span class="su-card-price">{b.price}</span></div>
          <div class="su-card-mid">
            <p class="su-card-tag">{b.tag}</p>
            <p class="su-card-text">{b.text}</p>
          </div>
          <a class="su-link" href={url(b.href)} data-cursor="View">See {b.title} <i aria-hidden="true">↗</i></a>
          <template><div class="su-peek-art" set:html={ARTS[b.art]} /></template>
        </article>
      ))}
    </div>
    <p class="su-foot">Monthly plans are optional and start after launch. Prices exclude VAT.</p>
    <div class="su-peek" data-peek-box aria-hidden="true"><div class="su-peek-card"></div><span class="su-peek-label"></span></div>
  </section>

  <div class="su-closer">
    <ClosingCta tone="ink" title="Let's build yours." lede="Tell us about your business and we'll come back with a clear plan and a start date." service="Starter website (£999)" />
  </div>
  <StickyCta label="Get started · £999" preset={START} />
</BaseLayout>

<script>
  import { initStack } from "../../scripts/stackPanels";

  const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const clamp = (n: number, a = 0, b = 1) => Math.min(b, Math.max(a, n));
  document.documentElement.classList.add("js-st");
  const seen = (els: Iterable<Element>, cb: (el: Element) => void, threshold = 0.4) => {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { cb(e.target); io.unobserve(e.target); } }), { threshold });
    for (const el of els) io.observe(el);
  };
  const onScroll = (fn: () => void) => {
    let ticking = false;
    const run = () => { ticking = false; fn(); };
    window.addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(run); } }, { passive: true });
    window.addEventListener("resize", run);
    run();
  };

  // Stacking panels
  const stack = document.querySelector<HTMLElement>("[data-stack]");
  if (stack) initStack(stack);

  // Headlines rise out of their mask once their panel is on screen
  seen(document.querySelectorAll(".su-rise"), (el) => el.classList.add("is-in"), 0.3);

  // Who it is for: the row nearest the middle of the screen lights up
  const who = document.querySelector<HTMLElement>("[data-who]");
  if (who) {
    const rows = [...who.querySelectorAll<HTMLElement>("li")];
    onScroll(() => {
      const mid = window.innerHeight * 0.5;
      let best = 0, d = Infinity;
      rows.forEach((r, i) => {
        const b = r.getBoundingClientRect();
        const dist = Math.abs(b.top + b.height / 2 - mid);
        if (dist < d) { d = dist; best = i; }
      });
      rows.forEach((r, i) => r.classList.toggle("is-active", i === best));
    });
  }

  // Price: digits roll once; payment path fills
  const odo = document.querySelector<HTMLElement>("[data-odo]");
  if (odo && !calm) {
    odo.classList.add("is-armed");
    seen([odo], () => requestAnimationFrame(() => odo.classList.add("is-rolled")), 0.5);
  }
  document.querySelectorAll<HTMLElement>("[data-pay]").forEach((el) => seen([el], () => el.classList.add("is-in"), 0.6));

  // Proof figures count up once
  document.querySelectorAll<HTMLElement>("[data-to]").forEach((b) => {
    const to = Number(b.dataset.to), dec = Number(b.dataset.dec ?? 0);
    const fmt = (n: number) => n.toLocaleString("en-GB", { minimumFractionDigits: dec, maximumFractionDigits: dec });
    if (calm || to === 0) return;
    b.textContent = fmt(0);
    seen([b.closest(".su-tile") ?? b], () => {
      const t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / 1100);
        b.textContent = fmt(to * (1 - Math.pow(1 - k, 3)));
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, 0.55);
  });

  // Carousel: arrows, keys and mouse drag
  const track = document.querySelector<HTMLElement>("[data-track]");
  if (track) {
    const step = () => (track.querySelector<HTMLElement>(".st-card, .su-tile")?.offsetWidth ?? 320) + 16;
    document.querySelectorAll<HTMLButtonElement>(".st-arrow").forEach((b) =>
      b.addEventListener("click", () => track.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: calm ? "auto" : "smooth" })),
    );
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") track.scrollBy({ left: step(), behavior: "smooth" });
      if (e.key === "ArrowLeft") track.scrollBy({ left: -step(), behavior: "smooth" });
    });
    let down = false, x0 = 0, s0 = 0, moved = false;
    track.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse") return;
      down = true; moved = false; x0 = e.clientX; s0 = track.scrollLeft;
    });
    window.addEventListener("pointermove", (e) => {
      if (!down) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 4) { moved = true; track.classList.add("is-drag"); }
      track.scrollLeft = s0 - dx;
    });
    window.addEventListener("pointerup", () => { down = false; track.classList.remove("is-drag"); });
    track.addEventListener("click", (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
  }

  // Budget cards: a small tilted tile follows the cursor, as on the reference (mouse only)
  const cardsWrap = document.querySelector<HTMLElement>("[data-cards]");
  const peek = document.querySelector<HTMLElement>("[data-peek-box]");
  if (cardsWrap && peek && fine && !calm) {
    const tile = peek.querySelector<HTMLElement>(".su-peek-card")!;
    const lab = peek.querySelector<HTMLElement>(".su-peek-label")!;
    let tx = 0, ty = 0, x = 0, y = 0, on = false, raf = 0;
    const loop = () => {
      x += (tx - x) * 0.2; y += (ty - y) * 0.2;
      const tilt = Math.max(-10, Math.min(10, (tx - x) * 0.4));
      peek.style.transform = `translate(${x}px, ${y}px) rotate(${(-6 + tilt).toFixed(1)}deg)`;
      raf = on || Math.abs(tx - x) > 0.5 ? requestAnimationFrame(loop) : 0;
    };
    cardsWrap.querySelectorAll<HTMLElement>("[data-peek]").forEach((c) => {
      c.addEventListener("pointerenter", (e) => {
        tile.innerHTML = c.querySelector("template")?.innerHTML ?? "";
        lab.textContent = c.dataset.peek ?? "";
        tx = x = e.clientX; ty = y = e.clientY;
        on = true; peek.classList.add("is-on");
        if (!raf) raf = requestAnimationFrame(loop);
      });
      c.addEventListener("pointermove", (e) => { tx = e.clientX + 18; ty = e.clientY + 18; });
      c.addEventListener("pointerleave", () => { on = false; peek.classList.remove("is-on"); });
    });
  }

  // Hero sticker leans toward the cursor
  const badge = document.querySelector<HTMLElement>("[data-badge]");
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (badge && hero && fine && !calm) {
    hero.addEventListener("pointermove", (e) => {
      const r = badge.getBoundingClientRect();
      const dx = (e.clientX - (r.left + r.width / 2)) / window.innerWidth;
      const dy = (e.clientY - (r.top + r.height / 2)) / window.innerHeight;
      badge.style.setProperty("--tx", `${(dx * 14).toFixed(1)}px`);
      badge.style.setProperty("--ty", `${(dy * 14).toFixed(1)}px`);
      badge.style.setProperty("--rot", `${(-8 + dx * 10).toFixed(1)}deg`);
    });
  }

  // FAQ: one open at a time, smooth height
  const faq = document.querySelector<HTMLElement>("[data-faq]");
  if (faq) {
    const items = [...faq.querySelectorAll<HTMLDetailsElement>("details")];
    const animate = (d: HTMLDetailsElement, open: boolean) => {
      const body = d.querySelector<HTMLElement>(".st-faq-a")!;
      if (calm) { d.open = open; return; }
      const h = body.scrollHeight;
      if (open) {
        d.open = true;
        body.animate({ height: ["0px", `${h}px`], opacity: [0, 1] }, { duration: 280, easing: "ease-out" });
      } else {
        const a = body.animate({ height: [`${h}px`, "0px"], opacity: [1, 0] }, { duration: 220, easing: "ease-in" });
        a.onfinish = () => (d.open = false);
      }
    };
    items.forEach((d) => {
      d.querySelector("summary")!.addEventListener("click", (e) => {
        e.preventDefault();
        const willOpen = !d.open;
        items.forEach((o) => { if (o !== d && o.open) animate(o, false); });
        animate(d, willOpen);
      });
    });
  }
</script>
