---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutStory from "../components/AboutStory.astro";
import AboutManifesto from "../components/AboutManifesto.astro";
import ValuesMarquee from "../components/ValuesMarquee.astro";
import Proof from "../components/Proof.astro";
import Voices from "../components/Voices.astro";
import ClosingCta from "../components/ClosingCta.astro";
import OfferShape from "../components/OfferShape.astro";
import "../styles/offerings.css";
import "../styles/about.css";
import { ABOUT } from "../data/site";
---

<BaseLayout title="About" description="Maximus Mediascape is a marketing agency founded in 2023 at the University of Surrey, now with offices in the UK, UAE and India.">
  <section class="about-hero section page-top page-hero" data-hero>
    <div class="hero-floats" aria-hidden="true">
      <span class="hf hf--a" data-depth="26"><OfferShape shape="rings" class="hf-shape" /></span>
      <span class="hf hf--b" data-depth="-18"><OfferShape shape="spiral" class="hf-shape" /></span>
      <span class="hf hf--c" data-depth="12"><OfferShape shape="stack" class="hf-shape" /></span>
    </div>
    <p class="eyebrow">About</p>
    <h1 class="display page-title">Maximus Mediascape</h1>
    <p class="lede">{ABOUT.lede}</p>
  </section>

  <AboutStory />
  <AboutManifesto />

  <section class="about-numbers" aria-label="Maximus Mediascape in numbers">
    <ul>
      {
        ABOUT.numbers.map((n) => (
          <li>
            <span class="num-value" data-count data-to={n.value} data-from={n.from} data-suffix={n.suffix}>{n.value}{n.suffix}</span>
            <span class="num-label">{n.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <ValuesMarquee />
  <Proof tone="ink" />
  <Voices />
  <ClosingCta />
</BaseLayout>

<script>
  // Count the numbers up once when they scroll into view
  const els = [...document.querySelectorAll<HTMLElement>("[data-count]")];
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (els.length && !reduced && "IntersectionObserver" in window) {
    const run = (el: HTMLElement) => {
      const to = Number(el.dataset.to);
      const from = Number(el.dataset.from ?? 0);
      const suffix = el.dataset.suffix ?? "";
      const start = performance.now();
      const dur = 1400;
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / dur);
        const e = 1 - Math.pow(1 - t, 3);
        el.textContent = `${Math.round(from + (to - from) * e)}${suffix}`;
        if (t < 1) requestAnimationFrame(tick);
        else {
          el.textContent = `${to}${suffix}`;
          el.classList.add("is-done");
        }
      };
      requestAnimationFrame(tick);
    };
    els.forEach((el) => { el.textContent = `${el.dataset.from ?? 0}${el.dataset.suffix ?? ""}`; });
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { run(e.target as HTMLElement); io.unobserve(e.target); }
    }), { threshold: 0.6 });
    els.forEach((el) => io.observe(el));
  }

  // Hero shapes drift gently with the pointer (mouse only)
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero && !reduced && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    const items = [...hero.querySelectorAll<HTMLElement>(".hf")];
    let queued = false;
    let p = { x: 0, y: 0 };
    const apply = () => {
      queued = false;
      items.forEach((el) => {
        const d = Number(el.dataset.depth);
        el.style.transform = `translate(${(p.x * d).toFixed(1)}px, ${(p.y * d).toFixed(1)}px)`;
      });
    };
    hero.addEventListener("pointermove", (e) => {
      const r = hero.getBoundingClientRect();
      p = { x: (e.clientX - r.left) / r.width - 0.5, y: (e.clientY - r.top) / r.height - 0.5 };
      if (!queued) { queued = true; requestAnimationFrame(apply); }
    });
    hero.addEventListener("pointerleave", () => { p = { x: 0, y: 0 }; apply(); });
  }
</script>
