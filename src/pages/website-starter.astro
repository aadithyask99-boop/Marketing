---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClosingCta from "../components/ClosingCta.astro";
import StickyCta from "../components/StickyCta.astro";
import "../styles/starter.css";
import { Image } from "astro:assets";
import casePhoto from "../assets/blog/croydon-wellness-ai-search.jpg";
import { SITE, url } from "../data/site";
import { webPage, breadcrumbs } from "../lib/schema";

const START = "I'd like the Starter website package (from £999)";
const CHECK = "I'd like a free 15-minute website check";

// 16 items, grouped by stage
const stages = [
  {
    name: "Understand",
    line: "Know the market before we build.",
    items: [
      ["Market and competitor analysis", "See who you're up against and where the gaps are."],
      ["Keyword and competitor snapshot", "A one-page report: the searches to target and who ranks today."],
      ["Website strategy and design plan", "A plan and a look built around your customers."],
    ],
  },
  {
    name: "Build",
    line: "A fast, mobile-ready site made for you.",
    items: [
      ["Bespoke website development", "Built for you, not squeezed into a template."],
      ["Mobile-optimised and local-SEO-ready", "Fast on phones and set up to be found nearby."],
      ["Conversion basics", "Click-to-call, WhatsApp button and a contact form that works."],
      ["Speed and launch checks", "Mobile and speed checks plus a launch checklist before going live."],
      ["Legal pages and cookie notice", "Privacy, Terms and a cookie notice done for you."],
    ],
  },
  {
    name: "Get found",
    line: "Set up to be found nearby.",
    items: [
      ["Google Business Profile set-up", "Set up and optimised so you show up on maps and local search."],
      ["AI-search ready", "FAQ content and structured data so assistants like ChatGPT can quote you."],
      ["Analytics and Search Console", "Tracking set up, with a simple monthly view of what's working."],
      ["Reviews kit", "QR code, short link and message templates to collect Google reviews."],
    ],
  },
  {
    name: "Hand over",
    line: "You're ready to run it.",
    items: [
      ["Basic training and handover", "A recorded walkthrough so you can manage it yourself."],
      ["90-day implementation plan", "A clear step-by-step plan for the first three months."],
      ["30 days post-launch support", "Questions and small fixes after launch."],
      ["Business email set-up*", "An address on your own domain, such as hello@yourbusiness.co.uk."],
    ],
  },
];

const steps = [
  ["Weeks 1 to 2", "Analysis and strategy", "We study your market and competitors and agree the plan.", "A one-page market and competitor snapshot"],
  ["Weeks 3 to 4", "Design", "You see the look and layout and tell us what to change.", "Design mock-ups to review"],
  ["Weeks 5 to 7", "Build", "We develop, connect your local SEO set-up and test everything.", "A tested, mobile-ready site"],
  ["Week 8", "Launch and training", "Go live, then a handover call.", "Your live site and a recorded walkthrough"],
  ["Next 90 days", "Your growth plan", "You follow the plan, with 30 days of support from us.", "Your 90-day plan and support"],
];
const statement: [string, boolean][] = [
  ...("Most local customers search on their phone.".split(" ").map((w) => [w, true] as [string, boolean])),
  ...("If your website is slow, hard to find or doesn't say clearly what you do, they move on to someone who does. We fix that in two months, with a site built to be found nearby and a plan for what comes next.".split(" ").map((w) => [w, false] as [string, boolean])),
];
const included = ["Everything listed above", "Up to 5 pages", "2 rounds of revisions", "You own the site and content"];
const notIncluded = ["Domain, hosting and email running costs", "Paid advertising", "Extensive copywriting or photography", "E-commerce or booking systems, quoted separately"];
const plans = [
  { name: "Care plan", text: "Hosting, security and updates handled for you, so the site stays fast and safe.", points: ["Updates and backups", "Uptime and security checks", "Small changes each month"], ask: "I'd like to hear about the care plan" },
  { name: "Growth plan", text: "Monthly SEO and content that builds on your 90-day plan.", points: ["Local and AI-search content", "Monthly report and review", "Ongoing improvements"], ask: "I'd like to hear about the monthly growth plan" },
];
const faq = [
  { q: "How much does it cost?", a: "The Starter package is £999 as a one-time fee, with 50% to start and 50% on launch. Domain, hosting and business email have separate running costs charged by the provider." },
  { q: "How long does it take?", a: "About two months from kick-off to launch. Timelines depend on how quickly we can get your content and feedback, and can extend for bigger requirements." },
  { q: "What do I need to provide?", a: "Your business details, any logos or photos you already have, and a few hours across the project for feedback. We guide you through the rest." },
  { q: "How many pages and revisions are included?", a: "The package covers up to 5 pages and 2 rounds of revisions. Anything beyond that is quoted before we start so there are no surprises." },
  { q: "Who owns the website?", a: "You do. Once the final payment is made, the website and its content are yours." },
  { q: "Do you guarantee rankings?", a: "No one can honestly guarantee rankings. We build the site and set-up properly for local search and AI search, give you a clear plan and show you what to do next." },
  { q: "What isn't included?", a: "Paid advertising, extensive copywriting or photography, e-commerce or booking systems, and the running costs of domain, hosting and email. We can quote any of these separately." },
  { q: "What happens after launch?", a: "You get 30 days of support and a 90-day plan to follow. If you'd like us to keep going, we offer monthly SEO, content and care plans." },
];

const o = Astro.site!.origin;
const schema = [
  webPage(o, "/website-starter", "WebPage", "Starter website package from £999", "A fast, mobile-friendly, local-SEO-ready website for £999, with market analysis, strategy, design, development, a 90-day plan and training."),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Starter website package",
    serviceType: "Website design and local SEO",
    description: "Market and competitor analysis, website strategy and design, bespoke development, mobile-optimised and local-SEO-ready build, 90-day implementation plan, and training and handover.",
    provider: { "@id": `${o}/#organization` },
    areaServed: ["United Kingdom"],
    offers: { "@type": "Offer", price: "999", priceCurrency: "GBP", url: `${o}/website-starter`, availability: "https://schema.org/InStock" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  breadcrumbs(o, [{ name: "Starter website", path: "/website-starter" }]),
];
---

<BaseLayout
  title="Starter website from £999"
  description="A fast, mobile-friendly, local-SEO-ready website from £999. Market analysis, strategy, bespoke build, a 90-day plan and training, delivered in about 2 months."
  schema={schema}
  footerTone="red"
  landing
>
  <!-- 1. Hero -->
  <section class="st-hero page-top page-hero" data-hero>
    <div class="st-h1wrap">
      <h1 class="display st-title" data-xray>A fast, local-SEO-ready website.</h1>
      <a class="st-badge" href="#price" aria-label="From £999, see the price" data-badge>
        <span class="st-badge-from">From</span>
        <span class="st-badge-price">£999</span>
        <span class="st-badge-note">one-time</span>
      </a>
    </div>
    <p class="lede">We analyse your market, then design and build a fast, mobile-friendly website made to be found locally. One-time fee, about two months, and you own it.</p>
    <div class="st-hero-cta">
      <a class="st-pill" href="#start" data-preset={START} data-cursor="Go">Get started <i aria-hidden="true">↗</i></a>
    </div>
  </section>

  <!-- 2. Why it matters: pinned, words light up as you scroll -->
  <section class="st-pin st-pin--why st-cream" data-pin="why" aria-label="Why it matters">
    <div class="st-pin-in">
      <svg class="st-deco" viewBox="0 0 1200 300" preserveAspectRatio="xMidYMax slice" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2"><rect x="60" y="120" width="220" height="220" rx="56" transform="rotate(45 170 230)"/><rect x="300" y="120" width="220" height="220" rx="56" transform="rotate(45 410 230)"/><rect x="540" y="120" width="220" height="220" rx="56" transform="rotate(45 650 230)"/><rect x="780" y="120" width="220" height="220" rx="56" transform="rotate(45 890 230)"/></g></svg>
      <div class="st-wrap">
        <p class="st-statement" data-statement>
          {statement.map(([w, dim]) => <><span class:list={["sw", dim && "sw--dim"]}>{w}</span>{" "}</>)}
        </p>
      </div>
      <p class="st-cue" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l6 6 6-6M6 13l6 6 6-6"></path></svg></p>
    </div>
  </section>

  <!-- 3. What's included, by stage -->
  <section class="st-sec st-ink st-inc" id="included" aria-labelledby="inc-title">
    <div class="st-wrap">
      <h2 id="inc-title" class="display st-h2">What's included</h2>
      <div class="st-stagebox" data-stages>
        <div class="st-tabs" role="tablist" aria-label="Stages">
          <span class="st-marker" aria-hidden="true"></span>
          {stages.map((s, i) => (
            <button class="st-tab" type="button" role="tab" id={`tab-${i}`} aria-controls={`pane-${i}`} aria-selected={i === 0 ? "true" : "false"} data-i={i}>
              <span class="st-tab-n">0{i + 1}</span>
              <span class="st-tab-name">{s.name}</span>
              <span class="st-tab-count">{s.items.length} items</span>
            </button>
          ))}
        </div>
        <div class="st-panes">
          {stages.map((s, i) => (
            <div class:list={["st-pane", i === 0 && "is-on"]} role="tabpanel" id={`pane-${i}`} aria-labelledby={`tab-${i}`} data-pane={i}>
              <p class="st-pane-line">{s.line}</p>
              <ul>
                {s.items.map(([t, d], k) => (
                  <li style={`--k:${k}`}>
                    <svg class="st-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                    <span class="st-item"><b>{t}</b><span>{d}</span></span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
      <p class="st-foot">* Some items, such as business email, domain and hosting, have separate running costs charged by the provider.</p>
    </div>
  </section>

  <!-- 4. How it works -->
  <section class="st-pin st-pin--how st-cream st-how" data-pin="how" aria-labelledby="how-title">
    <div class="st-pin-in">
      <svg class="st-deco" viewBox="0 0 1200 300" preserveAspectRatio="xMidYMax slice" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2"><rect x="60" y="120" width="220" height="220" rx="56" transform="rotate(45 170 230)"/><rect x="300" y="120" width="220" height="220" rx="56" transform="rotate(45 410 230)"/><rect x="540" y="120" width="220" height="220" rx="56" transform="rotate(45 650 230)"/><rect x="780" y="120" width="220" height="220" rx="56" transform="rotate(45 890 230)"/></g></svg>
    <div class="st-wrap">
      <h2 id="how-title" class="display st-h2">How it works</h2>
      <ol class="st-flow" data-flow>
        <span class="st-flow-line" aria-hidden="true"><span></span></span>
        {steps.map(([when, t, d, get], i) => (
          <li style={`--i:${i}`}>
            <p class="st-when"><span>{when}</span></p>
            <span class="st-node" aria-hidden="true">{i + 1}</span>
            <h3>{t}</h3>
            <p class="st-flow-text">{d}</p>
            <p class="st-get"><span>You get</span>{get}</p>
          </li>
        ))}
      </ol>
      <p class="st-foot">Timelines are a guide and can extend depending on your requirements.</p>
    </div>
    </div>
  </section>

  <!-- 5. Price -->
  <section class="st-sec st-red st-price" id="price" aria-labelledby="price-title">
    <svg class="st-rings" viewBox="0 0 800 800" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2"><circle cx="400" cy="400" r="120"/><circle cx="400" cy="400" r="210"/><circle cx="400" cy="400" r="300"/><circle cx="400" cy="400" r="390"/></g></svg>
    <div class="st-wrap">
      <h2 id="price-title" class="sr-only">Price</h2>
      <div class="st-amountrow">
        <p class="st-amount" data-odo aria-label="From £999">
          <span class="st-from" aria-hidden="true">From</span>
          <span class="st-pound" aria-hidden="true">£</span>
          <span class="odo-col" aria-hidden="true" style="--d:9"><span>0123456789</span></span>
          <span class="odo-col" aria-hidden="true" style="--d:9"><span>0123456789</span></span>
          <span class="odo-col" aria-hidden="true" style="--d:9"><span>0123456789</span></span>
        </p>
        <p class="st-seal" aria-hidden="true"><span>Fixed price</span><span>no surprises</span></p>
      </div>
      <div class="st-pricegrid">
        <div class="st-payblock">
          <p class="st-terms">One-time fee. About two months to launch.</p>
          <div class="st-pay" data-pay role="group" aria-label="Payment plan">
            <span class="st-pay-line" aria-hidden="true"><span></span></span>
            <p class="st-pay-node" tabindex="0"><i aria-hidden="true"></i><b>Start</b><span>50% · £499.50</span></p>
            <p class="st-pay-node" tabindex="0"><i aria-hidden="true"></i><b>Launch</b><span>50% · £499.50</span></p>
          </div>
          <div class="st-actions">
            <a class="st-pill st-pill--cream" href="#start" data-preset={START} data-cursor="Go">Get started <i aria-hidden="true">↗</i></a>
            <a class="st-pill st-pill--line" href="#start" data-preset={CHECK} data-cursor="Go">Free 15-minute website check <i aria-hidden="true">↗</i></a>
          </div>
        </div>
        <div class="st-yesno">
          <div>
            <h3>Included</h3>
            <ul>{included.map((t) => <li><i class="st-yes" aria-hidden="true">✓</i>{t}</li>)}</ul>
          </div>
          <div class="st-no">
            <h3>Not included</h3>
            <ul>{notIncluded.map((t) => <li><i class="st-x" aria-hidden="true">✕</i><span>{t}</span></li>)}</ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Proof: impact carousel -->
  <section class="st-sec st-ink st-impact" aria-labelledby="impact-title">
    <div class="st-wrap">
      <div class="st-impact-head">
        <div>
          <h2 id="impact-title" class="display st-h2">Our impact</h2>
          <p class="st-sub">What twelve months of local SEO and AI-search work did for a Croydon wellness brand.</p>
        </div>
        <div class="st-arrows">
          <button type="button" class="st-arrow" data-dir="-1" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"></path></svg></button>
          <button type="button" class="st-arrow" data-dir="1" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"></path></svg></button>
        </div>
      </div>
    </div>
    <div class="st-track" data-track data-cursor="Drag" tabindex="0" aria-label="Results, scroll sideways">
      <article class="st-card st-card--photo">
        <a href={url("/blog/croydon-wellness-ai-search")} data-cursor="Read">
          <Image src={casePhoto} alt="" widths={[480, 800]} sizes="26rem" loading="lazy" />
          <span class="st-card-cap"><b>Croydon wellness brand</b><span>SEO, AEO and GEO over 12 months</span><i>Read the case study →</i></span>
        </a>
      </article>
      <article class="st-card">
        <p class="st-card-label">AI-search visibility</p>
        <p class="st-big-n"><b data-from="7.4" data-to="31" data-dec="1">31.0</b>%</p>
        <p class="st-card-text">of 200 monitored AI prompts now mention the brand, up from 7.4%.</p>
        <svg class="st-spark" viewBox="0 0 200 70" aria-hidden="true"><polyline points="8,62 58,54 108,40 158,22 192,8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" pathLength="1"></polyline><circle cx="192" cy="8" r="5"/></svg>
      </article>
      <article class="st-card st-card--red">
        <p class="st-card-label">Organic impressions</p>
        <p class="st-big-n">+<b data-from="0" data-to="184" data-dec="0">184</b>%</p>
        <p class="st-card-text">from 21,400 to 60,700 a month.</p>
        <div class="st-pair" aria-hidden="true"><span style="--w:35%"></span><span style="--w:100%"></span></div>
      </article>
      <article class="st-card">
        <p class="st-card-label">Qualified enquiries</p>
        <p class="st-big-n">+<b data-from="0" data-to="78" data-dec="0">78</b>%</p>
        <p class="st-card-text">from 46 to 82 a month.</p>
        <div class="st-pair" aria-hidden="true"><span style="--w:56%"></span><span style="--w:100%"></span></div>
      </article>
      <article class="st-card st-card--red">
        <p class="st-card-label">Prompts citing their own content</p>
        <p class="st-big-n"><b data-from="5" data-to="62" data-dec="0">62</b></p>
        <p class="st-card-text">up from 5 at the start of the campaign.</p>
        <div class="st-pair" aria-hidden="true"><span style="--w:8%"></span><span style="--w:100%"></span></div>
      </article>
    </div>
  </section>

  <!-- 7. After launch -->
  <section class="st-sec st-cream st-after" aria-labelledby="after-title">
    <div class="st-wrap">
      <h2 id="after-title" class="display st-h2">Want us to keep going?</h2>
      <p class="st-sub">Optional, after launch, and quoted separately.</p>
      <div class="st-plans">
        {plans.map((p) => (
          <article class="st-plan">
            <h3>{p.name}</h3>
            <p>{p.text}</p>
            <ul>{p.points.map((t) => <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>{t}</li>)}</ul>
            <a class="st-pill st-pill--cream" href="#start" data-preset={p.ask} data-cursor="Go">Ask about it <i aria-hidden="true">↗</i></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Questions -->
  <section class="st-sec st-ink st-faq-sec" aria-labelledby="faq-title">
    <div class="st-wrap st-faqgrid">
      <div class="st-faqside">
        <h2 id="faq-title" class="display st-h2">Questions</h2>
        <p>Still unsure? Ask us anything. We reply within one working day.</p>
        <ul class="st-ask">
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer">Message us on WhatsApp</a></li>
        </ul>
        <a class="st-pill st-pill--cream" href="#start" data-preset={CHECK} data-cursor="Go">Free 15-minute website check <i aria-hidden="true">↗</i></a>
      </div>
      <div class="st-faq" data-faq>
        {faq.map((f, i) => (
          <details>
            <summary><span class="st-q-n">{String(i + 1).padStart(2, "0")}</span><span class="st-q">{f.q}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></summary>
            <div class="st-faq-a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ClosingCta tone="red" title="Let's build yours." lede="Tell us about your business and we'll come back with a clear plan and a start date." service="Starter website (£999)" />
  <StickyCta label="Get started · £999" preset={START} />
</BaseLayout>

<script>

  const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const clamp = (n: number, a = 0, b = 1) => Math.min(b, Math.max(a, n));
  document.documentElement.classList.add("js-st");
  const seen = (els: Iterable<Element>, cb: (el: Element) => void, threshold = 0.4) => {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { cb(e.target); io.unobserve(e.target); } }), { threshold });
    for (const el of els) io.observe(el);
  };
  const countUp = (el: HTMLElement, from: number, to: number, dec: number, ms = 1100) => {
    if (calm) { el.textContent = to.toFixed(dec); return; }
    const t0 = performance.now();
    const tick = (t: number) => {
      const k = Math.min(1, (t - t0) / ms);
      el.textContent = (from + (to - from) * (1 - Math.pow(1 - k, 3))).toFixed(dec);
      if (k < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  // Pinned scenes: how far the tall outer section has scrolled (0 to 1) while its inner scene is held on screen
  const wide = () => window.matchMedia("(min-width: 900px)").matches && !calm;
  const pinProgress = (sec: HTMLElement) => {
    const dist = sec.offsetHeight - window.innerHeight;
    return clamp(-sec.getBoundingClientRect().top / Math.max(1, dist));
  };
  const onScroll = (fn: () => void) => {
    let ticking = false;
    const run = () => { ticking = false; fn(); };
    window.addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(run); } }, { passive: true });
    window.addEventListener("resize", run);
    run();
  };

  // Statement: held on screen while words light up with your scroll; the first sentence stays dimmer
  document.querySelectorAll<HTMLElement>("[data-statement]").forEach((p) => {
    if (calm) return;
    const sec = p.closest<HTMLElement>("[data-pin]")!;
    const words = [...p.querySelectorAll<HTMLElement>(".sw")];
    p.classList.add("is-live");
    onScroll(() => {
      let prog: number;
      prog = clamp(pinProgress(sec) / 0.85);
      const lit = prog * 1.15 * words.length;
      words.forEach((w, i) => w.style.setProperty("--o", clamp(lit - i).toFixed(3)));
    });
  });

  // What's included: switch stage on hover, tap or arrow keys
  document.querySelectorAll<HTMLElement>("[data-stages]").forEach((box) => {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>(".st-tab")];
    const panes = [...box.querySelectorAll<HTMLElement>("[data-pane]")];
    const marker = box.querySelector<HTMLElement>(".st-marker")!;
    const place = (t: HTMLElement) => {
      marker.style.transform = `translate(${t.offsetLeft}px, ${t.offsetTop}px)`;
      marker.style.width = `${t.offsetWidth}px`;
      marker.style.height = `${t.offsetHeight}px`;
    };
    const pick = (i: number) => {
      tabs.forEach((t, k) => { t.setAttribute("aria-selected", String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      panes.forEach((p, k) => p.classList.toggle("is-on", k === i));
      place(tabs[i]);
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => pick(i));
      if (fine) t.addEventListener("pointerenter", () => pick(i));
      t.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowDown" || e.key === "ArrowRight" ? 1 : e.key === "ArrowUp" || e.key === "ArrowLeft" ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const n = (i + d + tabs.length) % tabs.length;
        pick(n);
        tabs[n].focus();
      });
    });
    window.addEventListener("resize", () => place(tabs.find((t) => t.getAttribute("aria-selected") === "true")!));
    pick(0);
    document.fonts?.ready.then(() => place(tabs[0]));
  });
  document.querySelectorAll<HTMLElement>("[data-to]").forEach((b) => {
    const from = Number(b.dataset.from), to = Number(b.dataset.to), dec = Number(b.dataset.dec ?? 0);
    b.textContent = from.toFixed(dec);
    seen([b], () => countUp(b, from, to, dec), 0.8);
  });

  // How it works: held on screen; the line fills and each step lights in turn as you scroll
  const flow = document.querySelector<HTMLElement>("[data-flow]");
  if (flow) {
    const sec = flow.closest<HTMLElement>("[data-pin]")!;
    const items = [...flow.querySelectorAll<HTMLElement>("li")];
    onScroll(() => {
      let prog: number;
      if (calm) prog = 1;
      else if (wide()) prog = clamp((pinProgress(sec) - 0.04) / 0.86);
      else {
        const r = flow.getBoundingClientRect();
        prog = clamp((window.innerHeight * 0.7 - r.top) / r.height);
      }
      flow.style.setProperty("--p", prog.toFixed(3));
      let current = 0;
      items.forEach((li, i) => {
        const lit = prog >= i / (items.length - 1) - 0.001;
        li.classList.toggle("is-lit", lit);
        if (lit) current = i;
      });
      items.forEach((li, i) => li.classList.toggle("is-current", !calm && i === current));
    });
  }

  // Price: digits roll once; payment path fills
  const odo = document.querySelector<HTMLElement>("[data-odo]");
  if (odo && !calm) {
    odo.classList.add("is-armed");
    seen([odo], () => requestAnimationFrame(() => odo.classList.add("is-rolled")), 0.5);
  }
  document.querySelectorAll<HTMLElement>("[data-pay]").forEach((el) => seen([el], () => el.classList.add("is-in"), 0.6));

  // Impact carousel: arrows, drag, and cards animate in
  const track = document.querySelector<HTMLElement>("[data-track]");
  if (track) {
    const step = () => (track.querySelector<HTMLElement>(".st-card")?.offsetWidth ?? 320) + 16;
    document.querySelectorAll<HTMLButtonElement>(".st-arrow").forEach((b) =>
      b.addEventListener("click", () => track.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: calm ? "auto" : "smooth" })),
    );
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") track.scrollBy({ left: step(), behavior: "smooth" });
      if (e.key === "ArrowLeft") track.scrollBy({ left: -step(), behavior: "smooth" });
    });
    let down = false, x0 = 0, s0 = 0, moved = false;
    track.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse") return;
      down = true; moved = false; x0 = e.clientX; s0 = track.scrollLeft;
    });
    window.addEventListener("pointermove", (e) => {
      if (!down) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 4) { moved = true; track.classList.add("is-drag"); }
      track.scrollLeft = s0 - dx;
    });
    window.addEventListener("pointerup", () => { down = false; track.classList.remove("is-drag"); });
    track.addEventListener("click", (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
    seen(track.querySelectorAll(".st-card"), (el) => el.classList.add("is-in"), 0.5);
  }

  // Hero: sticker leans toward the cursor and wiggles when you reach for the Starter panel
  const badge = document.querySelector<HTMLElement>("[data-badge]");
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (badge && hero && fine && !calm) {
    hero.addEventListener("pointermove", (e) => {
      const r = badge.getBoundingClientRect();
      const dx = (e.clientX - (r.left + r.width / 2)) / window.innerWidth;
      const dy = (e.clientY - (r.top + r.height / 2)) / window.innerHeight;
      badge.style.setProperty("--tx", `${(dx * 14).toFixed(1)}px`);
      badge.style.setProperty("--ty", `${(dy * 14).toFixed(1)}px`);
      badge.style.setProperty("--rot", `${(-8 + dx * 10).toFixed(1)}deg`);
    });
  }

  // FAQ: one open at a time, smooth height
  const faq = document.querySelector<HTMLElement>("[data-faq]");
  if (faq) {
    const items = [...faq.querySelectorAll<HTMLDetailsElement>("details")];
    const animate = (d: HTMLDetailsElement, open: boolean) => {
      const body = d.querySelector<HTMLElement>(".st-faq-a")!;
      if (calm) { d.open = open; return; }
      const h = body.scrollHeight;
      if (open) {
        d.open = true;
        body.animate({ height: ["0px", `${h}px`], opacity: [0, 1] }, { duration: 280, easing: "ease-out" });
      } else {
        const a = body.animate({ height: [`${h}px`, "0px"], opacity: [1, 0] }, { duration: 220, easing: "ease-in" });
        a.onfinish = () => (d.open = false);
      }
    };
    items.forEach((d) => {
      d.querySelector("summary")!.addEventListener("click", (e) => {
        e.preventDefault();
        const willOpen = !d.open;
        items.forEach((o) => { if (o !== d && o.open) animate(o, false); });
        animate(d, willOpen);
      });
    });
  }

</script>
