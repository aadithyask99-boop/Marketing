---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClosingCta from "../components/ClosingCta.astro";
import Offices from "../components/Offices.astro";
import { webPage, breadcrumbs, serviceList } from "../lib/schema";
const o = Astro.site!.origin;
const schema = [
  webPage(o, "/contact-us", "ContactPage", "Contact", "Talk to Maximus Mediascape about SEO, AI search, websites and content."),
  breadcrumbs(o, [{ name: "Contact", path: "/contact-us" }]),
];
---

<BaseLayout schema={schema} title="Contact Our Marketing Agency" description="Talk to Maximus Mediascape about SEO, AI search, websites and content. Send us a message or find our offices." footerTone="ink">
  <ClosingCta tone="ink" hero heading="h1" />
  <Offices tone="ink" />
</BaseLayout>
