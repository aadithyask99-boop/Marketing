---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ClosingCta from "../../components/ClosingCta.astro";
import StickyCta from "../../components/StickyCta.astro";
import PathCards from "../../components/PathCards.astro";
import "../../styles/starter.css";
import "../../styles/startup.css";
import "../../styles/plans.css";
import { url, SITE } from "../../data/site";
import { PLANS_META, HERO, PLANS, COMPARE, STARTER_PANEL, EVERYTHING, EVERYTHING_EXTRA, WHO, ADDONS, FAQ_SECTION, FAQ_SIDE, FINAL_CTA, MARQUEE } from "../../data/plans";
import { teamNote } from "../../data/startup";
import { webPage, breadcrumbs } from "../../lib/schema";

const plans = [PLANS.care, PLANS.growth];
const panels = [...plans, STARTER_PANEL, EVERYTHING];
const PLAIN_ROWS = ["Month one setup", "Best for", "Strategy call", "Reporting"];
const NOT_IN = ["Add on", "Not included"];
const o = Astro.site!.origin;
const plain = (h: string) => h.replace(/<[^>]+>/g, "");
const schema = [
  webPage(o, "/our-services/care-and-growth-plans", "WebPage", PLANS_META.title, PLANS_META.description),
  {
    "@context": "https://schema.org",
    "@type": "OfferCatalog",
    name: "Care and Growth plans",
    itemListElement: plans.map((p) => ({
      "@type": "Offer",
      name: `${p.name} plan`,
      description: `${p.summary} ${p.term} Price excludes VAT.`,
      priceCurrency: "GBP",
      priceSpecification: { "@type": "UnitPriceSpecification", price: p.price.replace("£", ""), priceCurrency: "GBP", unitText: "MONTH", valueAddedTaxIncluded: false },
      url: `${o}/our-services/care-and-growth-plans/#${p.id}`,
      seller: { "@id": `${o}/#organization` },
    })),
  },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: FAQ_SECTION.items.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: plain(f.a) } })) },
  breadcrumbs(o, [{ name: "Services", path: "/our-services" }, { name: "Care and Growth plans", path: "/our-services/care-and-growth-plans" }]),
];
---

<BaseLayout title={PLANS_META.title} description={PLANS_META.description} schema={schema} footerTone="ink">
  <!-- 1. Hero (cream) with the client strip, then the journey in the same cream area -->
  <section class="pl-hero" aria-labelledby="plans-h1" data-hero>
    <div class="pl-hero-main">
      <h1 id="plans-h1" class="display pl-h1"><span data-xray>Plans that keep you found, trusted and contacted</span></h1>
      <p class="pl-lede">{HERO.intro}</p>
      <div class="pl-hero-cta">
        <a class="st-pill" href={HERO.primary.href} data-cursor="Go">{HERO.primary.label} <i aria-hidden="true">↓</i></a>
        <a class="su-link" href={url(HERO.secondary.href)} data-cursor="View">{HERO.secondary.label} <i aria-hidden="true">→</i></a>
      </div>
      <p class="pl-vat">{HERO.vat}</p>
    </div>
    <div class="su-marq" aria-hidden="true">
      <div class="su-marq-in">
        {[0, 1].map(() => (
          <div class="su-marq-set">
            {MARQUEE.map((w) => <><span>{w}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 3v18M4.2 7.5l15.6 9M19.8 7.5l-15.6 9"></path></svg></>)}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. Plans: three stacking panels (Care, Growth, Starter, Everything), no boxes -->
  <div class="su-stack" id="plans" data-stack role="region" aria-label="Plans">
    {panels.map((p, i) => (
      <section class:list={["su-panel", "pl-panel", (p.id === "care" || p.id === "starter") && "su-panel--dark", p.id === "everything" && "su-panel--red"]} id={p.id} data-panel style={`--z:${i + 1}`} aria-labelledby={`${p.id}-title`}>
        <div class="pl-panel-grid">
          <div class="pl-side">
            {p.badge && <p class="su-tag">({p.badge})</p>}
            <h2 id={`${p.id}-title`} class:list={["display", "pl-plan-name", "su-rise", p.id === "everything" && "pl-plan-name--q"]}><span>{p.name}</span></h2>
            <p class="pl-price"><span>{p.price}</span><small>{p.unit}</small></p>
            <p class="pl-term">{p.term}</p>
            <p class="pl-headline">{p.headline}</p>
            <p class="pl-summary">{p.summary}</p>
            <a class="st-pill pl-cta" href={p.cta.href} data-cursor="Go">{p.cta.label} <i aria-hidden="true">↗</i></a>
          </div>
          <div class="pl-body">
            <h3 class="pl-listhead">{p.monthOne.title}</h3>
            <ul class="pl-lines">{p.monthOne.items.map((t) => <li>{t}</li>)}</ul>
            <h3 class="pl-listhead">{p.monthly.title}</h3>
            <dl class="pl-rows">
              {p.monthly.rows.map((r) => <div class="pl-row"><dt>({r.label})</dt><dd>{r.text}</dd></div>)}
            </dl>
            {p.id === "everything" && (
              <>
                <h3 class="pl-listhead">{EVERYTHING_EXTRA.title}</h3>
                <dl class="pl-rows">
                  {EVERYTHING_EXTRA.rows.map((r) => <div class="pl-row"><dt>({r.label})</dt><dd>{r.text}</dd></div>)}
                </dl>
              </>
            )}
            {p.note && <p class="pl-note">{p.note}</p>}
          </div>
        </div>
      </section>
    ))}
  </div>

  <!-- 3. Comparison table: giant sticky column titles, tall ruled rows (serious.business reference) -->
  <section class="pl-sec pl-sec--ink pl-cmp" id="compare" aria-labelledby="compare-title">
    <div class="pl-split">
      <div class="pl-splitside">
        <p class="su-tag">(Care and Growth compared)</p>
        <h2 id="compare-title" class="display pl-h2 pl-h2--plain">{COMPARE.h2}</h2>
      </div>
      <div class="pl-splitmain">
        <table class="pl-table pl-addons pl-compare" role="table">
          <caption class="sr-only">{COMPARE.caption}</caption>
          <thead role="rowgroup">
            <tr role="row">{["What changes", "Care", "Growth"].map((h) => <th scope="col" role="columnheader">{h}</th>)}</tr>
          </thead>
          <tbody role="rowgroup">
            {COMPARE.rows.map((r) => (
              <tr role="row" class:list={[PLAIN_ROWS.includes(r[0]) && "pl-plainrow"]}>
                <th scope="row" role="rowheader" data-label="What changes">{r[0]}</th>
                <td role="cell" data-label="Care" class:list={[NOT_IN.includes(r[1]) && "pl-no", r[0] === "Price" && "pl-price-cell"]}>{r[1]}</td>
                <td role="cell" data-label="Growth" class:list={[!PLAIN_ROWS.includes(r[0]) && r[0] !== "Price" && "pl-gain", r[0] === "Price" && "pl-price-cell"]}>{r[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 4. Who it is for: Starter page pattern, on cream so it sits between the two ink bands -->
  <section class="su-sec su-sec--cream su-who-sec pl-who" aria-labelledby="who-title">
    <div class="su-sechead">
      <h2 id="who-title" class="display">Who it's <span class="su-accent">for</span></h2>
      <p class="su-tag">({WHO.tag})</p>
    </div>
    <ul class="su-who" data-who>
      {WHO.rows.map((a, i) => (
        <li class:list={[i === 0 && "is-active"]}>
          <h3>{a.name}</h3>
          <span class="su-wn" aria-hidden="true">0{i + 1}</span>
          <p>{a.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- 5. Add-ons: "Awarded by the best" table, sticky heading left, price tile follows the cursor -->
  <section class="pl-sec pl-sec--ink pl-add" id="add-ons" aria-labelledby="addons-title">
    <div class="pl-split">
      <div class="pl-splitside">
        <p class="su-tag">(Add-ons)</p>
        <h2 id="addons-title" class="display pl-h2 pl-h2--plain">{ADDONS.h2}</h2>
        <p class="pl-intro">{ADDONS.intro}</p>
      </div>
      <div class="pl-splitmain">
        <table class="pl-table pl-addons" role="table" data-addons>
          <thead role="rowgroup">
            <tr role="row">{ADDONS.head.map((h) => <th scope="col" role="columnheader">{h}</th>)}</tr>
          </thead>
          <tbody role="rowgroup">
            {ADDONS.rows.map((r) => (
              <>
                <tr role="row" data-price={r.cells[2]} class:list={[r.sub && "pl-has-sub"]} tabindex={r.sub ? 0 : undefined}>
                  <th scope="row" role="rowheader" data-label={ADDONS.head[0]}>{r.cells[0]}</th>
                  <td role="cell" data-label={ADDONS.head[1]}>{r.cells[1]}</td>
                  <td role="cell" class="pl-price-cell" data-label={ADDONS.head[2]}>{r.cells[2]}</td>
                  <td role="cell" data-label={ADDONS.head[3]}>{r.cells[3]}</td>
                </tr>
                {r.sub && (
                  <tr role="row" class="pl-subrow" data-price={r.sub[2]}>
                    <th scope="row" role="rowheader" data-label={ADDONS.head[0]}><span class="pl-sub-in">{r.sub[0]}</span></th>
                    <td role="cell" data-label={ADDONS.head[1]}><span class="pl-sub-in">{r.sub[1]}</span></td>
                    <td role="cell" class="pl-price-cell" data-label={ADDONS.head[2]}><span class="pl-sub-in">{r.sub[2]}</span></td>
                    <td role="cell" data-label={ADDONS.head[3]}><span class="pl-sub-in">{r.sub[3]}</span></td>
                  </tr>
                )}
              </>
            ))}
          </tbody>
        </table>
        <p class="pl-more">{ADDONS.more.text} <a class="su-link" href={ADDONS.more.link.href} data-cursor="Go">{ADDONS.more.link.label} <i aria-hidden="true">↗</i></a></p>
      </div>
    </div>
    <div class="pl-peek" data-peek aria-hidden="true"><div class="pl-peek-card"></div></div>
  </section>

  <!-- 6. FAQ, aligned with the Starter plan page: heading and contact side left, numbered accordion right -->
  <section class="pl-sec pl-sec--cream pl-faq" id="faq" aria-labelledby="faq-title">
    <div class="st-wrap st-faqgrid">
      <div class="st-faqside">
        <h2 id="faq-title" class="display st-h2">{FAQ_SECTION.h2}</h2>
        <p>{FAQ_SIDE.line}</p>
        <ul class="st-ask">
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer">Message us on WhatsApp</a></li>
        </ul>
        <a class="st-pill pl-faqcta" href={FAQ_SIDE.cta.href} data-cursor="Go">{FAQ_SIDE.cta.label} <i aria-hidden="true">↗</i></a>
      </div>
      <div class="st-faq" data-faq>
        {FAQ_SECTION.items.map((f, i) => (
          <details>
            <summary><span class="st-q-n">{String(i + 1).padStart(2, "0")}</span><span class="st-q">{f.q}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></summary>
            <div class="st-faq-a"><p set:html={f.a} /></div>
          </details>
        ))}
      </div>
    </div>
    <p class="pl-small">{FAQ_SECTION.smallPrint}</p>

  </section>

  <!-- 7. Note from the team and the path to the Starter plan (Starter page pattern) -->
  <section class="su-sec su-sec--cream su-programs pl-programs" aria-labelledby="programs-title">
    <div class="su-progintro">
      <p class="su-tag">(A note from the team)</p>
      <div>
        <h2 id="programs-title" class="su-progline">{teamNote.statement}</h2>
        <div class="su-progbody">
          {teamNote.paras.map((t) => <p>{t}</p>)}
          <p class="su-sign">{teamNote.sign}</p>
        </div>
        <a class="su-link" href="#programs-cards">See the Starter plan <i aria-hidden="true">↓</i></a>
      </div>
    </div>
    <PathCards local id="programs-cards" />
  </section>

  <!-- 8. Final call to action -->
  <ClosingCta tone="ink" title={FINAL_CTA.h2} lede={FINAL_CTA.body} service="Plans (not sure which fits)" />
  <StickyCta label="Talk to us about a plan" preset="I'd like to talk about the Care and Growth plans" />
</BaseLayout>

<script>
  import { initStack } from "../../scripts/stackPanels";

  const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const clamp = (n: number, a = 0, b = 1) => Math.min(b, Math.max(a, n));
  document.documentElement.classList.add("js-st");
  const seen = (els: Iterable<Element>, cb: (el: Element) => void, threshold = 0.4) => {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { cb(e.target); io.unobserve(e.target); } }), { threshold });
    for (const el of els) io.observe(el);
  };
  const onScroll = (fn: () => void) => {
    let ticking = false;
    const run = () => { ticking = false; fn(); };
    window.addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(run); } }, { passive: true });
    window.addEventListener("resize", run);
    run();
  };

  // Stacking plan panels
  const stack = document.querySelector<HTMLElement>("[data-stack]");
  if (stack) initStack(stack);
  seen(document.querySelectorAll(".su-rise"), (el) => el.classList.add("is-in"), 0.3);

  // Who it is for: the row nearest the middle of the screen lights up
  const who = document.querySelector<HTMLElement>("[data-who]");
  if (who) {
    const rows = [...who.querySelectorAll<HTMLElement>("li")];
    onScroll(() => {
      const mid = window.innerHeight * 0.5;
      let best = 0, d = Infinity;
      rows.forEach((r, i) => {
        const b = r.getBoundingClientRect();
        const dist = Math.abs(b.top + b.height / 2 - mid);
        if (dist < d) { d = dist; best = i; }
      });
      rows.forEach((r, i) => r.classList.toggle("is-active", i === best));
    });
  }

  // Add-ons: a small price tile follows the cursor over a row (mouse only)
  const addons = document.querySelector<HTMLElement>("[data-addons]");
  const peek = document.querySelector<HTMLElement>("[data-peek]");
  if (addons && peek && !calm && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    const card = peek.querySelector<HTMLElement>(".pl-peek-card")!;
    let tx = 0, ty = 0, x = 0, y = 0, on = false, raf = 0;
    const loop = () => {
      x += (tx - x) * 0.22; y += (ty - y) * 0.22;
      const tilt = Math.max(-8, Math.min(8, (tx - x) * 0.35));
      peek.style.transform = `translate(${x}px, ${y}px) rotate(${(-5 + tilt).toFixed(1)}deg)`;
      raf = on || Math.abs(tx - x) > 0.5 ? requestAnimationFrame(loop) : 0;
    };
    addons.querySelectorAll<HTMLElement>("tbody tr[data-price]").forEach((row) => {
      row.addEventListener("pointerenter", (e) => {
        card.textContent = row.dataset.price ?? "";
        tx = x = e.clientX + 20; ty = y = e.clientY + 20;
        on = true; peek.classList.add("is-on");
        if (!raf) raf = requestAnimationFrame(loop);
      });
      row.addEventListener("pointermove", (e) => { tx = e.clientX + 20; ty = e.clientY + 20; });
      row.addEventListener("pointerleave", () => { on = false; peek.classList.remove("is-on"); });
    });
  }

  // FAQ: one open at a time, smooth height (same as the Starter plan page)
  const faq = document.querySelector<HTMLElement>("[data-faq]");
  if (faq) {
    const items = [...faq.querySelectorAll<HTMLDetailsElement>("details")];
    const animate = (d: HTMLDetailsElement, open: boolean) => {
      const body = d.querySelector<HTMLElement>(".st-faq-a")!;
      if (calm) { d.open = open; return; }
      const h = body.scrollHeight;
      if (open) {
        d.open = true;
        body.animate({ height: ["0px", `${h}px`], opacity: [0, 1] }, { duration: 280, easing: "ease-out" });
      } else {
        const a = body.animate({ height: [`${h}px`, "0px"], opacity: [1, 0] }, { duration: 220, easing: "ease-in" });
        a.onfinish = () => (d.open = false);
      }
    };
    items.forEach((d) => {
      d.querySelector("summary")!.addEventListener("click", (e) => {
        e.preventDefault();
        const willOpen = !d.open;
        items.forEach((o) => { if (o !== d && o.open) animate(o, false); });
        animate(d, willOpen);
      });
    });
  }
</script>
