---
import BaseLayout from "../layouts/BaseLayout.astro";
import LeadForm from "../components/LeadForm.astro";
import { LEAD, SITE } from "../data/site";
---

<BaseLayout title="Contact" description="Get in touch with Maximus Mediascape.">
  <section class="section page-top">
    <p class="eyebrow">Contact</p>
    <h1 class="display page-title">Let's bond</h1>
    <p class="lede">
      {LEAD.lede} Prefer email? Write to
      <a href={`mailto:${SITE.email}`} style="text-decoration: underline">{SITE.email}</a>.
    </p>
    <LeadForm id="contact" />
  </section>
</BaseLayout>
