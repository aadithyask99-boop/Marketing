---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ScrollStory from "../components/ScrollStory.astro";
import { SERVICES, WORK, url } from "../data/site";
---

<BaseLayout>
  <Hero />
  <ScrollStory />

  <section class="section" aria-labelledby="services-title">
    <p class="eyebrow">What we do</p>
    <h2 id="services-title" class="display section-title">
      Seven ways to <span class="accent">grow</span>
    </h2>
    <div class="rows">
      {
        SERVICES.map((s) => (
          <a class="row" href={url("/services")} data-cursor="View">
            <span class="display row-name">{s.name}</span>
            <p class="row-desc">{s.desc}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section section--cream" aria-labelledby="work-title">
    <p class="eyebrow">Selected work</p>
    <h2 id="work-title" class="display section-title">Recent projects</h2>
    <div class="grid grid--3">
      {
        WORK.slice(0, 3).map((w) => (
          <a
            class:list={["card", w.tone === "blue" && "card--blue", w.tone === "ink" && "card--ink", w.tone === "cream" && "card--red"]}
            href={url("/work")}
            data-cursor="View"
          >
            <span class="card-meta">{w.category}</span>
            <span class="display card-title">{w.title}</span>
          </a>
        ))
      }
    </div>
    <p style="margin-top: 2rem"><a class="btn" href={url("/work")}>See all work</a></p>
  </section>

  <section class="section" aria-labelledby="cta-title">
    <h2 id="cta-title" class="display section-title">
      Ready to be <span class="accent">found</span>,<br />remembered and chosen?
    </h2>
    <p class="lede">Tell us where you want to be. We'll show you the fastest route there.</p>
    <p style="margin-top: 2rem"><a class="btn" href={url("/contact")} data-cursor="Hello">Start a project</a></p>
  </section>
</BaseLayout>
