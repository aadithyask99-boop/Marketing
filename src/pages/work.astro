---
import BaseLayout from "../layouts/BaseLayout.astro";
import Process from "../components/Process.astro";
import Proof from "../components/Proof.astro";
import Voices from "../components/Voices.astro";
import ClosingCta from "../components/ClosingCta.astro";
import "../styles/offerings.css";
import "../styles/process.css";
import { RESULTS, url } from "../data/site";
import { webPage, breadcrumbs, serviceList } from "../lib/schema";
const o = Astro.site!.origin;
const schema = [
  webPage(o, "/work", "CollectionPage", "Work", "How Maximus Mediascape works, from planning and analysis to design and implementation, plus selected projects."),
  breadcrumbs(o, [{ name: "Work", path: "/work" }]),
];
---

<BaseLayout schema={schema} title="Work" description="How Maximus Mediascape works, from planning and analysis to design and implementation, plus selected projects.">
  <section class="work-hero page-top page-hero">
    <h1 class="display work-title">This is how we work</h1>
    <p class="lede">Three phases, one team, and a plan you can follow from the first call to the results.</p>
    <p class="work-plans"><a href={url("/plans")} data-cursor="View">Prefer it ongoing? See our plans <span aria-hidden="true">↗</span></a></p>
  </section>

  <Process />

  <section class="results" aria-label="Results">
    <ul>
      {RESULTS.map((r) => <li><a href={url(r.href)}><span class="result-value">{r.value}</span><span class="result-label">{r.label}{r.reported ? "*" : ""}</span><span class="result-who">{r.who}</span></a></li>)}
    </ul>
    <p class="results-note">* As reported by the client. Figures from our case studies; <a href={url("/blogs")}>read the full stories</a>.</p>
  </section>

  <Proof />
  <Voices />
  <ClosingCta />
</BaseLayout>
