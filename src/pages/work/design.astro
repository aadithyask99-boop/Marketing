---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ClosingCta from "../../components/ClosingCta.astro";
import DesignHero from "../../components/DesignHero.astro";
import DesignStory from "../../components/DesignStory.astro";
import DesignRail from "../../components/DesignRail.astro";
import DesignBoard from "../../components/DesignBoard.astro";
import DesignWall from "../../components/DesignWall.astro";
import "@fontsource/instrument-serif/400-italic.css";
import "../../styles/design.css";
import { getImage } from "astro:assets";
import { DESIGN_PROJECTS, DESIGN_FAQ, DESIGN_WALL, WALL_KINDS } from "../../data/design";
import { webPage, breadcrumbs } from "../../lib/schema";

const o = Astro.site!.origin;
const title = "Branding, websites and social design for small businesses";
const desc = "Logos, brand identity, brand books, websites and Instagram grids for small businesses: housekeeping, wellness, spirits, packaging and more.";
const items = await Promise.all(
  DESIGN_PROJECTS.map(async (p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "CreativeWork",
      name: p.name,
      description: p.story.paras[0],
      keywords: p.story.keywords.join(", "),
      genre: "Brand identity",
      ...(p.story.place ? { contentLocation: { "@type": "Place", name: p.story.place } } : {}),
      url: `${o}/work/design#${p.slug}`,
      image: new URL((await getImage({ src: p.tiles[0].src, width: 1200, format: "webp" })).src, o).href,
      creator: { "@id": `${o}/#organization` },
    },
  })),
);
const wallItems = await Promise.all(
  DESIGN_WALL.map(async (t, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "ImageObject",
      name: `${WALL_KINDS[t.kind]} design, ${t.sector.toLowerCase()}`,
      description: t.alt,
      contentUrl: new URL((await getImage({ src: t.src, width: 1200, format: "webp" })).src, o).href,
      creator: { "@id": `${o}/#organization` },
    },
  })),
);
const schema = [
  webPage(o, "/work/design", "CollectionPage", title, desc),
  { "@context": "https://schema.org", "@type": "ItemList", name: "Design work", itemListElement: items },
  { "@context": "https://schema.org", "@type": "ItemList", name: "Websites and Instagram grids", itemListElement: wallItems },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: DESIGN_FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  breadcrumbs(o, [{ name: "Work", path: "/work" }, { name: "Design", path: "/work/design" }]),
];
---

<BaseLayout schema={schema} title={title} description={desc}>
  <DesignHero />
  <DesignStory part="intro" />

  <div class="dz-body">
    <div class="dz-layout">
      <DesignRail projects={DESIGN_PROJECTS} />
      <div class="dz-boards">
        {DESIGN_PROJECTS.map((p, i) => <DesignBoard project={p} index={i} />)}
      </div>
    </div>
  </div>

  <DesignWall />
  <DesignStory part="process" />
  <DesignStory part="faq" />

  <dialog class="dz-lb" aria-label="Image viewer">
    <button class="dz-lb-x" type="button" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <button class="dz-lb-nav dz-lb-prev" type="button" aria-label="Previous image">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <button class="dz-lb-nav dz-lb-next" type="button" aria-label="Next image">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
    <figure class="dz-lb-fig">
      <img class="dz-lb-img" alt="" />
      <figcaption><b class="dz-lb-proj"></b><span class="dz-lb-cap"></span><span class="dz-lb-count"></span></figcaption>
    </figure>
  </dialog>

  <ClosingCta service="Brand & Identity" />
</BaseLayout>

<script>
  import { initXray } from "../../scripts/xray";
  initXray(document.querySelector(".dz-title"), 12);

  const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const root = document.documentElement;
  root.classList.add("js-dz");

  // Tiles fade up as they arrive
  const tiles = [...document.querySelectorAll<HTMLElement>(".dz-tile")];
  if (calm) tiles.forEach((t) => t.classList.add("is-in"));
  else {
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); } }),
      { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
    );
    tiles.forEach((t) => io.observe(t));
  }

  // Hero: the work cards drift with the pointer (mouse only)
  const hero = document.querySelector<HTMLElement>("[data-dz-hero]");
  if (hero && !calm && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    const cards = [...hero.querySelectorAll<HTMLElement>(".dz-hc")];
    let queued = false;
    let pt = { x: 0, y: 0 };
    const apply = () => {
      queued = false;
      cards.forEach((el) => {
        const d = Number(el.dataset.depth);
        el.style.setProperty("--px", `${(pt.x * d).toFixed(1)}px`);
        el.style.setProperty("--py", `${(pt.y * d).toFixed(1)}px`);
      });
    };
    hero.addEventListener("pointermove", (e) => {
      const r = hero.getBoundingClientRect();
      pt = { x: (e.clientX - r.left) / r.width - 0.5, y: (e.clientY - r.top) / r.height - 0.5 };
      if (!queued) { queued = true; requestAnimationFrame(apply); }
    });
    hero.addEventListener("pointerleave", () => { pt = { x: 0, y: 0 }; apply(); });
  }

  // Process steps light up as they arrive
  const steps = [...document.querySelectorAll<HTMLElement>("[data-dz-flow] li")];
  if (calm) steps.forEach((t) => t.classList.add("is-in"));
  else {
    const so = new IntersectionObserver(
      (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-in"); so.unobserve(e.target); } }),
      { rootMargin: "0px 0px -10% 0px", threshold: 0.2 },
    );
    steps.forEach((t) => so.observe(t));
  }

  // Rail: highlight the project in view and slide the ink pill to it (desktop), or scroll the strip (mobile)
  const rail = document.querySelector<HTMLElement>("[data-rail]");
  const boards = [...document.querySelectorAll<HTMLElement>("[data-board]")];
  if (rail && boards.length) {
    const links = [...rail.querySelectorAll<HTMLAnchorElement>("a[data-spy]")];
    const hl = rail.querySelector<HTMLElement>(".dz-hl")!;
    const nav = rail.querySelector<HTMLElement>(".dz-nav")!;
    const list = rail.querySelector<HTMLElement>(".dz-index")!;
    const of = rail.querySelector<HTMLElement>("[data-of]");
    const strip = () => window.matchMedia("(max-width: 899px)").matches;
    let current = "";
    const mark = (slug: string) => {
      const a = links.find((l) => l.dataset.spy === slug);
      if (!a) return;
      links.forEach((l) => (l === a ? l.setAttribute("aria-current", "location") : l.removeAttribute("aria-current")));
      if (of) of.textContent = String(links.indexOf(a) + 1).padStart(2, "0");
      if (strip()) {
        list.scrollTo({ left: a.offsetLeft - (list.clientWidth - a.offsetWidth) / 2, behavior: calm ? "auto" : "smooth" });
      } else {
        const li = a.parentElement as HTMLElement;
        hl.style.height = `${li.offsetHeight}px`;
        hl.style.transform = `translateY(${li.offsetTop}px)`;
        hl.style.opacity = "1";
      }
    };
    const pick = () => {
      // The board whose top has passed 40% of the viewport is the current one
      const line = window.innerHeight * 0.4;
      const first = boards[0].getBoundingClientRect().top;
      const last = boards[boards.length - 1].getBoundingClientRect().bottom;
      nav.style.setProperty("--p", Math.min(1, Math.max(0, (line - first) / Math.max(1, last - first))).toFixed(3));
      let slug = boards[0].id;
      for (const b of boards) if (b.getBoundingClientRect().top <= line) slug = b.id;
      if (first > line) { current = ""; links.forEach((l) => l.removeAttribute("aria-current")); hl.style.opacity = "0"; return; }
      if (slug !== current) { current = slug; mark(slug); }
    };
    let ticking = false;
    window.addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; pick(); }); } }, { passive: true });
    window.addEventListener("resize", () => { current = ""; pick(); });
    document.fonts?.ready.then(() => { current = ""; pick(); });
    pick();
  }

  // Lightbox: previous and next stay within the project that was opened
  const dlg = document.querySelector<HTMLDialogElement>(".dz-lb")!;
  const lbImg = dlg.querySelector<HTMLImageElement>(".dz-lb-img")!;
  const lbProj = dlg.querySelector<HTMLElement>(".dz-lb-proj")!;
  const lbCap = dlg.querySelector<HTMLElement>(".dz-lb-cap")!;
  const lbCount = dlg.querySelector<HTMLElement>(".dz-lb-count")!;
  type Item = { full: string; alt: string; caption: string };
  let set: Item[] = [];
  let at = 0;
  let opener: HTMLElement | null = null;
  const show = (i: number) => {
    at = (i + set.length) % set.length;
    const b = set[at];
    lbImg.src = b.full;
    lbImg.alt = b.alt;
    lbCap.textContent = b.caption;
    lbCount.textContent = `${at + 1} / ${set.length}`;
    for (const j of [at + 1, at - 1]) { const pre = new Image(); pre.src = set[(j + set.length) % set.length].full; }
  };
  const openBox = (items: Item[], i: number, title: string, from: HTMLElement | null) => {
    set = items; opener = from;
    lbProj.textContent = title;
    show(i);
    root.classList.add("dz-lock");
    dlg.showModal();
  };
  document.querySelectorAll<HTMLElement>("[data-board]").forEach((board) => {
    const btns = [...board.querySelectorAll<HTMLButtonElement>(".dz-open")];
    const list: Item[] = btns.map((b) => ({ full: b.dataset.full ?? "", alt: b.dataset.alt ?? "", caption: b.dataset.caption ?? "" }));
    btns.forEach((b, i) => b.addEventListener("click", () => openBox(list, i, board.querySelector(".dz-name")?.textContent ?? "", b)));
  });
  // The interactive brand book's Enlarge button reuses the same viewer
  window.addEventListener("dz:lightbox", (e) => {
    const d = (e as CustomEvent<{ items: Item[]; index: number; title: string; opener: HTMLElement }>).detail;
    openBox(d.items, d.index, d.title, d.opener);
  });
  dlg.addEventListener("close", () => { root.classList.remove("dz-lock"); opener?.focus({ preventScroll: true }); });
  dlg.querySelector(".dz-lb-x")!.addEventListener("click", () => dlg.close());
  dlg.querySelector(".dz-lb-prev")!.addEventListener("click", () => show(at - 1));
  dlg.querySelector(".dz-lb-next")!.addEventListener("click", () => show(at + 1));
  // A click on the dark backdrop closes it
  dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener("keydown", (e) => {
    if (e.key === "ArrowRight") { e.preventDefault(); show(at + 1); }
    if (e.key === "ArrowLeft") { e.preventDefault(); show(at - 1); }
  });
  // The wall: tiles settle in, drift a little as you scroll, and the chips fade the other kind
  const wall = document.querySelector<HTMLElement>("[data-dz-wall]");
  if (wall) {
    const wts = [...wall.querySelectorAll<HTMLElement>(".dz-wt")];
    if (calm) wts.forEach((t) => t.classList.add("is-in"));
    else {
      const wio = new IntersectionObserver(
        (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-in"); wio.unobserve(e.target); } }),
        { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
      );
      wts.forEach((t) => wio.observe(t));
      // Scroll drift: each tile moves a few px against the scroll, by its own depth
      let wq = false;
      const drift = () => {
        wq = false;
        const vh = window.innerHeight;
        for (const t of wts) {
          const r = t.getBoundingClientRect();
          if (r.bottom < -80 || r.top > vh + 80) continue;
          const k = (r.top + r.height / 2 - vh / 2) / vh; // -1 .. 1 around the middle of the screen
          t.style.setProperty("--py", `${(k * Number(t.dataset.depth)).toFixed(1)}px`);
        }
      };
      window.addEventListener("scroll", () => { if (!wq) { wq = true; requestAnimationFrame(drift); } }, { passive: true });
      drift();
    }
    const chips = [...wall.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const count = wall.querySelector<HTMLElement>("[data-wall-count]")!;
    const noun: Record<string, string> = { all: "pieces", web: "websites", social: "Instagram grids" };
    let kind = "all";
    const visible = () => wts.filter((t) => kind === "all" || t.dataset.kind === kind);
    chips.forEach((c) =>
      c.addEventListener("click", () => {
        kind = c.dataset.filter ?? "all";
        chips.forEach((o) => o.setAttribute("aria-pressed", String(o === c)));
        wts.forEach((t) => { const dim = !(kind === "all" || t.dataset.kind === kind); t.classList.toggle("is-dim", dim); t.toggleAttribute("inert", dim); });
        count.textContent = `${visible().length} ${noun[kind]}`;
      }),
    );
    // The viewer cycles through what is showing
    wts.forEach((t) =>
      t.querySelector<HTMLButtonElement>(".dz-wt-open")!.addEventListener("click", (e) => {
        const list = visible();
        const btns = list.map((x) => x.querySelector<HTMLButtonElement>(".dz-wt-open")!);
        const items: Item[] = btns.map((b) => ({ full: b.dataset.full ?? "", alt: b.dataset.alt ?? "", caption: b.dataset.caption ?? "" }));
        openBox(items, Math.max(0, list.indexOf(t)), "Websites and Instagram grids", e.currentTarget as HTMLElement);
      }),
    );
  }
  // Swipe on touch screens
  let sx = 0, sy = 0;
  dlg.addEventListener("pointerdown", (e) => { sx = e.clientX; sy = e.clientY; });
  dlg.addEventListener("pointerup", (e) => {
    if (e.pointerType === "mouse") return;
    const dx = e.clientX - sx, dy = e.clientY - sy;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(at + (dx < 0 ? 1 : -1));
  });
</script>
