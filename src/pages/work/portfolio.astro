---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ClosingCta from "../../components/ClosingCta.astro";
import DesignHero from "../../components/DesignHero.astro";
import DesignStory from "../../components/DesignStory.astro";
import DesignRail from "../../components/DesignRail.astro";
import DesignBoard from "../../components/DesignBoard.astro";
import DesignWall from "../../components/DesignWall.astro";
import DesignPageNav from "../../components/DesignPageNav.astro";
import "../../styles/design.css";
import { getImage } from "astro:assets";
import { DESIGN_PROJECTS, DESIGN_FAQ, DESIGN_WALL, WALL_KINDS } from "../../data/design";
import { webPage, breadcrumbs } from "../../lib/schema";

const o = Astro.site!.origin;
const title = "Portfolio: branding, websites and social design";
const desc = "Logos, brand identity, brand books, websites, apps, a wellness chatbot and Instagram grids for small businesses: housekeeping, wellness, spirits, packaging and more.";
const items = await Promise.all(
  DESIGN_PROJECTS.map(async (p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "CreativeWork",
      name: p.name,
      description: p.story.paras[0],
      keywords: p.story.keywords.join(", "),
      genre: "Brand identity",
      ...(p.story.place ? { contentLocation: { "@type": "Place", name: p.story.place } } : {}),
      url: `${o}/work/portfolio#${p.slug}`,
      image: new URL((await getImage({ src: p.tiles[0].src, width: 1200, format: "webp" })).src, o).href,
      creator: { "@id": `${o}/#organization` },
    },
  })),
);
const wallItems = await Promise.all(
  DESIGN_WALL.map(async (t, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "ImageObject",
      name: `${WALL_KINDS[t.kind]} design, ${t.sector.toLowerCase()}`,
      description: t.alt,
      contentUrl: new URL((await getImage({ src: t.src, width: 1200, format: "webp" })).src, o).href,
      creator: { "@id": `${o}/#organization` },
    },
  })),
);
const schema = [
  webPage(o, "/work/portfolio", "CollectionPage", title, desc),
  { "@context": "https://schema.org", "@type": "ItemList", name: "Portfolio", itemListElement: items },
  { "@context": "https://schema.org", "@type": "ItemList", name: "Websites, apps and Instagram grids", itemListElement: wallItems },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: DESIGN_FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  breadcrumbs(o, [{ name: "Work", path: "/work" }, { name: "Portfolio", path: "/work/portfolio" }]),
];
---

<BaseLayout schema={schema} title={title} description={desc}>
  <DesignHero />
  <DesignStory part="intro" />

  <div class="dz-body dz-body--brand" id="brand-identity">
    <header class="dz-wallhead">
      <h2 class="display dz-h2">Brand <span class="dz-accent">identity</span></h2>
      <p class="dz-wall-lede">Four brands, each with the idea behind it, the colours and type, and the mockups.</p>
    </header>
    <div class="dz-layout">
      <DesignRail projects={DESIGN_PROJECTS} title="Brand identity" />
      <div class="dz-boards">
        {DESIGN_PROJECTS.map((p, i) => <DesignBoard project={p} index={i} />)}
      </div>
    </div>
  </div>

  <DesignWall />
  <DesignStory part="faq" />

  <dialog class="dz-lb" aria-label="Image viewer">
    <button class="dz-lb-x" type="button" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <button class="dz-lb-nav dz-lb-prev" type="button" aria-label="Previous image">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <button class="dz-lb-nav dz-lb-next" type="button" aria-label="Next image">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
    <figure class="dz-lb-fig">
      <img class="dz-lb-img" alt="" />
      <figcaption><b class="dz-lb-proj"></b><span class="dz-lb-cap"></span><span class="dz-lb-count"></span></figcaption>
    </figure>
  </dialog>

  <dialog class="dz-live" aria-labelledby="dz-live-title">
    <div class="dz-live-in">
      <header class="dz-live-bar">
        <div class="dz-live-id">
          <p class="dz-live-kicker"><i aria-hidden="true"></i>Live</p>
          <h2 id="dz-live-title" class="dz-live-title"></h2>
        </div>
        <div class="dz-live-actions">
          <a class="dz-live-new" href="#" target="_blank" rel="noopener noreferrer"><span class="dz-live-url"></span> <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
          <button class="dz-live-x" type="button" aria-label="Close the live view">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
          </button>
        </div>
      </header>
      <div class="dz-live-stage"><span class="dz-live-load">Loading the live view…</span></div>
      <p class="dz-live-note">This is the live product. Please don't enter personal information.</p>
    </div>
  </dialog>

  <DesignPageNav />

  <ClosingCta service="Brand & Identity" />
</BaseLayout>

<script>
  import { initXray } from "../../scripts/xray";
  initXray(document.querySelector(".dz-title"), 12);

  const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const root = document.documentElement;
  root.classList.add("js-dz");

  // Tiles fade up as they arrive
  const tiles = [...document.querySelectorAll<HTMLElement>(".dz-tile")];
  if (calm) tiles.forEach((t) => t.classList.add("is-in"));
  else {
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); } }),
      { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
    );
    tiles.forEach((t) => io.observe(t));
  }

  // Rails: highlight the item in view and slide the ink pill to it (desktop), or scroll the strip (mobile).
  // Each .dz-layout has its own rail; its targets are the elements marked data-spy-target / data-board.
  document.querySelectorAll<HTMLElement>("[data-dz-layout], .dz-layout").forEach((layout) => {
    const rail = layout.querySelector<HTMLElement>("[data-rail]");
    const targets = [...layout.querySelectorAll<HTMLElement>("[data-board], [data-spy-target]")];
    if (!rail || !targets.length) return;
    const links = [...rail.querySelectorAll<HTMLAnchorElement>("a[data-spy]")];
    const hl = rail.querySelector<HTMLElement>(".dz-hl")!;
    const nav = rail.querySelector<HTMLElement>(".dz-nav")!;
    const list = rail.querySelector<HTMLElement>(".dz-index")!;
    const of = rail.querySelector<HTMLElement>("[data-of]");
    const scattered = targets[0].hasAttribute("data-spy-target"); // tiles in columns: pick the one nearest the line
    const strip = () => window.matchMedia("(max-width: 899px)").matches;
    let current = "";
    const mark = (slug: string) => {
      const a = links.find((l) => l.dataset.spy === slug);
      if (!a) return;
      links.forEach((l) => (l === a ? l.setAttribute("aria-current", "location") : l.removeAttribute("aria-current")));
      if (of) of.textContent = String(links.indexOf(a) + 1).padStart(2, "0");
      if (strip()) {
        list.scrollTo({ left: a.offsetLeft - (list.clientWidth - a.offsetWidth) / 2, behavior: calm ? "auto" : "smooth" });
      } else {
        const li = a.parentElement as HTMLElement;
        hl.style.height = `${li.offsetHeight}px`;
        hl.style.transform = `translateY(${li.offsetTop}px)`;
        hl.style.opacity = "1";
        // A rail taller than the screen scrolls itself to keep the current row in view
        const rin = rail.querySelector<HTMLElement>(".dz-rail-in");
        if (rin && rin.scrollHeight > rin.clientHeight + 2) {
          const ar = a.getBoundingClientRect(), rr = rin.getBoundingClientRect();
          if (ar.top < rr.top + 8 || ar.bottom > rr.bottom - 8) rin.scrollBy({ top: ar.top - rr.top - rin.clientHeight / 2 + ar.height / 2, behavior: calm ? "auto" : "smooth" });
        }
      }
    };
    const pick = () => {
      const line = window.innerHeight * 0.4;
      const box = layout.getBoundingClientRect();
      nav.style.setProperty("--p", Math.min(1, Math.max(0, (line - box.top) / Math.max(1, box.height))).toFixed(3));
      if (box.top > line || box.bottom < 0) { current = ""; links.forEach((l) => l.removeAttribute("aria-current")); hl.style.opacity = "0"; if (of) of.textContent = box.top > line ? "01" : String(links.length).padStart(2, "0"); return; }
      let slug = targets[0].id;
      if (scattered) {
        let best = Infinity;
        for (const t of targets) {
          const r = t.getBoundingClientRect();
          const d = line < r.top ? r.top - line : line > r.bottom ? line - r.bottom : 0; // 0 when the line crosses the tile
          const score = d * 2 + Math.abs(r.top + r.height / 2 - line) * 0.001;
          if (score < best) { best = score; slug = t.id; }
        }
      } else {
        for (const t of targets) if (t.getBoundingClientRect().top <= line) slug = t.id;
      }
      if (slug !== current) { current = slug; mark(slug); }
    };
    let ticking = false;
    window.addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; pick(); }); } }, { passive: true });
    window.addEventListener("resize", () => { current = ""; pick(); });
    document.fonts?.ready.then(() => { current = ""; pick(); });
    pick();
  });

  // Lightbox: previous and next stay within the project that was opened
  const dlg = document.querySelector<HTMLDialogElement>(".dz-lb")!;
  const lbImg = dlg.querySelector<HTMLImageElement>(".dz-lb-img")!;
  const lbProj = dlg.querySelector<HTMLElement>(".dz-lb-proj")!;
  const lbCap = dlg.querySelector<HTMLElement>(".dz-lb-cap")!;
  const lbCount = dlg.querySelector<HTMLElement>(".dz-lb-count")!;
  type Item = { full: string; alt: string; caption: string; tall?: boolean };
  let set: Item[] = [];
  let at = 0;
  let opener: HTMLElement | null = null;
  const show = (i: number) => {
    at = (i + set.length) % set.length;
    const b = set[at];
    dlg.classList.toggle("is-tall", !!b.tall);
    dlg.querySelector<HTMLElement>(".dz-lb-fig")!.scrollTop = 0;
    lbImg.src = b.full;
    lbImg.alt = b.alt;
    lbCap.textContent = b.caption;
    lbCount.textContent = `${at + 1} / ${set.length}`;
    for (const j of [at + 1, at - 1]) { const pre = new Image(); pre.src = set[(j + set.length) % set.length].full; }
  };
  const openBox = (items: Item[], i: number, title: string, from: HTMLElement | null) => {
    set = items; opener = from;
    lbProj.textContent = title;
    show(i);
    root.classList.add("dz-lock");
    dlg.showModal();
  };
  document.querySelectorAll<HTMLElement>("[data-board]").forEach((board) => {
    const btns = [...board.querySelectorAll<HTMLButtonElement>(".dz-open")];
    const list: Item[] = btns.map((b) => ({ full: b.dataset.full ?? "", alt: b.dataset.alt ?? "", caption: b.dataset.caption ?? "" }));
    btns.forEach((b, i) => b.addEventListener("click", () => openBox(list, i, board.querySelector(".dz-name")?.textContent ?? "", b)));
  });
  dlg.addEventListener("close", () => { root.classList.remove("dz-lock"); opener?.focus({ preventScroll: true }); });
  dlg.querySelector(".dz-lb-x")!.addEventListener("click", () => dlg.close());
  dlg.querySelector(".dz-lb-prev")!.addEventListener("click", () => show(at - 1));
  dlg.querySelector(".dz-lb-next")!.addEventListener("click", () => show(at + 1));
  // A click on the dark backdrop closes it
  dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener("keydown", (e) => {
    if (e.key === "ArrowRight") { e.preventDefault(); show(at + 1); }
    if (e.key === "ArrowLeft") { e.preventDefault(); show(at - 1); }
  });
  // The wall: tiles settle in, drift a little as you scroll, and the chips fade the other kind
  const wall = document.querySelector<HTMLElement>("[data-dz-wall]");
  if (wall) {
    const wts = [...wall.querySelectorAll<HTMLElement>(".dz-wt")];
    if (calm) wts.forEach((t) => t.classList.add("is-in"));
    else {
      const wio = new IntersectionObserver(
        (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-in"); wio.unobserve(e.target); } }),
        { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
      );
      wts.forEach((t) => wio.observe(t));
      // Scroll drift: each tile moves a few px against the scroll, by its own depth
      let wq = false;
      const drift = () => {
        wq = false;
        const vh = window.innerHeight;
        for (const t of wts) {
          const r = t.getBoundingClientRect();
          if (r.bottom < -80 || r.top > vh + 80) continue;
          const k = (r.top + r.height / 2 - vh / 2) / vh; // -1 .. 1 around the middle of the screen
          t.style.setProperty("--py", `${(k * Number(t.dataset.depth)).toFixed(1)}px`);
        }
      };
      window.addEventListener("scroll", () => { if (!wq) { wq = true; requestAnimationFrame(drift); } }, { passive: true });
      drift();
    }
    // The viewer cycles through all the pieces, in the same order as the rail
    const order = [...wall.querySelectorAll<HTMLElement>(".dz-rail a[data-spy]")].map((a) => document.getElementById(a.dataset.spy!)!).filter(Boolean);
    const items: Item[] = order.map((t) => {
      const b = t.querySelector<HTMLButtonElement>(".dz-wt-open")!;
      return { full: b.dataset.full ?? "", alt: b.dataset.alt ?? "", caption: b.dataset.caption ?? "", tall: b.dataset.tall === "1" };
    });
    order.forEach((t, i) =>
      t.querySelector<HTMLButtonElement>(".dz-wt-open")!.addEventListener("click", (e) => openBox(items, i, "Websites, apps and Instagram grids", e.currentTarget as HTMLElement)),
    );
  }

  // Live view: nothing from the client's site loads until someone asks for it
  const live = document.querySelector<HTMLDialogElement>(".dz-live");
  if (live) {
    const stage = live.querySelector<HTMLElement>(".dz-live-stage")!;
    const ttl = live.querySelector<HTMLElement>(".dz-live-title")!;
    const urlEl = live.querySelector<HTMLElement>(".dz-live-url")!;
    const newTab = live.querySelector<HTMLAnchorElement>(".dz-live-new")!;
    let liveOpener: HTMLElement | null = null;
    let slow = 0;
    const warm = new Set<string>();
    const preconnect = (u: string) => {
      const o = new URL(u).origin;
      if (warm.has(o)) return;
      warm.add(o);
      const l = document.createElement("link");
      l.rel = "preconnect"; l.href = o;
      document.head.append(l);
    };
    document.querySelectorAll<HTMLButtonElement>("[data-live]").forEach((btn) => {
      const u = btn.dataset.live!;
      ["pointerenter", "focus"].forEach((ev) => btn.addEventListener(ev, () => preconnect(u), { once: true }));
      btn.addEventListener("click", () => {
        liveOpener = btn;
        ttl.textContent = btn.dataset.liveTitle ?? "";
        urlEl.textContent = new URL(u).hostname;
        newTab.href = u;
        stage.classList.remove("is-ready");
        const f = document.createElement("iframe");
        f.title = btn.dataset.liveTitle ?? "Live view";
        f.referrerPolicy = "no-referrer";
        f.setAttribute("sandbox", "allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox");
        if (btn.dataset.liveMic) f.allow = "microphone; clipboard-write";
        const load = stage.querySelector<HTMLElement>(".dz-live-load")!;
        load.textContent = "Loading the live view…";
        slow = window.setTimeout(() => { load.textContent = "Still loading. If nothing appears, open it in a new tab (top right)."; }, 8000);
        f.addEventListener("load", () => { window.clearTimeout(slow); stage.classList.add("is-ready"); });
        f.src = u;
        stage.append(f);
        root.classList.add("dz-lock");
        live.showModal();
      });
    });
    live.addEventListener("close", () => {
      window.clearTimeout(slow);
      stage.querySelector("iframe")?.remove(); // stops the page, the audio and the network
      root.classList.remove("dz-lock");
      liveOpener?.focus({ preventScroll: true });
    });
    live.querySelector(".dz-live-x")!.addEventListener("click", () => live.close());
    live.addEventListener("click", (e) => { if (e.target === live) live.close(); });
  }

  // Swipe on touch screens
  let sx = 0, sy = 0;
  dlg.addEventListener("pointerdown", (e) => { sx = e.clientX; sy = e.clientY; });
  dlg.addEventListener("pointerup", (e) => {
    if (e.pointerType === "mouse") return;
    const dx = e.clientX - sx, dy = e.clientY - sy;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(at + (dx < 0 ? 1 : -1));
  });
</script>
