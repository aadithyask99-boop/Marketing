---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import ClosingCta from "../../components/ClosingCta.astro";
import ArticleToc from "../../components/ArticleToc.astro";
import ShareRail from "../../components/ShareRail.astro";
import Faq from "../../components/Faq.astro";
import OfferShape from "../../components/OfferShape.astro";
import { Image, getImage } from "astro:assets";
import "../../styles/offerings.css";
import "../../styles/blog.css";
import "../../styles/casestudy.css";
import { BLOG_CATEGORIES, SITE, url } from "../../data/site";
import { breadcrumbs } from "../../lib/schema";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const cat = BLOG_CATEGORIES.find((c) => c.slug === d.category)!;
const related = posts.filter((p) => p.id !== post.id && p.data.category === d.category).slice(0, 3);
// Always show three: same-category first, then the newest of the rest.
const others = posts.filter((p) => p.id !== post.id && !related.includes(p)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const more = [...related, ...others].slice(0, 3);
const TONES = ["cream", "ink", "red"] as const;
const date = d.date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const initials = d.author.split(" ").map((w) => w[0]).join("").slice(0, 2);
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ask = encodeURIComponent(`Summarise this article and tell me the key takeaways: ${pageUrl}`);
const AI = [
  { name: "ChatGPT", href: `https://chatgpt.com/?q=${ask}` },
  { name: "Claude", href: `https://claude.ai/new?q=${ask}` },
  { name: "Perplexity", href: `https://www.perplexity.ai/search?q=${ask}` },
];
const o = Astro.site!.origin;
const postImage = d.image ? await getImage({ src: d.image, width: 1200 }) : null;
const postUrl = `${o}/blog/${post.id}`;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": `${postUrl}#article`,
    mainEntityOfPage: postUrl,
    headline: d.title,
    description: d.excerpt,
    datePublished: d.date.toISOString(),
    dateModified: d.date.toISOString(),
    image: d.image ? new URL(postImage!.src, o).href : `${o}/og.png`,
    author: { "@type": "Organization", name: SITE.name, "@id": `${o}/#organization` },
    publisher: { "@id": `${o}/#organization` },
    keywords: d.tags.join(", "),
  },
  d.faq.length > 0 && {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: d.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  breadcrumbs(o, [{ name: "Blog", path: "/blog" }, { name: d.title, path: `/blog/${post.id}` }]),
].filter(Boolean) as object[];
---

<BaseLayout title={d.title} description={d.excerpt} schema={schema} image={postImage?.src}>

  <header class:list={["a-head", "page-top", d.heroTone === "ink" && "a-head--ink"]}>
    <div class="a-info">
      <a class="article-back" href={url("/blog")}>&larr; All posts</a>
      <p class="a-date">{date} · {d.readMins} min read</p>
      <h1 class="display a-title">{d.title}</h1>
      <p class="a-by"><span class="post-avatar" aria-hidden="true">{initials}</span>By {d.author}</p>

      <div class="tldr">
        <p class="tldr-label"><span class="tldr-dot"></span>Short answer</p>
        <p class="tldr-text">{d.tldr}</p>
      </div>

      <div class="ask">
        <p class="ask-label">Ask AI to summarise</p>
        <ul class="ask-list" data-ask>
          {AI.map((a) => <li><a href={a.href} target="_blank" rel="noopener noreferrer">{a.name} <span aria-hidden="true">↗</span></a></li>)}
        </ul>
      </div>
    </div>

    <figure class="a-art">
      <div class:list={["a-tile", d.logo ? ["has-logo", d.logoFill && "is-fill"] : d.image && "has-photo"]}>
        {
          d.logo ? (
            <Image class="a-logo" src={d.logo} alt={d.logoAlt ?? ""} widths={d.logoFill ? [640, 960, 1400] : [320, 640, 960]} sizes={d.logoFill ? "(min-width: 900px) 50vw, 100vw" : "(min-width: 900px) 30vw, 60vw"} loading="eager" />
          ) : d.image ? (
            <Image class="a-photo" src={d.image} alt={d.imageAlt ?? ""} widths={[640, 960, 1400, 1800]} sizes="(min-width: 900px) 50vw, 100vw" loading="eager" />
          ) : (
            <OfferShape shape={cat.shape} class="a-shape" />
          )
        }
      </div>
    </figure>
  </header>

  <section class="a-body section--cream">
    <p class="a-credit">{cat.label} · Illustration by {SITE.name}</p>
    <div class="a-grid">
      <article class="prose"><Content /></article>
      <aside class="a-aside"><ArticleToc headings={headings} /><ShareRail title={d.title} /></aside>
    </div>
    <div class="a-wrap">
    <Faq items={d.faq} />
    <div class="a-foot">
      <p class="a-tags"><span>In this article:</span>{d.tags.map((t) => <a href={`${url("/blog")}?q=${encodeURIComponent(t)}`}>#{t}</a>)}</p>
      <p class="a-geo">Built to be quoted by AI. This page ships with <a href={`${url("/services")}#ai-search`}>the same structured data we set up for clients</a>.</p>
    </div>
    </div>
  </section>

  <section class="section section--cream related" aria-labelledby="related-title">
    <h2 id="related-title" class="display related-title">Keep reading</h2>
    <ul class="blog-grid blog-grid--related">
      {
        more.map((p, i) => (
          <BlogCard slug={p.id} title={p.data.title} excerpt={p.data.excerpt} category={p.data.category} author={p.data.author} readMins={p.data.readMins} tone={TONES[i % 3]} image={p.data.image} imageAlt={p.data.imageAlt} />
        ))
      }
    </ul>
  </section>

  <ClosingCta />
</BaseLayout>

<script>
  // Case study figures: bars, columns and dots animate in once as they scroll into view.
  const figs = document.querySelectorAll<HTMLElement>(".prose .fig");
  if (figs.length && "IntersectionObserver" in window) {
    document.documentElement.classList.add("js-fig");
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); } }),
      { threshold: 0.25 },
    );
    figs.forEach((f) => io.observe(f));
  }
</script>

<script>
  // Point the AI links at the live address (the build may not know the site URL).
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-ask] a");
  const q = encodeURIComponent(`Summarise this article and tell me the key takeaways: ${location.origin}${location.pathname}`);
  const map: Record<string, string> = {
    ChatGPT: `https://chatgpt.com/?q=${q}`,
    Claude: `https://claude.ai/new?q=${q}`,
    Perplexity: `https://www.perplexity.ai/search?q=${q}`,
  };
  links.forEach((a) => { const k = a.textContent!.replace(/\s*↗\s*$/, "").trim(); if (map[k]) a.href = map[k]; });
</script>

<script>
  // Case study screenshots: click to enlarge in a native dialog (Esc or the close button to leave).
  const shots = document.querySelectorAll<HTMLImageElement>(".prose .cs-frame img");
  if (shots.length && typeof HTMLDialogElement !== "undefined") {
    const dlg = document.createElement("dialog");
    dlg.className = "cs-lb";
    dlg.setAttribute("aria-label", "Enlarged screenshot");
    const close = document.createElement("button");
    close.type = "button";
    close.setAttribute("aria-label", "Close");
    close.textContent = "\u2715";
    const big = document.createElement("img");
    dlg.append(close, big);
    document.body.append(dlg);
    let from: HTMLElement | null = null;
    const open = (img: HTMLImageElement) => {
      from = img;
      big.src = img.currentSrc || img.src;
      big.alt = img.alt;
      dlg.showModal();
    };
    close.addEventListener("click", () => dlg.close());
    dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener("close", () => from?.focus());
    shots.forEach((img) => {
      img.tabIndex = 0;
      img.dataset.cursor = "Enlarge";
      img.setAttribute("role", "button");
      img.addEventListener("click", () => open(img));
      img.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); open(img); } });
    });
  }
</script>

<script>
  // Click-to-load embeds: nothing is requested from the third party until the visitor presses play.
  document.querySelectorAll<HTMLElement>(".prose .cs-embed[data-embed]").forEach((box) => {
    const stage = box.querySelector<HTMLElement>(".cs-embed-stage");
    const play = box.querySelector<HTMLButtonElement>(".cs-embed-play");
    const src = box.dataset.embed;
    if (!stage || !play || !src) return;
    play.addEventListener("click", () => {
      const frame = document.createElement("iframe");
      frame.src = src;
      frame.title = "Instagram reel";
      frame.loading = "lazy";
      frame.allowFullscreen = true;
      frame.allow = "encrypted-media; fullscreen; picture-in-picture";
      frame.referrerPolicy = "strict-origin-when-cross-origin";
      frame.setAttribute("sandbox", "allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-presentation");
      stage.replaceChildren(frame);
    });
  });
</script>

