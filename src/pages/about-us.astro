---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutStory from "../components/AboutStory.astro";
import AboutManifesto from "../components/AboutManifesto.astro";
import OfficeClocks from "../components/OfficeClocks.astro";
import Offices from "../components/Offices.astro";
import ValuesMarquee from "../components/ValuesMarquee.astro";
import Proof from "../components/Proof.astro";
import Voices from "../components/Voices.astro";
import ClosingCta from "../components/ClosingCta.astro";
import "../styles/offerings.css";
import "../styles/about.css";
import { ABOUT, url } from "../data/site";
import { webPage, breadcrumbs, serviceList } from "../lib/schema";
const o = Astro.site!.origin;
const schema = [
  webPage(o, "/about-us", "AboutPage", "About", "Maximus Mediascape is a marketing agency founded in 2021 at the University of Surrey, now with offices in the UK, UAE and India."),
  breadcrumbs(o, [{ name: "About", path: "/about-us" }]),
];
---

<BaseLayout schema={schema} title="About Our Marketing Agency" description="Maximus Mediascape is a marketing agency founded in 2021 at the University of Surrey, now with offices in the UK, UAE and India.">
  <section class="about-hero section page-top page-hero">
    <h1 class="display page-title">Maximus Mediascape</h1>
    <p class="lede">{ABOUT.lede}</p>
  </section>

  <AboutStory />
  <AboutManifesto />

  <ValuesMarquee />
  <Proof />
  <Voices />
  <OfficeClocks />
  <Offices />
  <section class="section section--cream about-more" aria-label="Explore more">
    <p>See what we do in <a href={url("/our-services")}>our services</a>, how we work and our <a href={url("/work")}>selected projects</a>, our <a href={url("/work/portfolio")}>portfolio</a>, the <a href={url("/our-services/starter-plan")}>Starter plan</a> or the <a href={url("/our-services/care-and-growth-plans")}>Care and Growth plans</a>.</p>
  </section>
  <ClosingCta />
</BaseLayout>
