---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="faq" id="faq" aria-labelledby="faq-title">
      <h2 id="faq-title" class="display faq-title">FAQ</h2>
      <div class="faq-list">
        {items.map((f) => (
          <details class="faq-item">
            <summary><span>{f.q}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
