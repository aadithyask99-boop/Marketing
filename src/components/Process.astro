---
import "../styles/process.css";
import OfferShape from "./OfferShape.astro";
import { PROCESS, url } from "../data/site";
---

<section class="process" data-process aria-labelledby="process-title">
  <h2 id="process-title" class="sr-only">Our process</h2>
  <svg class="process-path" aria-hidden="true" focusable="false">
    <defs>
      <mask id="process-mask" maskUnits="userSpaceOnUse">
        <path class="pp-reveal" fill="none" stroke="#fff" stroke-width="14" stroke-linecap="round"></path>
      </mask>
    </defs>
    <path class="pp-base" fill="none"></path>
    <path class="pp-red" fill="none" mask="url(#process-mask)"></path>
    <g class="pp-head"><path d="M-9 -8L11 0L-9 8L-4 0Z"></path></g>
  </svg>

  {
    PROCESS.map((ph, i) => (
      <div class:list={["phase", i % 2 === 1 && "phase--right"]} data-phase>
        <div class="phase-head">
          <span class="phase-num" data-badge>{i + 1}</span>
          <h3 class="phase-pill">{ph.title}</h3>
          <span class="phase-time">{ph.time}</span>
        </div>
        <ul class="phase-cards">
          {ph.steps.map((st) => (
            <li class="step" data-card>
              <div class="step-top">
                <h4 class="step-name">{st.name}</h4>
                <span class="step-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={st.icon} /></svg>
                </span>
              </div>
              <p class="step-text">{st.text}</p>
              <p class="step-get"><span>You get</span> {st.get}</p>
            </li>
          ))}
        </ul>
      </div>
    ))
  }

  <p class="process-note">* Timelines are a guide and can extend depending on your requirements.</p>

  <div class="process-cta">
    <OfferShape shape="spiral" class="cta-shape" />
    <div>
      <p class="cta-text">Whether you're just getting started, stuck or ready to scale, we can help.</p>
      <a class="cta-btn" href="#start" data-cursor="Go" data-to-form>Book a free consultation <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-process]");
  const svg = root?.querySelector<SVGSVGElement>(".process-path");
  const wide = window.matchMedia("(min-width: 900px)");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Mouse-only hover state; cleared as soon as the pointer leaves.
  if (root) {
    const phases = [...root.querySelectorAll<HTMLElement>(".phase")];
    const clear = () => { phases.forEach((p) => p.classList.remove("is-hover")); root.classList.remove("has-hover"); };
    phases.forEach((ph) => {
      ph.addEventListener("pointerenter", (e) => { if (e.pointerType !== "mouse") return; clear(); ph.classList.add("is-hover"); root.classList.add("has-hover"); });
      ph.addEventListener("pointerleave", clear);
      ph.addEventListener("pointercancel", clear);
    });
    root.addEventListener("pointerleave", clear);
    window.addEventListener("blur", clear);
    window.addEventListener("pagehide", clear);
  }

  // The CTA glides down to the lead form and focuses it.
  const cta = document.querySelector<HTMLAnchorElement>("[data-to-form]");
  cta?.addEventListener("click", (e) => {
    const form = document.getElementById("start");
    if (!form) return;
    e.preventDefault();
    form.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "center" });
    const input = document.getElementById("closer-msg");
    window.setTimeout(() => input?.focus({ preventScroll: true }), reduced ? 0 : 700);
    history.replaceState(null, "", "#start");
  });

  if (root && svg) {
    const base = svg.querySelector<SVGPathElement>(".pp-base")!;
    const red = svg.querySelector<SVGPathElement>(".pp-red")!;
    const reveal = svg.querySelector<SVGPathElement>(".pp-reveal")!;
    const head = svg.querySelector<SVGGElement>(".pp-head")!;
    const badges = [...root.querySelectorAll<HTMLElement>("[data-badge]")];
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    let len = 0;
    let stops: number[] = [];
    let ticking = false;

    const build = () => {
      const mobile = !wide.matches;
      const r = root.getBoundingClientRect();
      const rel = (el: Element) => {
        const b = el.getBoundingClientRect();
        return { x: b.left + b.width / 2 - r.left, y: b.top + b.height / 2 - r.top, top: b.top - r.top, bottom: b.bottom - r.top };
      };
      const pts: { x: number; y: number }[] = [];
      root.querySelectorAll<HTMLElement>("[data-phase]").forEach((ph, i) => {
        const badge = rel(ph.querySelector("[data-badge]")!);
        pts.push({ x: badge.x, y: badge.y });
        const cards = [...ph.querySelectorAll("[data-card]")].map(rel);
        const top = Math.min(...cards.map((c) => c.top));
        const bottom = Math.max(...cards.map((c) => c.bottom));
        pts.push(mobile ? { x: badge.x + (i % 2 ? -7 : 7), y: (top + bottom) / 2 } : { x: r.width / 2 + (i % 2 ? -1 : 1) * r.width * 0.02, y: (top + bottom) / 2 });
      });
      const end = rel(root.querySelector(".process-cta")!);
      pts.push({ x: mobile ? pts[0].x : r.width / 2, y: end.top - 24 });

      let d = `M${pts[0].x} ${pts[0].y}`;
      for (let i = 1; i < pts.length; i++) {
        const p = pts[i - 1], q = pts[i], m = p.y + (q.y - p.y) / 2;
        d += ` C${p.x} ${m} ${q.x} ${m} ${q.x} ${q.y}`;
      }
      svg.setAttribute("viewBox", `0 0 ${r.width} ${r.height}`);
      svg.setAttribute("width", String(r.width));
      svg.setAttribute("height", String(r.height));
      [base, red, reveal].forEach((p) => p.setAttribute("d", d));
      len = reveal.getTotalLength();
      reveal.style.strokeDasharray = `${len}`;
      stops = badges.map((b) => {
        const by = rel(b).y;
        let lo = 0, hi = len;
        for (let k = 0; k < 24; k++) { const mid = (lo + hi) / 2; reveal.getPointAtLength(mid).y < by ? (lo = mid) : (hi = mid); }
        return lo;
      });
      root.classList.add("is-enhanced");
      update();
    };

    const update = () => {
      ticking = false;
      if (!len) return;
      const r = root.getBoundingClientRect();
      const p = reduced ? 1 : clamp((window.innerHeight * 0.85 - r.top) / (r.height * 0.8));
      const at = p * len;
      reveal.style.strokeDashoffset = String(len - at);
      const a = reveal.getPointAtLength(at);
      const b = reveal.getPointAtLength(Math.max(0, at - 2));
      const ang = (Math.atan2(a.y - b.y, a.x - b.x) * 180) / Math.PI;
      head.setAttribute("transform", `translate(${a.x} ${a.y}) rotate(${ang})`);
      head.style.opacity = p > 0.005 && p < 0.995 ? "1" : "0";
      badges.forEach((el, i) => el.classList.toggle("is-on", at >= stops[i] - 4));
    };

    const onScroll = () => { if (!ticking && !reduced) { ticking = true; requestAnimationFrame(update); } };
    const start = () => {
      build();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", build);
      new ResizeObserver(build).observe(root);
    };
    if (document.fonts?.ready) document.fonts.ready.then(start); else start();
  }
</script>
