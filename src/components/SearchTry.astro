---
import "../styles/search.css";
import { CHIPS } from "../data/search";
import { SITE, url } from "../data/site";
---

<section class="try" id="try" data-contact={url("/contact")} data-site={SITE.name} aria-labelledby="try-title">
  <p class="eyebrow">Try it</p>
  <h2 id="try-title" class="display section-title">Your turn.</h2>
  <p class="lede">
    Type what your customers would type. We'll show you what being the answer looks like.
  </p>

  <form class="try-form" role="search" novalidate>
    <label class="sr-only" for="try-q">What would your customers search for?</label>
    <input
      id="try-q"
      name="q"
      type="text"
      maxlength="120"
      autocomplete="off"
      placeholder="e.g. marketing agency for my bakery"
    />
    <button class="btn" type="submit" data-cursor="Search">Search</button>
  </form>

  <ul class="try-chips" aria-label="Suggestions">
    {CHIPS.map((c) => <li><button type="button" data-chip>{c}</button></li>)}
  </ul>

  <div class="try-result" aria-live="polite" aria-busy="false"></div>
</section>

<script>
  import { match } from "../data/search";

  const root = document.querySelector<HTMLElement>(".try");
  const form = root?.querySelector<HTMLFormElement>(".try-form");
  const input = root?.querySelector<HTMLInputElement>("#try-q");
  const out = root?.querySelector<HTMLElement>(".try-result");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
    const node = document.createElement(tag);
    if (cls) node.className = cls;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  let timer = 0;

  function render(query: string) {
    if (!root || !out) return;
    const rule = match(query);
    const site = root.dataset.site ?? "";
    const params = new URLSearchParams({ q: query, service: rule.option });
    const contact = `${root.dataset.contact}?${params.toString()}`;

    const card = el("article", "result-card");
    card.append(el("p", "result-meta", "1 answer in 0.4 seconds"));
    card.append(el("p", "result-query", `You searched: “${query}”`));
    card.append(el("p", "result-url", `${site.toLowerCase().replace(/\s+/g, "")} › ${rule.label.toLowerCase()}`));
    card.append(el("h3", "result-title display", `${site}: ${rule.headline}`));
    card.append(el("p", "result-body", rule.body));
    card.append(el("p", "result-query", "Where we'd start:"));
    const steps = el("ol", "result-steps");
    rule.steps.forEach((s) => steps.append(el("li", undefined, s)));
    card.append(steps);

    const actions = el("div", "result-actions");
    const go = el("a", "btn", "Start with this");
    go.href = contact;
    go.dataset.cursor = "Go";
    const again = el("button", "btn btn--ghost", "Try another");
    again.type = "button";
    again.addEventListener("click", () => {
      out.replaceChildren();
      if (input) {
        input.value = "";
        input.focus();
      }
    });
    actions.append(go, again);
    card.append(actions);

    out.replaceChildren(card);
    out.setAttribute("aria-busy", "false");
  }

  function search(raw: string) {
    if (!out || !input) return;
    const query = raw.replace(/\s+/g, " ").trim().slice(0, 120);
    window.clearTimeout(timer);

    if (!query) {
      out.replaceChildren(el("p", "result-msg", "Type something first, or tap a suggestion."));
      input.focus();
      return;
    }

    input.value = query;
    out.setAttribute("aria-busy", "true");
    if (reduced) return render(query);

    const skeleton = el("div", "result-skeleton");
    skeleton.append(el("span"), el("span"), el("span"));
    out.replaceChildren(skeleton);
    timer = window.setTimeout(() => render(query), 600);
  }

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    search(input?.value ?? "");
  });

  root?.querySelectorAll<HTMLButtonElement>("[data-chip]").forEach((btn) => {
    btn.addEventListener("click", () => search(btn.textContent ?? ""));
  });
</script>
