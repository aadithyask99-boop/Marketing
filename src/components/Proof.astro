---
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "../styles/story.css";
import "../styles/proof.css";
import Sticker from "./Sticker.astro";
import { CLIENTS, TESTIMONIALS } from "../data/site";

const TONES = ["cream", "ink", "lilac", "cream", "pink", "mint", "ink", "yellow"];
const tiles = CLIENTS.map((name, i) => ({ name, tone: TONES[(i * 3 + Math.floor(i / 2)) % TONES.length] }));
const colA = tiles.filter((_, i) => i % 2 === 0);
const colB = tiles.filter((_, i) => i % 2 === 1);
---

<section class="proof" aria-labelledby="proof-title">
  <div class="proof-top">
    <div class="proof-copy">
      <h2 id="proof-title" class="display proof-heading">
        Clients across our{" "}<span class="finale-accent proof-accent">
          portfolio
          <svg class="finale-underline" viewBox="0 0 400 24" aria-hidden="true">
            <path pathLength="1" d="M4 16C60 6 110 4 160 12S250 20 300 10 370 6 396 12"></path>
          </svg>
        </span>
      </h2>
      <div class="proof-deco" aria-hidden="true">
        <Sticker name="heart" class="proof-heart" />
        <svg class="proof-arrow" viewBox="0 0 220 100" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 66C50 76 98 62 92 34C86 6 46 14 54 46C62 80 140 84 204 42"></path>
          <path d="M182 30L206 42L190 64"></path>
        </svg>
      </div>
    </div>

    <div class="proof-stage">
      <div class="proof-window" aria-hidden="true">
        {
          [
            { list: colA, dir: "down" },
            { list: colB, dir: "up" },
          ].map((col) => (
            <div class={`proof-col proof-col--${col.dir}`}>
              <div class="proof-track">
                <div class="proof-list">
                  {col.list.map((t) => <div class={`tile tile--${t.tone}`}><span>{t.name}</span></div>)}
                </div>
                <div class="proof-list proof-list--dup">
                  {col.list.map((t) => <div class={`tile tile--${t.tone}`}><span>{t.name}</span></div>)}
                </div>
              </div>
            </div>
          ))
        }
      </div>
      <div class="proof-veil proof-veil--top" aria-hidden="true"></div>
      <div class="proof-veil proof-veil--bottom" aria-hidden="true"></div>
    </div>
    <ul class="sr-only" aria-label="Clients">
      {CLIENTS.map((c) => <li>{c}</li>)}
    </ul>
  </div>

  <div class="voices" role="region" aria-roledescription="carousel" aria-label="Client testimonials">
    <ul class="voices-track" tabindex="0" aria-label="Testimonials, scroll sideways">
      {
        TESTIMONIALS.map((t, i) => (
          <li class="voice" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${TESTIMONIALS.length}`}>
            <span class="voice-mark" aria-hidden="true">&ldquo;</span>
            <blockquote class="voice-quote">{t.quote}</blockquote>
            <p class="voice-by"><strong>{t.role}</strong><span>{t.company}</span></p>
          </li>
        ))
      }
    </ul>
    <div class="voices-nav">
      <button class="voices-btn" type="button" data-dir="-1" aria-label="Previous testimonial">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
      </button>
      <div class="voices-dots">
        {TESTIMONIALS.map((_, i) => <button type="button" class="voices-dot" data-index={i} aria-label={`Go to testimonial ${i + 1}`}><span></span></button>)}
      </div>
      <button class="voices-btn" type="button" data-dir="1" aria-label="Next testimonial">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>
  </div>
</section>

<script>
  const region = document.querySelector<HTMLElement>(".voices");
  const track = region?.querySelector<HTMLElement>(".voices-track");
  if (region && track) {
    const slides = [...track.children] as HTMLElement[];
    const dots = [...region.querySelectorAll<HTMLButtonElement>(".voices-dot")];
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const DELAY = 3000;
    let index = 0;
    let hovering = false;
    let focused = false;
    let visible = false;
    let lastTouch = 0;

    const width = () => track.clientWidth;
    const current = () => Math.min(slides.length - 1, Math.max(0, Math.round(track.scrollLeft / (width() || 1))));
    const paint = () => {
      index = current();
      dots.forEach((d, i) => {
        d.setAttribute("aria-current", String(i === index));
        d.classList.toggle("is-on", i === index);
      });
    };
    const go = (i: number) => {
      const n = (i + slides.length) % slides.length;
      track.scrollTo({ left: n * width(), behavior: reduced ? "auto" : "smooth" });
    };

    track.addEventListener("scroll", () => requestAnimationFrame(paint), { passive: true });
    region.querySelectorAll<HTMLButtonElement>(".voices-btn").forEach((b) =>
      b.addEventListener("click", () => {
        lastTouch = performance.now();
        go(index + Number(b.dataset.dir));
      }),
    );
    dots.forEach((d) =>
      d.addEventListener("click", () => {
        lastTouch = performance.now();
        go(Number(d.dataset.index));
      }),
    );
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); go(index + 1); }
      if (e.key === "ArrowLeft") { e.preventDefault(); go(index - 1); }
    });

    region.addEventListener("mouseenter", () => (hovering = true));
    region.addEventListener("mouseleave", () => { hovering = false; lastTouch = performance.now(); });
    region.addEventListener("focusin", () => (focused = true));
    region.addEventListener("focusout", () => { focused = false; lastTouch = performance.now(); });
    ["touchstart", "pointerdown", "wheel"].forEach((ev) =>
      track.addEventListener(ev, () => (lastTouch = performance.now()), { passive: true }),
    );
    new IntersectionObserver((es) => (visible = es.some((e) => e.isIntersecting)), { threshold: 0.4 }).observe(region);
    new ResizeObserver(() => track.scrollTo({ left: index * width(), behavior: "auto" })).observe(track);

    paint();
    if (!reduced) {
      region.setAttribute("aria-live", "off");
      setInterval(() => {
        if (document.hidden || !visible || hovering || focused) return;
        if (performance.now() - lastTouch < DELAY) return;
        go(index + 1);
      }, DELAY);
    }
  }
</script>
