---
import "../styles/proof.css";
import { siOpenai, siMicrosoft } from "simple-icons-old";
import { siShell, siApple, siPanasonic, siSiemens, siSony, siWorldhealthorganization } from "simple-icons";
import { CLIENTS } from "../data/site";

// Real brand marks where the open icon set has them; other clients fall back to a text wordmark.
// `box` crops each icon to its artwork; `h` is the rendered height in rem (wordmarks are wide and short).
const LOGOS: Record<string, { d: string; box: string; h: number }> = {
  Panasonic: { d: siPanasonic.path, box: "0 10.16 24 3.68", h: 1.1 },
  Siemens: { d: siSiemens.path, box: "0 10.02 24 3.97", h: 1.2 },
  WHO: { d: siWorldhealthorganization.path, box: "0 1.41 24 21.18", h: 2.4 },
  Apple: { d: siApple.path, box: "2.22 0 19.55 24", h: 2.4 },
  "Shell Orbit": { d: siShell.path, box: "0 0 24 24", h: 2.2 },
  OpenAI: { d: siOpenai.path, box: "0 0 24 24", h: 2.2 },
  Microsoft: { d: siMicrosoft.path, box: "0 0 24 24", h: 2.2 },
  Sony: { d: siSony.path, box: "0 9.89 24 4.22", h: 1.3 },
};
---

<section class="proof" aria-labelledby="proof-title">
  <h2 id="proof-title" class="proof-label">Clients across our portfolio</h2>
  <div class="proof-strip" aria-hidden="true">
    <div class="proof-track">
      {
        [0, 1].map(() => (
          <ul class="proof-list">
            {CLIENTS.map((name) => (
              <li class="proof-item">
                {LOGOS[name] ? (
                  <svg class="proof-logo" viewBox={LOGOS[name].box} style={`height:${LOGOS[name].h}rem`} fill="currentColor"><path d={LOGOS[name].d} /></svg>
                ) : (
                  <span class="proof-word">{name}</span>
                )}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
    <div class="proof-veil proof-veil--left"></div>
    <div class="proof-veil proof-veil--right"></div>
  </div>
  <ul class="sr-only" aria-label="Clients">
    {CLIENTS.map((c) => <li>{c}</li>)}
  </ul>
</section>
