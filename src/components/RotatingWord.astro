---
interface Props {
  words: string[];
  interval?: number;
}

const { words, interval = 3000 } = Astro.props;
---

<span
  class="rotator"
  aria-hidden="true"
  data-words={JSON.stringify(words)}
  data-interval={interval}
>
  <span class="rotator-word">{words[0]}</span>
</span>

<script>
  const FADE_MS = 350;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>(".rotator").forEach((root) => {
    const words: string[] = JSON.parse(root.dataset.words ?? "[]");
    const interval = Number(root.dataset.interval) || 3000;
    const el = root.querySelector<HTMLElement>(".rotator-word");
    if (!el || words.length < 2) return;

    let i = 0;
    let busy = false;

    const change = async () => {
      if (document.hidden || busy) return;
      busy = true;
      i = (i + 1) % words.length;

      if (reduced) {
        el.textContent = words[i];
        busy = false;
        return;
      }

      const out = el.animate(
        [
          { opacity: 1, transform: "translateY(0)" },
          { opacity: 0, transform: "translateY(-0.06em)" },
        ],
        { duration: FADE_MS, easing: "ease-in", fill: "forwards" },
      );
      await out.finished;

      el.textContent = words[i];
      const inn = el.animate(
        [
          { opacity: 0, transform: "translateY(0.06em)" },
          { opacity: 1, transform: "translateY(0)" },
        ],
        { duration: FADE_MS, easing: "ease-out" },
      );
      out.cancel();
      await inn.finished;
      busy = false;
    };

    setInterval(change, interval);
  });
</script>
