---
import "../styles/footer.css";
import { NAV, SITE, SERVICES, SOCIALS, url } from "../data/site";

const { tone = "ink" } = Astro.props;
const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT ?? "";
const pages = NAV.filter((n) => n.href !== "/");
const FOOTER_SERVICES = ["ai-search", "website-design", "ai-automation", "advertising", "seo-content", "brand-identity"]
  .map((slug) => SERVICES.find((s) => s.slug === slug)!);
const ICONS: Record<string, string> = {
  LinkedIn:
    '<path fill="currentColor" stroke="none" d="M4 9h4v12H4zM6 3.2a2.3 2.3 0 1 1 0 4.6 2.3 2.3 0 0 1 0-4.6zM10 9h3.8v1.7c.7-1.2 2-2 3.8-2 3.2 0 4.4 2 4.4 5.3V21h-4v-6c0-1.500-.5-2.500-1.9-2.5-1.5 0-2.1 1-2.1 2.6V21h-4z"/>',
  Instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/>',
  Medium: '<circle cx="8" cy="12" r="5" fill="currentColor" stroke="none"/><ellipse cx="17" cy="12" rx="2.200" ry="4.600" fill="currentColor" stroke="none"/><rect x="21" y="7.500" width="1.400" height="9" rx=".7" fill="currentColor" stroke="none"/>',
  X: '<path d="M4 4l16 16M20 4L4 20"/>',
  TikTok: '<path d="M14 4v10.5a3.500 3.500 0 1 1-3.500-3.500M14 4c.5 2.500 2 4 5 4.200"/>',
  YouTube:
    '<rect x="2.500" y="5.500" width="19" height="13" rx="4"/><path d="M10 9.500v5l4.500-2.500z" fill="currentColor" stroke="none"/>',
  Facebook:
    '<path fill="currentColor" stroke="none" d="M14 21v-8h3l.5-3.500H14V7.500c0-1 .4-1.500 1.600-1.500H18V3c-.5 0-1.600-.2-2.800-.2C12.700 2.800 11 4.300 11 7v2.500H8V13h3v8z"/>',
};
---

<footer class:list={["site-footer", tone === "red" && "site-footer--red"]}>
  <div class="footer-card" data-endpoint={endpoint} data-email={SITE.email}>
    <div class="footer-top">
      <div class="footer-news">
        <h2 class="footer-news-title">Stay updated with {SITE.name.split(" ")[0]} news</h2>
        <form class="footer-form" novalidate>
          <label class="sr-only" for="news-email">Email address</label>
          <input id="news-email" name="email" type="email" maxlength="254" autocomplete="email" placeholder="Your email address" />
          <button class="footer-go" type="submit" aria-label="Subscribe" data-cursor="Join">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>
          </button>
          <div class="lead-trap" aria-hidden="true"><input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></div>
        </form>
        <p class="footer-msg" role="status" aria-live="polite"></p>
        <ul class="footer-social">
          {
            SOCIALS.map((s) => (
              <li>
                <a href={s.href} aria-label={s.name} {...(s.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[s.name]} />
                  <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-cols">
        <nav class="footer-col" aria-label="Footer">
          <ul>
            <li><a href={url("/")}>Home</a></li>
            {pages.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
          </ul>
        </nav>
        <div class="footer-col">
          <ul aria-label="Services">
            {FOOTER_SERVICES.map((s) => <li><a href={url(`/services#${s.slug}`)}>{s.short}</a></li>)}
          </ul>
        </div>
        <div class="footer-col">
          <ul aria-label="Contact">
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li><a href={url("/contact")}>Start a project</a></li>
            <li><a href={url("/services")}>All services</a></li>
          </ul>
        </div>
      </div>
    </div>

    <p class="footer-wordmark display" aria-hidden="true" data-xray>{SITE.name}</p>

    <div class="footer-legal">
      <p>&copy; {new Date().getFullYear()} {SITE.name}. Registered in England and Wales, company no. {SITE.companyNumber}. All rights reserved.</p>
      <ul>
        <li><a href={url("/privacy")}>Privacy Policy</a></li>
        <li><a href={url("/terms")}>Terms &amp; conditions</a></li>
      </ul>
    </div>
  </div>
</footer>

<script>
  import { submitLead } from "../scripts/submitLead";

  const card = document.querySelector<HTMLElement>(".footer-card");
  const form = card?.querySelector<HTMLFormElement>(".footer-form");
  const msg = card?.querySelector<HTMLElement>(".footer-msg");
  if (card && form && msg) {
    const email = form.elements.namedItem("email") as HTMLInputElement;
    const trap = form.elements.namedItem("_gotcha") as HTMLInputElement;
    const say = (text: string, state: "ok" | "error") => {
      msg.textContent = text;
      msg.dataset.state = state;
    };
    form.addEventListener("input", () => (msg.textContent = ""));
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const value = email.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value)) {
        email.setAttribute("aria-invalid", "true");
        say("Please enter a valid email address.", "error");
        return email.focus();
      }
      email.removeAttribute("aria-invalid");
      if (trap.value) return say("Thanks, you're on the list.", "ok");
      const result = await submitLead(
        { message: "Newsletter signup", email: value },
        { endpoint: card.dataset.endpoint ?? "", toEmail: card.dataset.email ?? "" },
      );
      if (!result.ok) return say("Something went wrong. Please try again.", "error");
      say(result.mode === "mailto" ? "Your email app should open to confirm your signup." : "Thanks, you're on the list.", "ok");
      if (result.mode === "endpoint") form.reset();
    });
  }
</script>

<script>
  import { initXray } from "../scripts/xray";
  initXray(document.querySelector(".footer-wordmark"), 9);
</script>
