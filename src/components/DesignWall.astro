---
import { Image, getImage } from "astro:assets";
import DesignRail from "./DesignRail.astro";
import { DESIGN_WALL, WALL_KINDS, type WallKind } from "../data/design";

// PLACEHOLDER: first-draft copy. Websites and Instagram grids are shown by type and sector, not under a client.
const tiles = await Promise.all(
  DESIGN_WALL.map(async (t) => ({
    ...t,
    full: (await getImage({ src: t.src, width: 1600, format: "webp" })).src,
    thumb: (await getImage({ src: t.src, width: 160, height: 160, fit: "cover", position: "top", format: "webp" })).src,
    ratio: t.src.width / t.src.height,
    label: `${WALL_KINDS[t.kind]} · ${t.sector}`,
  })),
);
const kinds: WallKind[] = ["web", "app", "social"];
const groups = kinds.map((k) => ({
  label: "", // one flat list, like the Brand identity rail; the kind shows as the small tag under each name
  items: tiles.filter((t) => t.kind === k).map((t) => ({ slug: t.id, name: t.sector, small: WALL_KINDS[t.kind], thumb: t.thumb })),
}));
const ordered = kinds.flatMap((k) => tiles.filter((t) => t.kind === k));
---

<section class="dz-body dz-body--wall" id="more-work" aria-labelledby="wall-title" data-dz-wall>
  <header class="dz-wallhead">
    <h2 id="wall-title" class="display dz-h2">Websites, apps and <span class="dz-accent">Instagram grids</span></h2>
    <p class="dz-wall-lede">Web design, software and Instagram grid design for small businesses, shown the way people meet it: on a screen and in a feed. Not sorted by client, just a look at what we have made. Some of it you can try live.</p>
  </header>

  <div class="dz-layout" data-dz-layout>
    <DesignRail groups={groups} title="Digital & social" noun="projects" label="Websites, apps and Instagram grids on this page" contact={false} class="dz-rail--wall" />

    <ul class="dz-wt-grid">
      {
        ordered.map((t, i) => (
          <>
            {i > 0 && t.kind !== ordered[i - 1].kind && <li class="dz-wt-gap" aria-hidden="true"></li>}
            <li id={t.id} class={`dz-wt dz-wt--${t.kind === "social" ? "social" : "web"} ${i === 0 || t.kind !== ordered[i - 1].kind ? "is-first" : ""}`} data-spy-target data-kind={t.kind} data-depth={t.depth} data-side={t.side} style={`--rot:${t.rot}deg;--top:${t.top}rem`}>
                <button class="dz-wt-open" type="button" data-full={t.full} data-alt={t.alt} data-caption={t.label} data-tall={t.ratio < 0.5 ? "1" : undefined} data-cursor="View" aria-label={`View larger: ${t.label}`}>
                  <span class={`dz-wt-frame ${t.kind === "social" ? "is-profile" : ""}`}>
                    {t.kind !== "social" && <span class="dz-wt-bar" aria-hidden="true"><i></i><i></i><i></i></span>}
                    <Image src={t.src} alt={t.alt} widths={[400, 700, 1000]} sizes="(min-width: 900px) 30vw, 70vw" loading="lazy" decoding="async" />
                  </span>
                  <span class="dz-wt-cap">{t.label}</span>
                </button>
                {t.live && (
                  <button class="dz-wt-pill" type="button" data-live={t.live.url} data-live-title={t.live.title} data-live-mic={t.live.mic ? "1" : undefined} data-cursor="Open">
                    <i aria-hidden="true"></i>Try it live
                  </button>
                )}
                {t.href && (
                  <a class="dz-wt-pill" href={t.href} target="_blank" rel="noopener noreferrer" data-cursor="Visit">
                    Visit site <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
                  </a>
                )}
              </li>
          </>
        ))
      }
    </ul>
  </div>
</section>
