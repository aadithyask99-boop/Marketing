---
import "../styles/process.css";
import { Image } from "astro:assets";
import { url } from "../data/site";
import bakwa from "../assets/blog/logo-bakwa.png";
import luna from "../assets/design/wall/app-luna.webp";
import bakwaGrid from "../assets/design/wall/ig-bakwa.webp";

// Real projects: a case study, an AI chat and an Instagram grid. "reported" figures come from the client.
const items = [
  { tone: "ink", client: "Bakwa", img: bakwa, alt: "Bakwa logo on a green tile: It's not water. It's a movement.", tags: ["Website", "Social", "PR"], line: "A one-page website and zero ad spend.", metric: "3,000+", metricLabel: "enquiries in 3 months", reported: true, href: "/blogs/bakwa-brand-from-scratch" },
  { tone: "cream", client: "Luna", img: luna, alt: "Luna, an AI wellness companion chatbot with a friendly flame mascot and suggested topics", tags: ["AI chatbot", "Wellness"], line: "An AI wellness companion that answers visitors around the clock.", metric: "", metricLabel: "", reported: false, href: "/work/portfolio#app-luna" },
  { tone: "red", client: "Bakwa Instagram", img: bakwaGrid, alt: "Complete Instagram profile and grid design for a sustainable packaging brand", tags: ["Social", "Sustainable packaging"], line: "A complete Instagram profile and grid.", metric: "", metricLabel: "", reported: false, pos: "top", href: "/work/portfolio#ig-bakwa" },
];
---


<section class="featured" aria-labelledby="featured-title">
  <h2 id="featured-title" class="display featured-title">Featured work</h2>
  <a class="featured-more" href={url("/work/portfolio")} data-cursor="View">See our portfolio <span aria-hidden="true">↗</span></a>
  <ul class="featured-grid">
    {
      items.map((w) => (
        <li class={`fw fw--${w.tone} fw--photo${w.pos ? " fw--top" : ""}`}>
          <a class="fw-link" href={url(w.href)} data-cursor="View">
            <Image class="fw-img" style={w.pos ? `object-position: 50% ${w.pos === "top" ? "0%" : w.pos}` : undefined} src={w.img} alt={w.alt} widths={[480, 720, 960]} sizes="(min-width: 900px) 25vw, 100vw" loading="lazy" />
            <span class="fw-arrow" aria-hidden="true">↗</span>
            {w.metric && <span class="fw-metric">{w.metric}<small>{w.metricLabel}{w.reported ? "*" : ""}</small></span>}
            <span class="fw-pill">{w.client}</span>
            <span class="fw-line">{w.line}</span>
            <span class="fw-tag">{w.tags.join(" · ")}</span>
          </a>
        </li>
      ))
    }
    <li class="fw fw--secret">
      <a class="fw-link" href={url("/contact-us")} data-cursor="Ask">
        <svg class="fw-spark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1l2.6 8.4L23 12l-8.4 2.6L12 23l-2.6-8.4L1 12l8.4-2.6z"></path></svg>
        <span class="fw-secret">Shhh! There's more, but it's a secret.</span>
        <span class="fw-ask">Ask us <span aria-hidden="true">↗</span></span>
      </a>
    </li>
  </ul>
</section>

<script>
  // Same mouse-only proximity hover as the process badges: only the nearest project pill reacts.
  const pills = [...document.querySelectorAll<HTMLElement>(".fw-pill")];
  if (pills.length && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    const NEAR = 56;
    let active: HTMLElement | null = null;
    let queued = false;
    let pt = { x: 0, y: 0 };
    const set = (next: HTMLElement | null) => {
      if (next === active) return;
      active?.classList.remove("is-hover");
      next?.classList.add("is-hover");
      active = next;
    };
    const pick = () => {
      queued = false;
      let best: HTMLElement | null = null;
      let bestD = NEAR;
      for (const el of pills) {
        const r = el.getBoundingClientRect();
        const d = Math.hypot(Math.max(r.left - pt.x, 0, pt.x - r.right), Math.max(r.top - pt.y, 0, pt.y - r.bottom));
        if (d < bestD || (d === 0 && best === null)) { best = el; bestD = d; }
      }
      set(best);
    };
    const grid = document.querySelector<HTMLElement>(".featured-grid")!;
    grid.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      pt = { x: e.clientX, y: e.clientY };
      if (!queued) { queued = true; requestAnimationFrame(pick); }
    });
    const clear = () => set(null);
    grid.addEventListener("pointerleave", clear);
    window.addEventListener("blur", clear);
    window.addEventListener("pagehide", clear);
    document.addEventListener("scroll", () => { if (active && !queued) { queued = true; requestAnimationFrame(pick); } }, { passive: true });
  }
</script>
