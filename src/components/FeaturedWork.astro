---
import OfferShape from "./OfferShape.astro";
import { WORK, url } from "../data/site";
const SHAPES = ["rings", "spiral", "grid"] as const;
const TONES = ["ink", "cream", "red"] as const;
const items = WORK.slice(0, 3);
---

<section class="featured" aria-labelledby="featured-title">
  <svg class="featured-spark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1l2.6 8.4L23 12l-8.4 2.6L12 23l-2.6-8.4L1 12l8.4-2.6z"></path></svg>
  <h2 id="featured-title" class="display featured-title">Featured work</h2>
  <p class="featured-note">Placeholder projects. Replace with real case studies.</p>
  <a class="featured-more" href={url("/work/design")} data-cursor="View">See our design work <span aria-hidden="true">↗</span></a>
  <ul class="featured-grid">
    {
      items.map((w, i) => (
        <li class={`fw fw--${TONES[i]}`}>
          <a class="fw-link" href={`${url("/contact")}?service=${encodeURIComponent(w.category)}`} data-cursor="View">
            <OfferShape shape={SHAPES[i]} class="fw-shape" />
            <span class="fw-pill">{w.title}</span>
            <span class="fw-arrow" aria-hidden="true">↗</span>
            <span class="fw-tag">{w.category}</span>
          </a>
        </li>
      ))
    }
    <li class="fw fw--secret">
      <a class="fw-link" href={url("/contact")} data-cursor="Ask">
        <svg class="fw-spark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1l2.6 8.4L23 12l-8.4 2.6L12 23l-2.6-8.4L1 12l8.4-2.6z"></path></svg>
        <span class="fw-secret">Shhh! There's more, but it's a secret.</span>
        <span class="fw-ask">Ask us <span aria-hidden="true">↗</span></span>
      </a>
    </li>
  </ul>
</section>

<script>
  // Same mouse-only proximity hover as the process badges: only the nearest project pill reacts.
  const pills = [...document.querySelectorAll<HTMLElement>(".fw-pill")];
  if (pills.length && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    const NEAR = 56;
    let active: HTMLElement | null = null;
    let queued = false;
    let pt = { x: 0, y: 0 };
    const set = (next: HTMLElement | null) => {
      if (next === active) return;
      active?.classList.remove("is-hover");
      next?.classList.add("is-hover");
      active = next;
    };
    const pick = () => {
      queued = false;
      let best: HTMLElement | null = null;
      let bestD = NEAR;
      for (const el of pills) {
        const r = el.getBoundingClientRect();
        const d = Math.hypot(Math.max(r.left - pt.x, 0, pt.x - r.right), Math.max(r.top - pt.y, 0, pt.y - r.bottom));
        if (d < bestD || (d === 0 && best === null)) { best = el; bestD = d; }
      }
      set(best);
    };
    const grid = document.querySelector<HTMLElement>(".featured-grid")!;
    grid.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      pt = { x: e.clientX, y: e.clientY };
      if (!queued) { queued = true; requestAnimationFrame(pick); }
    });
    const clear = () => set(null);
    grid.addEventListener("pointerleave", clear);
    window.addEventListener("blur", clear);
    window.addEventListener("pagehide", clear);
    document.addEventListener("scroll", () => { if (active && !queued) { queued = true; requestAnimationFrame(pick); } }, { passive: true });
  }
</script>
