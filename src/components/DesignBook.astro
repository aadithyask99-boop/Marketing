---
import { Image } from "astro:assets";
import DesignBookPage from "./DesignBookPage.astro";
import { BOOK } from "../data/design";

// A simulated brand book: drag the cover or a page edge to turn it. Pure CSS 3D plus pointer events.
// Leaf 0 is the cover; leaf i shows the right page of spread i on its front and the left page of spread i+1 on its back.
// The last leaf is a static base page. Image spreads are re-composed brand-book slides; contents and cta spreads are live HTML.
const spreads = BOOK.spreads;
const N = spreads.length;
const leaves = Array.from({ length: N + 1 }, (_, i) => i);
const titles = JSON.stringify(spreads.map((s) => s.title));
const page = { name: BOOK.name, contents: BOOK.contents, cta: BOOK.cta };
---

<div class="dz-book-wrap" data-book data-count={N} data-titles={titles} data-name={`${BOOK.name} brand book`}>
  <div class="dz-book-turn">
  <div class="dz-book" role="group" aria-roledescription="book" aria-label={`Interactive ${BOOK.name} brand book. Drag a page to turn it, or use the buttons.`} tabindex="0" data-cursor="Drag">
    <span class="dz-book-shadow" aria-hidden="true"></span>
    <div class="dz-book-in">
      <span class="dz-stack dz-stack--l" aria-hidden="true"></span>
      <span class="dz-stack dz-stack--r" aria-hidden="true"></span>
      {
        leaves.map((i) => (
          <div class="dz-leaf" data-leaf={i}>
            <div class="dz-face dz-front">
              {
                i === 0 ? (
                  <div class="dz-cover">
                    <span class="dz-cover-spine" aria-hidden="true"></span>
                    <span class="dz-cover-kicker">{BOOK.kicker}</span>
                    <Image src={BOOK.logo} alt={BOOK.logoAlt} widths={[320, 480]} sizes="(min-width: 900px) 20vw, 40vw" class="dz-cover-logo" loading="eager" decoding="async" />
                    <span class="dz-cover-place">{BOOK.place}</span>
                  </div>
                ) : (
                  <DesignBookPage spread={spreads[i - 1]} side="right" s={i} {...page} />
                )
              }
              <span class="dz-shade dz-shade--f" aria-hidden="true"></span>
            </div>
            {
              i < N && (
                <div class="dz-face dz-back">
                  <DesignBookPage spread={spreads[i]} side="left" s={i + 1} {...page} />
                  <span class="dz-shade dz-shade--b" aria-hidden="true"></span>
                </div>
              )
            }
          </div>
        ))
      }
      <span class="dz-ear" aria-hidden="true"></span>
    </div>
  </div>
  </div>

  <div class="dz-book-bar">
    <button class="dz-bb dz-bb-prev" type="button" aria-label="Previous spread" disabled>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <p class="dz-book-status" role="status" aria-live="polite" data-status>Closed. Drag the cover to open.</p>
    <button class="dz-bb dz-bb-next" type="button" aria-label="Next spread">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
  </div>
  <p class="dz-book-hint" data-hint>Drag the cover to open</p>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-book]");
  if (root) {
    const stage = root.querySelector<HTMLElement>(".dz-book")!;
    const bookIn = root.querySelector<HTMLElement>(".dz-book-in")!;
    const cover = root.querySelector<HTMLElement>(".dz-cover")!;
    const leaves = [...root.querySelectorAll<HTMLElement>(".dz-leaf")];
    const N = leaves.length - 1; // the last leaf is a static base page
    // Safari ignores backface-visibility for faces holding positioned or blended children, so the wrong face is switched off by hand
    const fronts = leaves.map((l) => l.querySelector<HTMLElement>(":scope > .dz-front"));
    const backs = leaves.map((l) => l.querySelector<HTMLElement>(":scope > .dz-back"));
    const titles: string[] = JSON.parse(root.dataset.titles ?? "[]");
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const hint = root.querySelector<HTMLElement>("[data-hint]")!;
    const prevBtn = root.querySelector<HTMLButtonElement>(".dz-bb-prev")!;
    const nextBtn = root.querySelector<HTMLButtonElement>(".dz-bb-next")!;
    const sec = root.closest<HTMLElement>(".dz-intro");
    const turn = root.querySelector<HTMLElement>(".dz-book-turn")!;
    // On a portrait phone the book shows one page at a time: a window one page wide slides over the spread
    const single = () => !!sec?.classList.contains("is-single");
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    const clamp = (n: number, a = 0, b = 1) => Math.min(b, Math.max(a, n));
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);

    const ang: number[] = new Array(N).fill(0); // current angle of each turning leaf, 0 (right) to 180 (left)
    const tgt: number[] = new Array(N).fill(0); // where each leaf is heading
    type Tween = { from: number; to: number; t0: number; dur: number };
    const tw: (Tween | null)[] = new Array(N).fill(null);
    let turned = 0;
    let side: "L" | "R" = "R"; // single-page view: which page of the spread is on show (the cover counts as R)
    let pan = 1; // single-page view: 0 = left page in the window, 1 = right page
    let panTw: Tween | null = null;
    let dragLeaf = -1;
    let raf = 0;

    const paint = () => {
      // Only the pages that can be seen are rendered: the top page of each pile, plus any page in motion
      // (and the page revealed under it). Buried pages are hidden, so nothing fights over depth and clicks reach the live pages.
      let a = 0;
      while (a < N && ang[a] >= 179.5) a++;
      let last = -1;
      for (let i = N - 1; i >= 0; i--) if (ang[i] > 0.5) { last = i; break; }
      const b = last + 1;
      let nl = 0, nr = 0;
      for (let i = 0; i < N; i++) {
        const v = ang[i];
        nl += clamp((v - 120) / 60); // a page only joins a pile once it has (nearly) landed
        nr += clamp((60 - v) / 60);
      }
      leaves.forEach((l, i) => {
        l.style.visibility = i === a - 1 || (i >= a && i <= b) ? "visible" : "hidden";
        if (i >= N) return;
        const v = ang[i];
        const moving = (v > 0.5 && v < 179.5) || !!tw[i] || i === dragLeaf;
        l.style.transform = `${moving ? "translateZ(2px) " : ""}rotateY(${(-v).toFixed(2)}deg)`;
        const f = fronts[i], bk = backs[i];
        if (f) f.style.visibility = v >= 90 ? "hidden" : "";
        if (bk) bk.style.visibility = v < 90 ? "hidden" : "";
        l.style.setProperty("--sf", ((v / 180) * 0.5).toFixed(3));
        l.style.setProperty("--sb", ((1 - v / 180) * 0.5).toFixed(3));
      });
      // Page-stack edges: the pile on each side thickens as pages move to it
      stage.style.setProperty("--nl", (nl / N).toFixed(3));
      stage.style.setProperty("--nr", (nr / N).toFixed(3));
      // The book sits centred on its cover, then slides to the middle as the cover opens
      stage.style.setProperty("--shift", single() ? "0%" : `${(-25 + 25 * Math.min(1, ang[0] / 90)).toFixed(2)}%`);
      stage.style.setProperty("--pan", pan.toFixed(4));
    };
    const tick = (now: number) => {
      let any = false;
      for (let i = 0; i < N; i++) {
        const t = tw[i];
        if (!t) continue;
        const k = (now - t.t0) / t.dur;
        if (k < 0) { any = true; continue; }
        if (k >= 1) { ang[i] = t.to; tw[i] = null; } else { ang[i] = t.from + (t.to - t.from) * ease(k); any = true; }
      }
      if (panTw) {
        const k = (now - panTw.t0) / panTw.dur;
        if (k < 0) any = true;
        else if (k >= 1) { pan = panTw.to; panTw = null; }
        else { pan = panTw.from + (panTw.to - panTw.from) * ease(k); any = true; }
      }
      paint();
      raf = any ? requestAnimationFrame(tick) : 0;
    };
    const run = () => { if (!raf) raf = requestAnimationFrame(tick); };
    const settle = () => { for (let i = 0; i < N; i++) if (tw[i]) { ang[i] = tw[i]!.to; tw[i] = null; } if (panTw) { pan = panTw.to; panTw = null; } paint(); };
    const panTo = (to: number, dur = 800, delay = 0) => {
      if (calm) { pan = to; panTw = null; paint(); return; }
      panTw = { from: pan, to, t0: performance.now() + delay, dur };
      run();
    };
    const flip = (i: number, to: number, dur = 800, delay = 0) => {
      tgt[i] = to;
      if (calm) { ang[i] = to; tw[i] = null; paint(); return; }
      tw[i] = { from: ang[i], to, t0: performance.now() + delay, dur };
      run();
    };

    const links = [...document.querySelectorAll<HTMLElement>("[data-spread]")];
    const sync = () => {
      turned = tgt.filter((t) => t === 180).length;
      root.dataset.turned = String(turned);
      root.toggleAttribute("data-last", turned === N);
      const atEnd = turned === N && (!single() || side === "R");
      status.textContent = turned === 0 ? (single() ? "Swipe to open the book." : "Closed. Drag the cover to open.") : single() ? `${titles[turned - 1]}, page ${side === "L" ? 2 * turned - 1 : 2 * turned} of ${2 * N}` : `Spread ${turned} of ${N}: ${titles[turned - 1]}`;
      hint.textContent = turned === 0 ? "Drag the cover to open" : "Drag a page to turn it";
      prevBtn.disabled = turned === 0;
      nextBtn.disabled = atEnd;
      // Light up every contents entry for the section on show
      let best = 0;
      for (const l of links) { const v = Number(l.dataset.spread); if (v <= turned && v > best) best = v; }
      links.forEach((l) => (turned > 0 && Number(l.dataset.spread) === best ? l.setAttribute("aria-current", "true") : l.removeAttribute("aria-current")));
    };
    const setTurned = (k: number, to: "L" | "R" = "L") => {
      k = clamp(k, 0, N);
      const forward = k > turned;
      const changing: number[] = [];
      for (let i = 0; i < N; i++) if (tgt[i] !== (i < k ? 180 : 0)) changing.push(i);
      if (!forward) changing.reverse();
      changing.forEach((i, n) => flip(i, i < k ? 180 : 0, changing.length > 1 ? 650 : 850, n * 85));
      side = k === 0 ? "R" : to; // the single-page view lands on the left page of a spread unless told otherwise
      panTo(side === "L" ? 0 : 1, changing.length > 1 ? 650 + (changing.length - 1) * 85 : 850);
      sync();
    };
    // Single-page view: move one page forwards or back
    const step = (d: number) => {
      if (!single()) return setTurned(turned + d);
      if (d > 0) {
        if (turned === 0) setTurned(1, "L");
        else if (side === "R") setTurned(turned + 1, "L");
        else setTurned(turned, "R");
      } else if (turned > 0) {
        if (side === "L") setTurned(turned - 1, "R");
        else setTurned(turned, "L");
      }
    };
    // While the section is pinned, scrolling opens the cover (and closes it again on the way back).
    // As soon as the visitor touches the book, it is theirs.
    let touched = false;
    window.addEventListener("dz:scrub", (e) => {
      const p = (e as CustomEvent<{ p: number | null }>).detail.p;
      if (touched || p === null || down || single()) return;
      const a = 180 * ease(clamp((p - 0.38) / 0.3));
      ang[0] = a; tw[0] = null; tgt[0] = a >= 179 ? 180 : 0;
      paint(); sync();
    });
    const claim = () => { touched = true; };
    const tick1 = () => { if (!calm && "vibrate" in navigator) navigator.vibrate(6); };

    // Drag a page: the page follows the pointer; release decides by angle and flick speed
    let down = false, onControl = false, moved = false, panDrag = false, startX = 0, dir = 1, leaf = -1, pw = 1, t0 = 0, touch = false;
    const samples: { x: number; t: number }[] = [];
    const shiftNow = () => parseFloat(stage.style.getPropertyValue("--shift") || "-25");
    stage.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse" && e.button !== 0) return;
      claim();
      // Links and buttons on the live pages work on a tap; a drag that starts on one still turns the page
      onControl = !!(e.target as Element).closest("a, button, input");
      settle();
      const r = stage.getBoundingClientRect();
      if (single()) {
        pw = turn.getBoundingClientRect().width; // one page wide; the direction is decided by the first move
        leaf = -1;
      } else {
        const spineX = r.left + r.width * (0.5 + shiftNow() / 100);
        dir = e.clientX >= spineX ? 1 : -1;
        leaf = dir === 1 ? turned : turned - 1;
        if (leaf < 0 || leaf >= N) leaf = -1;
        pw = r.width / 2;
      }
      startX = e.clientX;
      touch = e.pointerType !== "mouse";
      down = true; moved = false; panDrag = false; t0 = performance.now();
      samples.length = 0; samples.push({ x: e.clientX, t: t0 });
    });
    stage.addEventListener("pointermove", (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 6) {
        moved = true;
        if (single()) {
          // Forward from a right page turns its leaf; forward from a left page slides to the right page; and the reverse
          dir = dx < 0 ? 1 : -1;
          if (dir === 1) { if (side === "R") leaf = turned < N ? turned : -1; else panDrag = true; }
          else if (side === "L") leaf = turned - 1;
          else panDrag = turned > 0;
          panTw = null;
        }
        if (leaf >= 0 || panDrag) {
          stage.setPointerCapture(e.pointerId);
          stage.classList.add("is-dragging");
          if (leaf >= 0) { dragLeaf = leaf; tw[leaf] = null; }
        }
      }
      samples.push({ x: e.clientX, t: performance.now() });
      if (samples.length > 6) samples.shift();
      if (moved && leaf >= 0) {
        const p = clamp((dir === 1 ? -dx : dx) / (pw * 1.2));
        ang[leaf] = dir === 1 ? 180 * p : 180 - 180 * p;
        if (single()) pan = 1 - ang[leaf] / 180;
        paint();
      } else if (moved && panDrag) {
        pan = side === "L" ? clamp(-dx / pw) : 1 - clamp(dx / pw);
        paint();
      }
    });
    const release = (cancel = false) => {
      if (!down) return;
      down = false;
      stage.classList.remove("is-dragging");
      if (moved && (leaf >= 0 || panDrag)) {
        const a = samples[0], b = samples[samples.length - 1];
        const v = b.t > a.t ? (b.x - a.x) / (b.t - a.t) : 0; // px per ms, positive = rightwards
        const fwd = dir === 1;
        const flick = fwd ? v < -0.45 : v > 0.45;
        const against = fwd ? v > 0.45 : v < -0.45;
        if (leaf >= 0) {
          const past = fwd ? ang[leaf] > 90 : ang[leaf] < 90;
          const complete = cancel ? false : flick || (!against && past);
          const to = fwd ? (complete ? 180 : 0) : (complete ? 0 : 180);
          const dur = 350 + 450 * (Math.abs(to - ang[leaf]) / 180);
          dragLeaf = -1;
          flip(leaf, to, dur);
          if (single()) { side = fwd ? (complete ? "L" : "R") : complete ? "R" : "L"; panTo(side === "L" ? 0 : 1, dur); }
          sync();
          if (complete && touch) window.setTimeout(tick1, dur);
        } else {
          // Sliding between the two pages of one spread
          const past = fwd ? pan > 0.5 : pan < 0.5;
          const complete = cancel ? false : flick || (!against && past);
          if (complete) side = side === "L" ? "R" : "L";
          const goal = side === "L" ? 0 : 1;
          panTo(goal, 300 + 350 * Math.abs(goal - pan));
          sync();
        }
      } else if (!moved && !cancel && !onControl) {
        if (single()) step(startX >= turn.getBoundingClientRect().left + pw / 2 ? 1 : -1);
        else setTurned(turned + (dir === 1 ? 1 : -1));
        if (touch) tick1();
      }
      leaf = -1; panDrag = false;
    };
    stage.addEventListener("pointerup", () => release());
    stage.addEventListener("pointercancel", () => release(true));
    stage.addEventListener("dragstart", (e) => e.preventDefault());

    // Micro details: the cover's foil sheen follows the pointer and the whole book leans a little toward it
    if (fine && !calm) {
      let tx = 0, ty = 0, cx = 0, cy = 0, tilting = 0;
      const lean = () => {
        cx += (tx - cx) * 0.12; cy += (ty - cy) * 0.12;
        bookIn.style.setProperty("--rx", `${cx.toFixed(3)}deg`);
        bookIn.style.setProperty("--ry", `${cy.toFixed(3)}deg`);
        tilting = Math.abs(tx - cx) + Math.abs(ty - cy) > 0.004 ? requestAnimationFrame(lean) : 0;
      };
      stage.addEventListener("pointermove", (e) => {
        const r = stage.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width, py = (e.clientY - r.top) / r.height;
        cover.style.setProperty("--mx", `${(px * 160 - 30).toFixed(1)}%`);
        cover.style.setProperty("--my", `${(py * 130 - 15).toFixed(1)}%`);
        if (!down) { tx = (0.5 - py) * 2.4; ty = (px - 0.5) * 2.8; if (!tilting) tilting = requestAnimationFrame(lean); }
      });
      stage.addEventListener("pointerleave", () => { tx = 0; ty = 0; if (!tilting) tilting = requestAnimationFrame(lean); });
    }

    // Keyboard, buttons and contents entries
    stage.addEventListener("keydown", (e) => {
      claim();
      if (e.key === "ArrowRight") { e.preventDefault(); step(1); }
      if (e.key === "ArrowLeft") { e.preventDefault(); step(-1); }
      if (e.key === "Home") { e.preventDefault(); setTurned(0); }
      if (e.key === "End") { e.preventDefault(); setTurned(N, "R"); }
    });
    prevBtn.addEventListener("click", () => { claim(); step(-1); });
    nextBtn.addEventListener("click", () => { claim(); step(1); });
    root.querySelectorAll<HTMLElement>("[data-action='cover']").forEach((b) => b.addEventListener("click", () => { claim(); setTurned(0); }));
    links.forEach((el) =>
      el.addEventListener("click", () => {
        claim();
        setTurned(Number(el.dataset.spread));
        const r = stage.getBoundingClientRect();
        if (r.bottom < 0 || r.top > window.innerHeight) stage.scrollIntoView({ block: "center", behavior: calm ? "auto" : "smooth" });
      }),
    );

    // First time it comes into view, the cover lifts a little to show it opens
    if (!calm && !document.querySelector(".is-pinned")) {
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          if (turned === 0 && !down) {
            flip(0, 16, 520, 250);
            window.setTimeout(() => { if (turned === 0 && !down && tgt[0] === 16) flip(0, 0, 700); }, 1100);
          }
        }),
        { threshold: 0.6 },
      );
      io.observe(stage);
    }

    window.addEventListener("dz:mode", () => {
      if (single()) { pan = side === "L" ? 0 : 1; panTw = null; }
      paint(); sync();
    });
    paint();
    sync();
  }
</script>
