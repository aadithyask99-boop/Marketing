---
import "../styles/starter.css";
import "../styles/startup.css";
import "../styles/pathcards.css";
import { url } from "../data/site";
import { PATH } from "../data/plans";

interface Props {
  tone?: "cream" | "ink";
  // true on the plans page itself, where #care and #growth are on the same page
  local?: boolean;
  id?: string;
}
const { tone = "cream", local = false, id = "path-cards" } = Astro.props;
const PLANS_PAGE = "/our-services/care-and-growth-plans";
const link = (h: string) => (h.startsWith("#") && !local ? url(PLANS_PAGE) + h : h.startsWith("#") ? h : url(h));
// Small drawings shown in the tile that follows the cursor over the path cards (same as the Starter page)
const ARTS: Record<string, string> = {
  starter: `<svg viewBox="0 0 120 120"><rect x="14" y="22" width="92" height="76" rx="8" fill="#f5efe8" stroke="#17090a" stroke-width="2.6"/><path d="M14 40h92" stroke="#17090a" stroke-width="2.6"/><circle cx="26" cy="31" r="3.2" fill="#e10600"/><circle cx="37" cy="31" r="3.2" fill="#17090a"/><rect x="26" y="52" width="40" height="8" rx="3" fill="#17090a"/><rect x="26" y="68" width="68" height="6" rx="3" fill="#17090a" opacity="0.35"/><rect x="26" y="80" width="52" height="6" rx="3" fill="#17090a" opacity="0.35"/><rect x="74" y="50" width="20" height="12" rx="3" fill="#e10600"/></svg>`,
  care: `<svg viewBox="0 0 120 120"><path d="M60 14l38 14v28c0 24-16 42-38 50-22-8-38-26-38-50V28z" fill="#f5efe8" stroke="#17090a" stroke-width="2.6" stroke-linejoin="round"/><path d="M42 60l13 13 24-26" fill="none" stroke="#e10600" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  growth: `<svg viewBox="0 0 120 120"><rect x="16" y="68" width="20" height="34" rx="4" fill="#17090a"/><rect x="50" y="48" width="20" height="54" rx="4" fill="#17090a"/><rect x="84" y="24" width="20" height="78" rx="4" fill="#e10600"/><path d="M18 52l30-18 22 10 32-28" fill="none" stroke="#17090a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
};
---

<div class:list={["pc", tone === "ink" && "pc--ink"]}>
  <div class="su-cardsbar" id={id}>
    <p class="su-tag">({PATH.label})</p>
  </div>
  <div class="su-cards" data-cards>
    {PATH.cards.map((c) => (
      <article class="su-card" data-peek={c.title}>
        <div class="su-card-top"><h3>{c.title}</h3><span class="su-card-price">{c.price}</span></div>
        <div class="su-card-mid">
          <p class="su-card-tag">{c.tag}</p>
          <p class="su-card-text">{c.text}</p>
        </div>
        <a class="su-link" href={link(c.href)} data-cursor="View">{c.link} <i aria-hidden="true">↗</i></a>
        <template><div class="su-peek-art" set:html={ARTS[c.art]} /></template>
      </article>
    ))}
  </div>
  <p class="su-foot">{PATH.foot}</p>
  <div class="su-peek" data-peek-box aria-hidden="true"><div class="su-peek-card"></div><span class="su-peek-label"></span></div>
</div>

<script>
  // A small tilted tile follows the cursor over the cards (mouse only, same as the Starter page)
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>(".pc").forEach((root) => {
    const cardsWrap = root.querySelector<HTMLElement>("[data-cards]");
    const cardPeek = root.querySelector<HTMLElement>("[data-peek-box]");
    if (!cardsWrap || !cardPeek || calm || !window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
    const tile = cardPeek.querySelector<HTMLElement>(".su-peek-card")!;
    const lab = cardPeek.querySelector<HTMLElement>(".su-peek-label")!;
    let tx = 0, ty = 0, x = 0, y = 0, on = false, raf = 0;
    const loop = () => {
      x += (tx - x) * 0.2; y += (ty - y) * 0.2;
      const tilt = Math.max(-10, Math.min(10, (tx - x) * 0.4));
      cardPeek.style.transform = `translate(${x}px, ${y}px) rotate(${(-6 + tilt).toFixed(1)}deg)`;
      raf = on || Math.abs(tx - x) > 0.5 ? requestAnimationFrame(loop) : 0;
    };
    cardsWrap.querySelectorAll<HTMLElement>("[data-peek]").forEach((c) => {
      c.addEventListener("pointerenter", (e) => {
        tile.innerHTML = c.querySelector("template")?.innerHTML ?? "";
        lab.textContent = c.dataset.peek ?? "";
        tx = x = e.clientX; ty = y = e.clientY;
        on = true; cardPeek.classList.add("is-on");
        if (!raf) raf = requestAnimationFrame(loop);
      });
      c.addEventListener("pointermove", (e) => { tx = e.clientX + 18; ty = e.clientY + 18; });
      c.addEventListener("pointerleave", () => { on = false; cardPeek.classList.remove("is-on"); });
    });
  });
</script>
