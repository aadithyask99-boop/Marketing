---
import "../styles/nav.css";
import QRCode from "qrcode";
import { siWhatsapp } from "simple-icons";
import { NAV, SITE, url } from "../data/site";

const { minimal = false } = Astro.props;
const base = url("");
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, "") || "/";
const links = NAV.filter((n) => n.href !== "/");
const qr = await QRCode.toString(SITE.whatsapp, { type: "svg", margin: 0, color: { dark: "#17090a", light: "#0000" } });
---

<header class:list={["site-header", minimal && "site-header--minimal"]} data-nav>
  <div class="nav-pill">
    <a class="logo" href={url("/")} aria-label={`${SITE.name} home`} data-cursor="to home">
      <span class="logo-m" aria-hidden="true" style={`--logo:url(${url("/logo-m.png")});--logo-ink:url(${url("/logo-m-ink.png")})`}></span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <span class="nav-hl" aria-hidden="true"></span>
      {
        links.map((item) => (
          <a href={url(item.href)} aria-current={path === item.href || path.startsWith(`${item.href}/`) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-actions">
      <a class="nav-cta" href={minimal ? "#start" : url("/contact")} {...(minimal ? { "data-preset": "I'd like the Starter website package (from £999)" } : { "aria-haspopup": "true", "aria-expanded": "false", "aria-controls": "wa-card" })}>
        {minimal ? "Get started" : "Talk to us"}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>
      </a>
      {!minimal && <button
        class="menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="menu"
        aria-label="Open menu"
      >
        <span aria-hidden="true">+</span>
      </button>}
    </div>

  </div>

  {!minimal && <div class="wa-card" id="wa-card" role="dialog" aria-label="Chat with us on WhatsApp" hidden>
    <svg class="wa-logo" viewBox="0 0 24 24" aria-hidden="true"><path d={siWhatsapp.path}></path></svg>
    <div class="wa-qr" aria-hidden="true" set:html={qr} />
    <p class="wa-title">WhatsApp us</p>
    <p class="wa-text">Scan the QR code to chat with us via your smartphone.</p>
    <a class="wa-link" href={SITE.whatsapp} target="_blank" rel="noopener noreferrer">
      Chat via desktop
      <svg viewBox="0 0 200 12" aria-hidden="true"><path d="M2 8C40 3 90 2 140 6S185 8 198 5"></path></svg>
    </a>
  </div>}
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-nav]");
  if (header) {
    // WhatsApp card: opens on hover or keyboard focus of "Talk to us" (desktop only)
    const cta = header.querySelector<HTMLAnchorElement>(".nav-cta");
    const card = header.querySelector<HTMLElement>(".wa-card");
    const desk = window.matchMedia("(min-width: 900px) and (hover: hover) and (pointer: fine)");
    if (cta && card) {
      let timer = 0;
      const open = () => {
        if (!desk.matches) return;
        window.clearTimeout(timer);
        card.hidden = false;
        requestAnimationFrame(() => card.classList.add("is-open"));
        cta.setAttribute("aria-expanded", "true");
      };
      const close = () => {
        window.clearTimeout(timer);
        card.classList.remove("is-open");
        cta.setAttribute("aria-expanded", "false");
        timer = window.setTimeout(() => { if (!card.classList.contains("is-open")) card.hidden = true; }, 250);
      };
      const later = () => { window.clearTimeout(timer); timer = window.setTimeout(close, 220); };
      cta.addEventListener("pointerenter", open);
      cta.addEventListener("pointerleave", later);
      card.addEventListener("pointerenter", () => window.clearTimeout(timer));
      card.addEventListener("pointerleave", later);
      cta.addEventListener("focus", open);
      header.addEventListener("focusout", (e) => { if (!header.contains(e.relatedTarget as Node)) close(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
      window.addEventListener("scroll", () => { if (card.classList.contains("is-open")) close(); }, { passive: true });
    }

    const wrap = header.querySelector<HTMLElement>(".nav-links")!;
    const hl = header.querySelector<HTMLElement>(".nav-hl")!;
    const links = [...wrap.querySelectorAll<HTMLAnchorElement>("a")];

    // Sliding highlight
    let placed = false;
    const place = (a: HTMLElement, strong: boolean) => {
      const r = a.getBoundingClientRect();
      const w = wrap.getBoundingClientRect();
      if (!placed) {
        hl.style.transition = "none";
      }
      hl.style.width = `${r.width}px`;
      hl.style.transform = `translate(${r.left - w.left}px, -50%)`;
      hl.style.opacity = strong ? "1" : "0.55";
      if (!placed) {
        void hl.offsetWidth;
        hl.style.transition = "";
        placed = true;
      }
    };
    const rest = () => {
      const current = links.find((a) => a.getAttribute("aria-current") === "page");
      if (current) place(current, false);
      else hl.style.opacity = "0";
    };
    links.forEach((a) => {
      a.addEventListener("pointerenter", () => place(a, true));
      a.addEventListener("focus", () => place(a, true));
      a.addEventListener("blur", rest);
    });
    wrap.addEventListener("pointerleave", rest);
    window.addEventListener("resize", rest);
    rest();
    document.fonts?.ready.then(rest);

    // Glass state, hide on scroll down / show on scroll up
    let lastY = window.scrollY;
    let anchor = lastY;
    let dir = 0;
    let focusInside = false;
    let ticking = false;

    const show = () => header.classList.remove("is-hidden");
    const hide = () => header.classList.add("is-hidden");
    const menuOpen = () => document.body.classList.contains("menu-open");

    // Sample the page colour under the logo so the transparent header (top of page) stays readable
    // on any section: light mark on dark backgrounds, dark mark on light ones.
    const probe = header.querySelector<HTMLElement>(".logo-m")!;
    const sampleBg = () => {
      const r = probe.getBoundingClientRect();
      const x = Math.min(window.innerWidth - 1, Math.max(0, r.left + r.width / 2));
      const y = Math.min(window.innerHeight - 1, Math.max(0, r.top + r.height / 2));
      for (let el: Element | null = document.elementsFromPoint(x, y).find((e) => !header.contains(e)) ?? null; el; el = el.parentElement) {
        const m = getComputedStyle(el).backgroundColor.match(/[\d.]+/g);
        if (!m) continue;
        const [r8, g8, b8, a = "1"] = m;
        if (Number(a) < 0.5) continue;
        const lum = (0.2126 * Number(r8) + 0.7152 * Number(g8) + 0.0722 * Number(b8)) / 255;
        return lum > 0.6 ? "light" : "dark";
      }
      return "dark";
    };

    const update = () => {
      ticking = false;
      const y = window.scrollY;
      header.classList.toggle("is-glass", y > 24);
      header.dataset.bg = sampleBg();

      if (y > lastY) {
        if (dir !== 1) { dir = 1; anchor = lastY; }
        if (y - anchor > 24 && y > 120 && !focusInside && !menuOpen()) hide();
      } else if (y < lastY) {
        if (dir !== -1) { dir = -1; anchor = lastY; }
        if (anchor - y > 8) show();
      }
      if (y <= 120 || menuOpen()) show();
      lastY = y;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    header.addEventListener("focusin", () => { focusInside = true; show(); });
    header.addEventListener("focusout", () => (focusInside = false));
    new MutationObserver(() => menuOpen() && show()).observe(document.body, { attributes: true, attributeFilter: ["class"] });
    window.addEventListener("resize", update);
    update();
  }
</script>
