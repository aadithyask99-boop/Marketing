---
import { SITE } from "../data/site";
---

<header class="site-header">
  <a class="logo" href="/" aria-label={`${SITE.name} home`}>{SITE.name}</a>
  <button
    class="menu-btn"
    type="button"
    aria-expanded="false"
    aria-controls="menu"
    aria-label="Open menu"
  >
    <span aria-hidden="true">+</span>
  </button>
</header>
