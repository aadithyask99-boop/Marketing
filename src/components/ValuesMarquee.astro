---
import { Image } from "astro:assets";
import "../styles/carousel.css";
import { ABOUT } from "../data/site";
import found from "../assets/values/found.webp";
import clear from "../assets/values/clear.webp";
import accountable from "../assets/values/accountable.webp";
import curious from "../assets/values/curious.webp";
import human from "../assets/values/human.webp";
const ART = { found, clear, accountable, curious, human } as const;
const pad = (n: number) => String(n).padStart(2, "0");
---

<section class="vals" data-vals aria-labelledby="vals-title">
  <h2 id="vals-title" class="display vals-title">Our values shape <span class="vals-accent">the work we do</span></h2>
  <div class="vals-window" data-window data-cursor="Drag" tabindex="0" aria-label="Our values, drag or use the arrow keys">
    <div class="vals-track" data-track>
      {
        [0, 1, 2].map((copy) => (
          <ul class="vals-list" data-clone={copy > 0 ? "" : undefined} aria-hidden={copy > 0 ? "true" : undefined}>
            {ABOUT.values.map((v, i) => (
              <li class="val" data-card>
                <p class="val-label"><span>{v.title}</span><span class="val-num">{pad(i + 1)}</span></p>
                <div class="val-art"><Image src={ART[v.image]} alt="" width={640} height={640} loading="lazy" decoding="async" draggable="false" class="val-img" /></div>
                <p class="val-text">{v.body}</p>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
  <div class="vals-ctrl">
    <button class="vals-btn" type="button" data-dir="-1" aria-label="Previous value">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <span class="vals-dots" aria-hidden="true">{ABOUT.values.map(() => <span></span>)}</span>
    <button class="vals-btn" type="button" data-dir="1" aria-label="Next value">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
  </div>
</section>

<script>
  import { initDragCarousel } from "../scripts/dragCarousel";
  const root = document.querySelector<HTMLElement>("[data-vals]");
  if (root) initDragCarousel(root);
</script>
