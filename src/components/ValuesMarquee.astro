---
import OfferShape from "./OfferShape.astro";
import { ABOUT } from "../data/site";
---

<section class="vals" data-vals aria-labelledby="vals-title">
  <h2 id="vals-title" class="display vals-title">Our values shape <span class="vals-accent">the work we do</span></h2>
  <div class="vals-window" data-window tabindex="0" aria-label="Our values, drag or scroll sideways">
    <ul class="vals-list">
      {
        ABOUT.values.map((v) => (
          <li class={`val val--${v.tone}`} data-cursor="Drag">
            <div class="val-art"><OfferShape shape={v.shape} class="val-shape" /></div>
            <h3 class="display val-title">{v.title}</h3>
            <p>{v.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="vals-ctrl">
    <span class="vals-bar" aria-hidden="true"><span data-bar></span></span>
    <button class="vals-btn" type="button" data-dir="-1" aria-label="Previous value">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <button class="vals-btn" type="button" data-dir="1" aria-label="Next value">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-vals]");
  const win = root?.querySelector<HTMLElement>("[data-window]");
  const bar = root?.querySelector<HTMLElement>("[data-bar]");
  if (root && win && bar) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const step = () => (win.querySelector<HTMLElement>(".val")?.offsetWidth ?? 300) + 20;

    const progress = () => {
      const max = win.scrollWidth - win.clientWidth;
      const p = max > 0 ? win.scrollLeft / max : 0;
      const size = max > 0 ? win.clientWidth / win.scrollWidth : 1;
      bar.style.width = `${(size * 100).toFixed(1)}%`;
      bar.style.transform = `translateX(${(p * (1 / size - 1) * 100).toFixed(1)}%)`;
    };
    win.addEventListener("scroll", progress, { passive: true });
    window.addEventListener("resize", progress);
    progress();

    root.querySelectorAll<HTMLButtonElement>(".vals-btn").forEach((b) =>
      b.addEventListener("click", () => win.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: reduced ? "auto" : "smooth" })),
    );
    win.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); win.scrollBy({ left: step(), behavior: reduced ? "auto" : "smooth" }); }
      if (e.key === "ArrowLeft") { e.preventDefault(); win.scrollBy({ left: -step(), behavior: reduced ? "auto" : "smooth" }); }
    });

    // Mouse drag with a little momentum (touch uses native swipe)
    let drag: { x0: number; left0: number; last: number; v: number; moved: boolean } | null = null;
    let raf = 0;
    win.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse" || e.button !== 0) return;
      cancelAnimationFrame(raf);
      drag = { x0: e.clientX, left0: win.scrollLeft, last: e.clientX, v: 0, moved: false };
      win.classList.add("is-dragging");
      win.setPointerCapture(e.pointerId);
    });
    win.addEventListener("pointermove", (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x0;
      if (Math.abs(dx) > 4) drag.moved = true;
      drag.v = e.clientX - drag.last;
      drag.last = e.clientX;
      win.scrollLeft = drag.left0 - dx;
    });
    const release = () => {
      if (!drag) return;
      let v = -drag.v;
      drag = null;
      win.classList.remove("is-dragging");
      if (reduced) return;
      const glide = () => {
        win.scrollLeft += v;
        v *= 0.94;
        if (Math.abs(v) > 0.4) raf = requestAnimationFrame(glide);
      };
      raf = requestAnimationFrame(glide);
    };
    win.addEventListener("pointerup", release);
    win.addEventListener("pointercancel", release);
    win.addEventListener("click", (e) => { if (drag?.moved) e.preventDefault(); }, true);
  }
</script>
