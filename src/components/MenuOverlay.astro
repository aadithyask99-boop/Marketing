---
import { NAV, url } from "../data/site";

const basePath = url("");
const path = Astro.url.pathname.slice(basePath.length).replace(/\/$/, "") || "/";
---

<nav id="menu" class="menu" aria-label="Main" hidden>
  <div class="menu-panel">
    <ul class="menu-list">
      {
        NAV.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={url(item.href)} aria-current={path === item.href || (item.href !== "/" && path.startsWith(`${item.href}/`)) ? "page" : undefined}>
              <span>{item.label}</span>
              <span class="menu-go" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"></path></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="menu-cta" href={url("/contact-us")} style={`--i:${NAV.length}`}>
      Talk to us
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>
    </a>
  </div>
</nav>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".menu-btn");
  const menu = document.getElementById("menu");

  function setMenu(open: boolean) {
    if (!btn || !menu) return;
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    document.body.classList.toggle("menu-open", open);
    if (open) {
      menu.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => menu.classList.add("is-in")));
    } else {
      menu.classList.remove("is-in");
      menu.hidden = true;
    }
  }

  btn?.addEventListener("click", () => setMenu(!!menu?.hidden));
  menu?.addEventListener("click", (e) => {
    const t = e.target as Element;
    if (t.closest("a") || t === menu) setMenu(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu && !menu.hidden) {
      setMenu(false);
      btn?.focus();
    }
  });
  window.matchMedia("(min-width: 900px)").addEventListener("change", (e) => {
    if (e.matches && menu && !menu.hidden) setMenu(false);
  });
</script>
