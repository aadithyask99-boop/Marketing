---
import "../styles/offices.css";
import { OFFICES, SITE } from "../data/site";
interface Props {
  tone?: "cream" | "red";
}
const { tone = "cream" } = Astro.props;
---

<section class:list={["offices", `offices--${tone}`]} aria-labelledby="offices-title">
  <h2 id="offices-title" class="sr-only">Our offices</h2>
  <ul class="offices-list">
    {
      OFFICES.map((o) => (
        <li class="office">
          <h3 class="office-country">{o.country}</h3>
          <address class="office-addr">
            {o.street}<br />
            {[o.locality, o.region, o.postcode].filter(Boolean).join(", ")}<br />
            {o.country}
          </address>
          <p class="office-links">
            <a href={`tel:${o.tel}`}>{o.phone}</a>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
        </li>
      ))
    }
  </ul>
</section>
