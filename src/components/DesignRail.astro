---
import { getImage } from "astro:assets";
import Sticker from "./Sticker.astro";
import { DESIGN_KINDS, type DesignProject, type DesignKind } from "../data/design";
import { SITE, url } from "../data/site";

export interface RailItem {
  slug: string;
  name: string;
  small: string;
  thumb: string;
}
export interface RailGroup {
  label: string;
  items: RailItem[];
}

interface Props {
  /** Client boards: the groups are built from the projects. */
  projects?: DesignProject[];
  /** Any other list (for example the websites and Instagram grids). */
  groups?: RailGroup[];
  title?: string;
  noun?: string;
  label?: string;
  contact?: boolean;
  class?: string;
}

const { projects = [], groups: given, title = "Portfolio", noun = "projects", label = "Projects on this page", contact = true, class: extra } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
const kinds = (Object.keys(DESIGN_KINDS) as DesignKind[]).filter((k) => projects.some((p) => p.kind === k));
const groups: RailGroup[] =
  given ??
  (await Promise.all(
    kinds.map(async (k) => ({
      label: DESIGN_KINDS[k],
      items: await Promise.all(
        projects
          .filter((p) => p.kind === k)
          .map(async (p) => ({
            slug: p.slug,
            name: p.name,
            small: p.tags.slice(0, 2).join(" · "),
            thumb: (await getImage({ src: p.tiles[0].src, width: 160, height: 160, fit: "cover", format: "webp" })).src,
          })),
      ),
    })),
  ));
let n = 0;
const numbered = groups.map((g) => ({ label: g.label, items: g.items.map((it) => ({ ...it, n: n++ })) }));
const total = n;
---

<aside class:list={["dz-rail", extra]} data-rail>
  <div class="dz-rail-in">
    <header class="dz-rail-head">
      <img class="dz-rail-logo" src={url("/logo-m-ink.png")} alt="" width="40" height="38" />
      <div>
        <p class="dz-rail-title">{title}</p>
        <p class="dz-rail-count"><span data-of>01</span> / {pad(total)} {noun}</p>
      </div>
    </header>

    <nav class="dz-nav" aria-label={label}>
      <span class="dz-prog" aria-hidden="true"><span></span></span>
      <span class="dz-hl" aria-hidden="true"></span>
      <ol class="dz-index">
        {
          numbered.map((g) => (
            <>
              <li class="dz-kind" aria-hidden="true">{g.label}</li>
              {g.items.map(({ slug, name, small, thumb, n }) => (
                <li>
                  <a href={`#${slug}`} data-spy={slug}>
                    <img class="dz-thumb" src={thumb} alt="" width="48" height="48" loading="lazy" decoding="async" />
                    <span class="dz-i-text">
                      <span class="dz-i-n">{pad(n + 1)}</span>
                      <b class="dz-i-name">{name}</b>
                      <small>{small}</small>
                    </span>
                  </a>
                </li>
              ))}
            </>
          ))
        }
      </ol>
    </nav>

    {contact && (<div class="dz-contact">
      <Sticker name="chat" class="dz-contact-sticker" />
      <p class="dz-contact-q">Got a <em>brand</em> in mind?</p>
      <a class="dz-cta" href={`${url("/contact")}?service=${encodeURIComponent("Brand & Identity")}`} data-cursor="Talk">
        Start your brand <i aria-hidden="true">↗</i>
      </a>
      <ul class="dz-contact-links">
        <li><a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
        <li><a href={`mailto:${SITE.email}`}>Email</a></li>
      </ul>
    </div>)}
  </div>
</aside>
