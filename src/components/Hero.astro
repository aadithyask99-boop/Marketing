---
import RotatingWord from "./RotatingWord.astro";
import Asterisk from "./Asterisk.astro";
import Badge from "./Badge.astro";
import { ROTATING_WORDS, SITE, url } from "../data/site";

const label = `Your ${ROTATING_WORDS.map((w) => w.toLowerCase()).join(", ")} agency`;
---

<section class="hero">
  <p class="hero-tag">{SITE.tagline}</p>

  <h1 class="hero-title" aria-label={label}>
    <span class="hero-line" aria-hidden="true" data-xray>Your</span>
    <span class="hero-line"><RotatingWord words={ROTATING_WORDS} /></span>
    <span class="hero-line">
      <span aria-hidden="true" data-xray>Agency</span>
      <Asterisk />
      <Badge href={url("/contact")} label="Let's grow" cursor="Grow" />
    </span>
  </h1>
</section>

<script>
  import { initXray } from "../scripts/xray";
  initXray(document.querySelector(".hero-title"), 10);
</script>
