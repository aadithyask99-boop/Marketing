---
import { ABOUT } from "../data/site";

// The belief line: each word lights up as you scroll.
const words: { text: string; hl: boolean }[] = [];
for (const seg of ABOUT.belief as readonly { t?: string; hl?: string }[]) {
  const text = seg.t ?? seg.hl ?? "";
  text.trim().split(/\s+/).forEach((w) => words.push({ text: w, hl: !!seg.hl }));
}
---

<section class="manifesto" data-manifesto aria-label="What we believe">
  <div class="manifesto-stick">
    <p class="manifesto-eyebrow">What we believe</p>
    <p class="manifesto-text">
      {words.map((w) => <span class:list={["mw", w.hl && "mw--hl"]}>{w.text}</span>)}
    </p>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-manifesto]");
  if (root && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const words = [...root.querySelectorAll<HTMLElement>(".mw")];
    root.classList.add("is-enhanced");
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = root.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - window.innerHeight)));
      const lit = p * 1.15 * words.length;
      words.forEach((w, i) => w.style.setProperty("--o", Math.min(1, Math.max(0, lit - i)).toFixed(3)));
    };
    window.addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    window.addEventListener("resize", update);
    update();
  }
</script>
