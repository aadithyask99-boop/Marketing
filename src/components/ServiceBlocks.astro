---
import "../styles/services.css";
import { CATEGORIES, SERVICES, url } from "../data/site";

const pad = (n: number) => String(n).padStart(2, "0");
const blocks = CATEGORIES.map((c, i) => ({ c, i, list: SERVICES.filter((s) => s.category === c.id) }));
---

<section class="svcs" data-svcs aria-label="Services by category">
  <div class="svcs-intro">
    <p class="svcs-label">What we do</p>
    <p class="svcs-lead">AI search sets the direction, design gives it form, and automation makes it real.</p>
  </div>

  {
    blocks.map(({ c, i, list }) => (
      <div class="svc-block" data-block>
        <aside class="svc-side">
          <div class="svc-sticky">
            <p class="svc-count" aria-hidden="true">
              <span class="count-roll"><span>{pad(i + 1)}</span></span> / {pad(blocks.length)}
            </p>
            <h2 class="display svc-title" data-xray>{c.title}</h2>
            <p class="svc-chip">{list.length} {list.length === 1 ? "service" : "services"}</p>
            <a class="svc-talk" href={`${url("/contact")}?service=${encodeURIComponent(c.title)}`} data-cursor="Talk">
              Talk about this <span aria-hidden="true">↗</span>
            </a>
          </div>
        </aside>

        <div class="svc-main">
          <span class="svc-progress" aria-hidden="true"><span></span></span>
          <p class="svc-intro">{c.intro}</p>
          <ul class="svc-rows">
            {
              list.map((s) => (
                <li class="svc-row" id={s.slug} data-row>
                  <h3 class="svc-h">
                    <button class="svc-btn" type="button" aria-expanded="false" aria-controls={`panel-${s.slug}`} data-cursor="Open">
                      <span class="svc-name display">{s.name}</span>
                      <span class="svc-summary">{s.summary}</span>
                      <span class="svc-tags" aria-hidden="true">
                        {s.included.slice(0, 4).map((t, n) => <span class="svc-tag" style={`--i:${n}`}>{t}</span>)}
                      </span>
                      <span class="svc-plus" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
                      </span>
                    </button>
                  </h3>
                  <div class="svc-panel" id={`panel-${s.slug}`} role="region" aria-label={s.name}>
                    <div class="svc-panel-inner">
                      <p class="svc-detail">{s.detail}</p>
                      <p class="svc-label">What's included</p>
                      <ul class="svc-included">
                        {s.included.map((t, n) => <li style={`--i:${n}`}>{t}</li>)}
                      </ul>
                      <p class="svc-best"><span>Best for</span> {s.bestFor}</p>
                      {s.note && <p class="svc-note">{s.note}</p>}
                      <a class="svc-cta" href={`${url("/contact")}?service=${encodeURIComponent(s.name)}`} data-cursor="Talk">
                        Talk to us about this <span aria-hidden="true">↗</span>
                      </a>
                    </div>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    ))
  }
</section>

<script>
  import { initXray } from "../scripts/xray";

  const root = document.querySelector<HTMLElement>("[data-svcs]");
  if (root) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const rows = [...root.querySelectorAll<HTMLElement>("[data-row]")];
    root.classList.add("is-enhanced");

    const panelOf = (row: HTMLElement) => row.querySelector<HTMLElement>(".svc-panel")!;
    const btnOf = (row: HTMLElement) => row.querySelector<HTMLButtonElement>(".svc-btn")!;
    const set = (row: HTMLElement, open: boolean) => {
      row.classList.toggle("is-open", open);
      const b = btnOf(row);
      b.setAttribute("aria-expanded", String(open));
      b.dataset.cursor = open ? "Close" : "Open";
      panelOf(row).toggleAttribute("inert", !open);
    };
    rows.forEach((r) => set(r, false));

    rows.forEach((row) => {
      btnOf(row).addEventListener("click", () => {
        const opening = !row.classList.contains("is-open");
        // One open row per category
        row.closest(".svc-block")!.querySelectorAll<HTMLElement>("[data-row].is-open").forEach((o) => { if (o !== row) set(o, false); });
        set(row, opening);
        if (opening) history.replaceState(null, "", `#${row.id}`);
      });
      row.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && row.classList.contains("is-open")) { set(row, false); btnOf(row).focus(); }
      });
    });

    // Deep links such as /services#ai-search
    const fromHash = (smooth: boolean) => {
      const row = rows.find((r) => r.id === location.hash.slice(1));
      if (!row) return;
      row.closest(".svc-block")!.querySelectorAll<HTMLElement>("[data-row].is-open").forEach((o) => { if (o !== row) set(o, false); });
      set(row, true);
      row.classList.add("is-flash");
      window.setTimeout(() => row.classList.remove("is-flash"), 1600);
      window.setTimeout(() => row.scrollIntoView({ behavior: smooth && !reduced ? "smooth" : "auto", block: "center" }), 120);
    };
    if (location.hash) fromHash(false);
    window.addEventListener("hashchange", () => fromHash(true));

    // Per-block scroll progress line and counter roll-in
    const blocks = [...root.querySelectorAll<HTMLElement>("[data-block]")];
    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      for (const b of blocks) {
        const r = b.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (vh * 0.6 - r.top) / r.height));
        b.style.setProperty("--p", p.toFixed(3));
      }
    };
    window.addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    window.addEventListener("resize", update);
    update();

    const io = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle("is-in", e.isIntersecting)), { rootMargin: "-25% 0px -45% 0px" });
    blocks.forEach((b) => io.observe(b));

    root.querySelectorAll(".svc-title").forEach((t) => initXray(t, 9));
  }
</script>
