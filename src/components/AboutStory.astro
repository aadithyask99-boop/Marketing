---
import { ABOUT } from "../data/site";
---

<section class="astory" data-astory aria-label="Our story">
  <div class="as-grid">
    <aside class="as-side">
      <div class="as-sticky">
        <p class="as-eyebrow">Our story</p>
        <div class="as-year" aria-hidden="true"><span data-year>{ABOUT.chapters[0].year}</span></div>
        <p class="as-place" aria-hidden="true" data-place>{ABOUT.chapters[0].place}</p>
        <span class="as-progress" aria-hidden="true"><span></span></span>
      </div>
    </aside>

    <div class="as-chapters">
      {
        ABOUT.chapters.map((c, i) => (
          <article class="as-ch" data-ch data-year={c.year} data-place={c.place}>
            <p class="as-tag">
              <span class="as-tag-year">{c.year}</span>
              {c.office ? (
                <span class="office-pill" data-tz={c.office.tz} data-cursor="Office" tabindex="0">
                  {c.office.label}
                  <span class="pill-time" aria-hidden="true"></span>
                </span>
              ) : (
                <span class="as-tag-place">{c.place}</span>
              )}
            </p>
            <h2 class="display as-title">{c.title}</h2>
            <p class="as-body">{c.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-astory]");
  if (root) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Live local time on the office pills
    const fmt = (tz: string) => new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: tz }).format(new Date());
    const pills = [...root.querySelectorAll<HTMLElement>(".office-pill")];
    const stamp = () => pills.forEach((p) => { p.querySelector<HTMLElement>(".pill-time")!.textContent = fmt(p.dataset.tz!); });
    stamp();
    window.setInterval(stamp, 30000);

    const chapters = [...root.querySelectorAll<HTMLElement>("[data-ch]")];
    const yearEl = root.querySelector<HTMLElement>("[data-year]")!;
    const placeEl = root.querySelector<HTMLElement>("[data-place]")!;
    const fill = root.querySelector<HTMLElement>(".as-progress span")!;
    let current = 0;

    const roll = (el: HTMLElement, text: string) => {
      if (el.textContent === text) return;
      if (reduced) { el.textContent = text; return; }
      el.animate([{ transform: "translateY(0)", opacity: 1 }, { transform: "translateY(-60%)", opacity: 0 }], { duration: 160, easing: "ease-in", fill: "forwards" }).finished.then(() => {
        el.textContent = text;
        el.animate([{ transform: "translateY(60%)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 }], { duration: 260, easing: "cubic-bezier(0.22,1,0.36,1)", fill: "forwards" });
      });
    };
    const setActive = (i: number) => {
      chapters.forEach((c, n) => c.classList.toggle("is-active", n === i));
      if (i === current) return;
      current = i;
      roll(yearEl, chapters[i].dataset.year!);
      roll(placeEl, chapters[i].dataset.place!);
    };

    if (!reduced) {
      root.classList.add("is-enhanced");
      let ticking = false;
      const update = () => {
        ticking = false;
        const vh = window.innerHeight;
        let best = 0, bestD = Infinity;
        chapters.forEach((c, i) => {
          const r = c.getBoundingClientRect();
          const d = Math.abs(r.top + r.height / 2 - vh * 0.5);
          if (d < bestD) { bestD = d; best = i; }
        });
        setActive(best);
        const r = root.getBoundingClientRect();
        fill.style.transform = `scaleY(${Math.min(1, Math.max(0, (vh * 0.5 - r.top) / r.height)).toFixed(3)})`;
      };
      window.addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      window.addEventListener("resize", update);
      update();
    }
  }
</script>
