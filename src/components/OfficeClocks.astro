---
import { feature } from "topojson-client";
import { geoContains } from "d3-geo";
import land110 from "world-atlas/land-110m.json";
import { ABOUT } from "../data/site";

// Dot-matrix world map, generated once at build time.
const W = 1200;
const STEP = 10;
const LAT_TOP = 83;
const LAT_BOT = -57;
const H = Math.round((W * (LAT_TOP - LAT_BOT)) / 360);
const land = feature(land110 as any, (land110 as any).objects.land) as any;
const dots: [number, number][] = [];
for (let x = STEP / 2; x < W; x += STEP) {
  for (let y = STEP / 2; y < H; y += STEP) {
    const lon = (x / W) * 360 - 180;
    const lat = LAT_TOP - (y / H) * (LAT_TOP - LAT_BOT);
    if (geoContains(land, [lon, lat])) dots.push([x, y]);
  }
}
const pt = (lon: number, lat: number) => ({ x: ((lon + 180) / 360) * W, y: ((LAT_TOP - lat) / (LAT_TOP - LAT_BOT)) * H });
const pins = ABOUT.clocks.map((c, i) => ({ ...c, ...pt(c.lon, c.lat) }));
const arc = (a: { x: number; y: number }, b: { x: number; y: number }) => {
  const mx = (a.x + b.x) / 2, my = Math.min(a.y, b.y) - Math.abs(b.x - a.x) * 0.22;
  return `M${a.x.toFixed(1)} ${a.y.toFixed(1)} Q${mx.toFixed(1)} ${my.toFixed(1)} ${b.x.toFixed(1)} ${b.y.toFixed(1)}`;
};
const arcs = [arc(pins[0], pins[1]), arc(pins[1], pins[2])];
---


<section class="clocks" data-clocks aria-label="Our offices around the world">
  <div class="map" data-map>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="World map with offices in the United Kingdom, the United Arab Emirates and India">
      <path class="map-dots" d={dots.map(([x, y]) => `M${x} ${y}h.01`).join("")} />
      <g class="map-arcs">
        {arcs.map((d) => <path d={d} pathLength="1" />)}
      </g>
      {
        pins.map((p, i) => (
          <g class="map-pin" data-pin={i} transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}>
            <circle class="pin-pulse" r="9" />
            <circle class="pin-dot" r="6.5" />
            <text class={`pin-label${i === 1 ? " pin-label--left" : ""}`} x={i === 1 ? -14 : 14} y="5">{p.short}</text>
          </g>
        ))
      }
    </svg>
  </div>
  <ul class="clocks-grid">
    {
      ABOUT.clocks.map((c, i) => (
        <li class="clock" data-tz={c.tz} data-idx={i} tabindex="0">
          <p class="clock-city">
            <span class="clock-dot" aria-hidden="true"></span>
            {c.city}
            <span class="clock-status" data-status></span>
          </p>
          <p class="clock-time" data-time aria-hidden="true">00:00:00</p>
          <p class="clock-meta"><span data-date></span><span class="clock-off" data-off></span></p>
          <p class="sr-only" data-sr></p>
        </li>
      ))
    }
  </ul>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-clocks]");
  if (root) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const parts = (tz: string, d: Date) => {
      const f = new Intl.DateTimeFormat("en-GB", { timeZone: tz, hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false, weekday: "short", day: "numeric", month: "short" });
      const o: Record<string, string> = {};
      f.formatToParts(d).forEach((p) => (o[p.type] = p.value));
      return o;
    };
    // Offset in whole or half hours relative to London
    const minutesOf = (tz: string, d: Date) => { const p = parts(tz, d); return Number(p.hour) * 60 + Number(p.minute); };
    const dayOf = (tz: string, d: Date) => new Date(d.toLocaleString("en-US", { timeZone: tz })).getTime();

    const clocks = [...root.querySelectorAll<HTMLElement>(".clock")].map((el) => {
      const time = el.querySelector<HTMLElement>("[data-time]")!;
      time.textContent = "";
      const chars = [...Array(8)].map((_, i) => {
        const s = document.createElement("span");
        s.className = i === 2 || i === 5 ? "ck-sep" : "ck-d";
        s.textContent = i === 2 || i === 5 ? ":" : "0";
        time.append(s);
        return s;
      });
      return { el, tz: el.dataset.tz!, chars, last: "" };
    });

    const tick = () => {
      const now = new Date();
      for (const c of clocks) {
        const p = parts(c.tz, now);
        const str = `${p.hour}:${p.minute}:${p.second}`;
        if (str !== c.last) {
          [...str].forEach((ch, i) => {
            if (c.chars[i].textContent !== ch) {
              const span = c.chars[i];
              span.textContent = ch;
              if (!reduced && i === 7) span.animate([{ transform: "translateY(45%)", opacity: 0 }, { transform: "none", opacity: 1 }], { duration: 260, easing: "cubic-bezier(0.22,1,0.36,1)" });
            }
          });
          c.last = str;
          const mins = Number(p.hour) * 60 + Number(p.minute);
          const wd = p.weekday;
          const open = !["Sat", "Sun"].includes(wd) && mins >= 9 * 60 && mins < 18 * 60;
          const day = mins >= 6 * 60 && mins < 18 * 60;
          c.el.classList.toggle("is-open", open);
          c.el.classList.toggle("is-night", !day);
          c.el.querySelector<HTMLElement>("[data-status]")!.textContent = open ? "Open now" : "Closed";
          c.el.querySelector<HTMLElement>("[data-date]")!.textContent = `${p.weekday} ${p.day} ${p.month}`;
          const diff = Math.round((dayOf(c.tz, now) - dayOf("Europe/London", now)) / 60000);
          const off = diff === 0 ? "UK time" : `${diff > 0 ? "+" : "-"}${Math.abs(diff) / 60 % 1 ? (Math.abs(diff) / 60).toFixed(1) : Math.abs(diff) / 60} h from London`;
          c.el.querySelector<HTMLElement>("[data-off]")!.textContent = off;
          c.el.querySelector<HTMLElement>("[data-sr]")!.textContent = `${c.el.querySelector(".clock-city")!.firstChild?.nextSibling?.textContent ?? ""} ${p.hour}:${p.minute}, ${open ? "open now" : "closed"}`;
        }
      }
    };
    tick();
    window.setInterval(tick, 1000);

    // Pins and clocks highlight each other
    const pinsEl = [...root.querySelectorAll<SVGGElement>("[data-pin]")];
    const link = (i: number | null) => {
      pinsEl.forEach((p, n) => p.classList.toggle("is-on", n === i));
      clocks.forEach((c, n) => c.el.classList.toggle("is-linked", n === i));
    };
    clocks.forEach((c, n) => {
      c.el.addEventListener("pointerenter", () => link(n));
      c.el.addEventListener("pointerleave", () => link(null));
      c.el.addEventListener("focus", () => link(n));
      c.el.addEventListener("blur", () => link(null));
    });
    pinsEl.forEach((p, n) => {
      p.addEventListener("pointerenter", () => link(n));
      p.addEventListener("pointerleave", () => link(null));
    });

    // Draw the route arcs and drop the pins in when the map scrolls into view
    const map = root.querySelector<HTMLElement>("[data-map]")!;
    if (!reduced && "IntersectionObserver" in window) {
      map.classList.add("is-armed");
      new IntersectionObserver((es, io) => es.forEach((e) => { if (e.isIntersecting) { map.classList.add("is-in"); io.disconnect(); } }), { threshold: 0.35 }).observe(map);
    }
  }
</script>
