---
import { ABOUT } from "../data/site";
---

<section class="clocks" data-clocks aria-labelledby="clocks-title">
  <h2 id="clocks-title" class="clocks-title">Someone is always online</h2>
  <ul class="clocks-grid">
    {
      ABOUT.clocks.map((c) => (
        <li class="clock" data-tz={c.tz} tabindex="0">
          <p class="clock-city">
            <span class="clock-dot" aria-hidden="true"></span>
            {c.city}
            <span class="clock-status" data-status></span>
          </p>
          <p class="clock-time" data-time aria-hidden="true">00:00:00</p>
          <p class="clock-meta"><span data-date></span><span class="clock-off" data-off></span></p>
          <p class="sr-only" data-sr></p>
        </li>
      ))
    }
  </ul>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-clocks]");
  if (root) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const parts = (tz: string, d: Date) => {
      const f = new Intl.DateTimeFormat("en-GB", { timeZone: tz, hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false, weekday: "short", day: "numeric", month: "short" });
      const o: Record<string, string> = {};
      f.formatToParts(d).forEach((p) => (o[p.type] = p.value));
      return o;
    };
    // Offset in whole or half hours relative to London
    const minutesOf = (tz: string, d: Date) => { const p = parts(tz, d); return Number(p.hour) * 60 + Number(p.minute); };
    const dayOf = (tz: string, d: Date) => new Date(d.toLocaleString("en-US", { timeZone: tz })).getTime();

    const clocks = [...root.querySelectorAll<HTMLElement>(".clock")].map((el) => {
      const time = el.querySelector<HTMLElement>("[data-time]")!;
      time.textContent = "";
      const chars = [...Array(8)].map((_, i) => {
        const s = document.createElement("span");
        s.className = i === 2 || i === 5 ? "ck-sep" : "ck-d";
        s.textContent = i === 2 || i === 5 ? ":" : "0";
        time.append(s);
        return s;
      });
      return { el, tz: el.dataset.tz!, chars, last: "" };
    });

    const tick = () => {
      const now = new Date();
      for (const c of clocks) {
        const p = parts(c.tz, now);
        const str = `${p.hour}:${p.minute}:${p.second}`;
        if (str !== c.last) {
          [...str].forEach((ch, i) => {
            if (c.chars[i].textContent !== ch) {
              const span = c.chars[i];
              span.textContent = ch;
              if (!reduced && i === 7) span.animate([{ transform: "translateY(45%)", opacity: 0 }, { transform: "none", opacity: 1 }], { duration: 260, easing: "cubic-bezier(0.22,1,0.36,1)" });
            }
          });
          c.last = str;
          const mins = Number(p.hour) * 60 + Number(p.minute);
          const wd = p.weekday;
          const open = !["Sat", "Sun"].includes(wd) && mins >= 9 * 60 && mins < 18 * 60;
          const day = mins >= 6 * 60 && mins < 18 * 60;
          c.el.classList.toggle("is-open", open);
          c.el.classList.toggle("is-night", !day);
          c.el.querySelector<HTMLElement>("[data-status]")!.textContent = open ? "Open now" : "Closed";
          c.el.querySelector<HTMLElement>("[data-date]")!.textContent = `${p.weekday} ${p.day} ${p.month}`;
          const diff = Math.round((dayOf(c.tz, now) - dayOf("Europe/London", now)) / 60000);
          const off = diff === 0 ? "UK time" : `${diff > 0 ? "+" : "-"}${Math.abs(diff) / 60 % 1 ? (Math.abs(diff) / 60).toFixed(1) : Math.abs(diff) / 60} h from London`;
          c.el.querySelector<HTMLElement>("[data-off]")!.textContent = off;
          c.el.querySelector<HTMLElement>("[data-sr]")!.textContent = `${c.el.querySelector(".clock-city")!.firstChild?.nextSibling?.textContent ?? ""} ${p.hour}:${p.minute}, ${open ? "open now" : "closed"}`;
        }
      }
    };
    tick();
    window.setInterval(tick, 1000);
  }
</script>
