---
import DesignBook from "./DesignBook.astro";
import { BRAND_BOOK, BOOK, DESIGN_FAQ } from "../data/design";
import { url } from "../data/site";

interface Props {
  part: "intro" | "faq";
}

const { part } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
---

{
  part === "intro" && (
    <section class="dz-intro" id="brand-book" aria-labelledby="bb-title" data-dz-pin>
      <div class="dz-intro-in">
        <div class="dz-intro-copy">
          <h2 id="bb-title" class="display dz-h2">
            What's a <span class="dz-accent">brand book?</span>
          </h2>
          <p class="dz-big">{BRAND_BOOK.lead}</p>
          <p class="dz-text">{BRAND_BOOK.body}</p>
          <p class="dz-text dz-text--dim">{BRAND_BOOK.why}</p>
        </div>

        <div class="dz-spreads">
          <DesignBook />
          <nav class="dz-chapters" aria-label="Brand book chapters">
            {BOOK.contents.map((c) => <button type="button" data-spread={c.spread}>{c.t}</button>)}
          </nav>
          <p class="dz-book-note">{BRAND_BOOK.note}</p>
          <div class="dz-cue-wrap">
            <button class="dz-scroll dz-cue" type="button" data-cursor="Go">
              Please scroll down
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
            </button>
          </div>
        </div>
      </div>
    </section>
  )
}

{
  part === "faq" && (
    <section class="dz-faq" id="faq" aria-labelledby="dz-faq-title">
      <div class="dz-wrap dz-faq-grid">
        <div class="dz-faq-side">
          <h2 id="dz-faq-title" class="display dz-h2">
            Questions <span class="dz-accent">answered</span>
          </h2>
          <a class="dz-faq-more" href={url("/services")} data-cursor="Go">Explore our services <span aria-hidden="true">↗</span></a>
        </div>
        <div class="dz-faq-list">
          {DESIGN_FAQ.map((f) => (
            <details>
              <summary><span>{f.q}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  // Pinned scene: the section holds the screen while the book rises and grows until it fills the viewport.
  // It is scrubbed by normal scrolling (never hijacked) and runs whenever motion is allowed.
  // On a portrait phone the book shows one page at a time ("single") so it can fill the screen.
  const sec = document.querySelector<HTMLElement>("[data-dz-pin]");
  if (sec) {
    const stage = sec.querySelector<HTMLElement>(".dz-intro-in")!;
    const portraitPhone = window.matchMedia("(max-width: 599px) and (orientation: portrait)");
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
    const clamp = (n: number, a = 0, b = 1) => Math.min(b, Math.max(a, n));
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    let on = false;
    const update = () => {
      if (!on) return;
      const dist = Math.max(1, sec.offsetHeight - window.innerHeight);
      const p = clamp(-sec.getBoundingClientRect().top / dist);
      stage.style.setProperty("--g", ease(clamp((p - 0.04) / 0.46)).toFixed(4)); // book growth
      stage.style.setProperty("--c", clamp(p / 0.2).toFixed(4)); // copy fade
      document.body.classList.toggle("dz-holding", sec.classList.contains("is-single") && p > 0.04 && p < 0.98); // the back-to-top button would sit on the book controls
      window.dispatchEvent(new CustomEvent("dz:scrub", { detail: { p } })); // the cover opens with the scroll
    };
    const setup = () => {
      const want = !calm.matches;
      const turn = want && portraitPhone.matches;
      const changed = want !== on || turn !== sec.classList.contains("is-single");
      if (want !== on) {
        on = want;
        sec.classList.toggle("is-pinned", on);
        if (!on) {
          document.body.classList.remove("dz-holding");
          stage.style.removeProperty("--g");
          stage.style.removeProperty("--c");
          window.dispatchEvent(new CustomEvent("dz:scrub", { detail: { p: null } }));
        }
      }
      sec.classList.toggle("is-single", turn);
      update();
      if (changed) window.dispatchEvent(new CustomEvent("dz:mode"));
    };
    let ticking = false;
    window.addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; update(); }); } }, { passive: true });
    window.addEventListener("resize", setup);
    portraitPhone.addEventListener("change", setup);
    sec.querySelector(".dz-cue")?.addEventListener("click", () => {
      window.scrollTo({ top: sec.offsetTop + sec.offsetHeight, behavior: calm.matches ? "auto" : "smooth" });
    });
    setup();
  }
</script>

