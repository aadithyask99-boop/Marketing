---
import { SITE, OFFICES, url } from "../data/site";
const uk = OFFICES[0];
---

<footer class="mini-footer">
  <div class="mini-in">
    <p class="mini-name">{SITE.name}</p>
    <p class="mini-meta">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <span aria-hidden="true">·</span>
      <a href={`tel:${uk.tel}`}>{uk.phone}</a>
    </p>
    <p class="mini-meta">{uk.street}, {uk.locality}, {uk.region} {uk.postcode}</p>
    <ul class="mini-legal">
      <li><a href={url("/privacy")}>Privacy Policy</a></li>
      <li><a href={url("/terms")}>Terms &amp; conditions</a></li>
    </ul>
    <p class="mini-copy">&copy; {new Date().getFullYear()} {SITE.name}. Registered in England and Wales, company no. {SITE.companyNumber}.</p>
  </div>
</footer>

<style>
  .mini-footer { background: var(--ink); color: var(--cream); padding: clamp(2rem, 5vw, 3.5rem) var(--gutter) calc(clamp(2rem, 5vw, 3.5rem) + 4.5rem); }
  .mini-in { display: grid; gap: 0.4rem; max-width: 90rem; margin: 0 auto; font-size: 0.95rem; }
  .mini-name { margin: 0; font-family: var(--display); font-size: 1.75rem; letter-spacing: 0.02em; text-transform: uppercase; }
  .mini-meta { margin: 0; opacity: 0.85; overflow-wrap: anywhere; }
  .mini-meta a:hover, .mini-legal a:hover { color: var(--red); }
  .mini-meta span { margin: 0 0.4rem; }
  .mini-legal { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; margin: 0.75rem 0 0; padding: 0; list-style: none; }
  .mini-legal a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .mini-copy { margin: 0; font-size: 0.8rem; opacity: 0.6; }
  @media (min-width: 900px) { .mini-footer { padding-bottom: clamp(2rem, 5vw, 3.5rem); } }
</style>
