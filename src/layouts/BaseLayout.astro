---
import "@fontsource/bebas-neue/400.css";
import "@fontsource/mulish/400.css";
import "@fontsource/mulish/600.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import MenuOverlay from "../components/MenuOverlay.astro";
import Cursor from "../components/Cursor.astro";
import Preloader from "../components/Preloader.astro";
import Consent from "../components/Consent.astro";
import ScrollTop from "../components/ScrollTop.astro";
import Footer from "../components/Footer.astro";
import { SITE, url } from "../data/site";
import { siteGraph } from "../lib/schema";

interface Props {
  title?: string;
  description?: string;
  footerTone?: "ink" | "red";
  schema?: object[];
  noindex?: boolean;
  image?: string;
  landing?: boolean;
  // Blog posts: sets og:type to article and adds published and modified times
  article?: { published: Date; modified?: Date };
}

const { title, description = SITE.description, footerTone = "ink", schema = [], noindex = false, image, landing = false, article } = Astro.props;
// Keep the tab title within about 60 characters: the brand suffix is dropped when it would not fit.
const pageTitle = title ? (title.length + SITE.name.length + 3 <= 60 ? `${title} | ${SITE.name}` : title) : `${SITE.name} | SEO, AI Search and Websites Agency`;
const origin = (Astro.site ?? new URL(SITE.domain)).origin;
const canonical = `${origin}${Astro.url.pathname}`;
const ogImage = image ? new URL(image, origin).href : `${origin}/og.png`;
const ld = [siteGraph(origin), ...schema];
---

<!doctype html>
<html lang="en-GB" data-footer={footerTone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e10600" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article && <meta property="article:modified_time" content={(article.modified ?? article.published).toISOString()} />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonical} />
    <meta name="google-site-verification" content="7NpVOIIlDaZe5x1Lt0xuVqDvXw3CCgctdGneJlrFjuk" />
    {noindex && <meta name="robots" content="noindex" />}
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o).replace(/</g, "\\u003c")} />)}
    <script is:inline>
      // Preloader: first visit of the session only, never for reduced motion or crawlers. Add ?pre=1 to any address to replay it.
      // "Seen" is remembered as soon as the loader is switched on (not when it finishes), so clicking a link early never
      // replays it. It lives in sessionStorage (each tab plays it once); a session cookie is used only when storage is
      // blocked (some private modes). Refreshing the home page plays it again. A last-resort timer removes the overlay
      // if the loader script never takes over (for example a failed download), so a visitor can never be stuck on it.
      (function () {
        var d = document.documentElement;
        var storage = (function () { try { sessionStorage.setItem("mm-t", "1"); sessionStorage.removeItem("mm-t"); return true; } catch (e) { return false; } })();
        var seen = function () { return storage ? !!sessionStorage.getItem("mm-pre") : document.cookie.indexOf("mm-pre=1") > -1; };
        var mark = function () { if (storage) sessionStorage.setItem("mm-pre", "1"); else document.cookie = "mm-pre=1; path=/; SameSite=Lax"; };
        var reloaded = function () { var n = performance.getEntriesByType && performance.getEntriesByType("navigation")[0]; return !!n && n.type === "reload"; };
        var on = function () {
          d.classList.add("pre-on");
          mark();
          setTimeout(function () { d.classList.remove("pre-on"); var o = document.querySelector("[data-pre]"); if (o) o.remove(); }, 12000);
        };
        try {
          if (location.search.indexOf("pre=1") > -1) { on(); return; }
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          if (navigator.webdriver || /bot|crawl|spider|lighthouse|headless/i.test(navigator.userAgent)) return;
          if (seen() && !(location.pathname === "/" && reloaded())) return;
          on();
        } catch (e) {}
      })();
    </script>
    {import.meta.env.PROD && <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>}
    {import.meta.env.PROD && <script is:inline defer src="/_vercel/insights/script.js"></script>}
    <slot name="head" />
    <link rel="icon" type="image/png" href={url("/favicon.png")} />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
  </head>
  <body>
    <Preloader />
    <a class="skip-link" href="#main">Skip to content</a>
    <Header minimal={landing} />
    {!landing && <MenuOverlay />}
    <main id="main">
      <slot />
    </main>
    <Footer tone={footerTone} />
    <ScrollTop />
    <Cursor />
    <Consent noindex={noindex} />
  <script>
    import { initHeadlines } from "../scripts/xray";
    initHeadlines();
  </script>
  </body>
</html>
